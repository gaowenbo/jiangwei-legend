flags","args":[[],[12]]},{"op":0,"name":"end","args":[]}],"body":[{"op":9,"name":"delay","args":[5]},{"op":21,"name":"unit_say","args":[645,645,"你们在搞什么？为什么被打得如此狼狈？"]},{"op":21,"name":"unit_say","args":[106,106,"贼寇防御严密，实在是无懈可击，绵竹关\n太难打了。"]},{"op":21,"name":"unit_say","args":[105,105,"爹，司马说的是事实…"]},{"op":21,"name":"unit_say","args":[645,645,"生死存亡！在此一举，什么叫无懈可击？"]},{"op":21,"name":"unit_say","args":[645,645,"你们说这种丧气话，扰乱军心，应该要\n军法处置！"]},{"op":21,"name":"unit_say","args":[105,105,"请让我们再战吧！"]},{"op":21,"name":"unit_say","args":[106,106,"这次一定会打下绵竹！"]},{"op":21,"name":"unit_say","args":[645,645,"好吧，这次可不许让我失望了。"]},{"op":9,"name":"delay","args":[5]},{"op":85,"name":"unit_move","args":[0,105,0,9,3,2]},{"op":85,"name":"unit_move","args":[0,106,0,10,3,2]},{"op":85,"name":"unit_move","args":[0,258,0,6,1,2]},{"op":85,"name":"unit_move","args":[0,259,0,7,1,2]},{"op":85,"name":"unit_move","args":[0,260,0,8,1,2]},{"op":85,"name":"unit_move","args":[0,261,0,9,1,2]},{"op":85,"name":"unit_move","args":[0,262,0,10,1,2]},{"op":85,"name":"unit_move","args":[0,263,0,11,1,2]},{"op":85,"name":"unit_move","args":[0,264,0,12,1,2]},{"op":85,"name":"unit_move","args":[0,265,0,13,1,2]},{"op":85,"name":"unit_move","args":[0,266,0,6,2,2]},{"op":85,"name":"unit_move","args":[0,267,0,7,2,2]},{"op":85,"name":"unit_move","args":[0,268,0,8,2,2]},{"op":85,"name":"unit_move","args":[0,269,0,9,2,2]},{"op":85,"name":"unit_move","args":[0,270,0,10,2,2]},{"op":85,"name":"unit_move","args":[0,271,0,11,2,2]},{"op":85,"name":"unit_move","args":[0,272,0,12,2,2]},{"op":85,"name":"unit_move","args":[0,273,0,13,2,2]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&张遵\n哈哈哈，没想到那些蠢蛋还敢来！\n&关彝\n嫌被我们修理得还不够？\n&李球\n这样水准的军队，就算来十批也不是我们\n对手。\n&诸葛瞻\n好！全军出击，这次要让他们连一兵一卒\n都无法逃回去！"]},{"op":9,"name":"delay","args":[5]},{"op":79,"name":"unit_op_4f","args":[42,40,65535,0,0,1]},{"op":20,"name":"dialog","args":["&黄崇\n等一下！我们不能舍弃绵竹关的城池，跑\n去和敌人野战，那正中敌人的下怀。\n&诸葛瞻\n敌人的实力我们也清楚了，就算是正面冲\n突也不会是我们的对手。\n&诸葛瞻\n固守城池固然不会大败，但是却无法彻底\n歼灭敌人。要是继续让邓艾大军在我国境\n内活动，只会造成人心惶惶的局面。\n&黄崇\n这…\n&诸葛瞻\n难道镇北将军的儿子会这么胆小？\n&黄崇\n（丞相呀，您可不可以显灵来告诉您的儿\n子，他的作战几乎和自杀没有两样。）\n&黄崇\n好吧，我就舍命陪卫将军了。\n&黄崇\n（鞠躬尽瘁，死而后已…我已经尽人事了\n，剩下就听天命吧。）"]},{"op":9,"name":"delay","args":[5]},{"op":50,"name":"actor_move","args":[0,40,0,10,5,0]},{"op":50,"name":"actor_move","args":[0,42,0,9,5,0]},{"op":50,"name":"actor_move","args":[0,43,0,11,5,0]},{"op":50,"name":"actor_move","args":[0,44,0,8,5,0]},{"op":50,"name":"actor_move","args":[0,140,0,12,5,0]},{"op":9,"name":"delay","args":[5]},{"op":76,"name":"unit_op_4c","args":[0,645,0]},{"op":76,"name":"unit_op_4c","args":[0,718,0]},{"op":76,"name":"unit_op_4c","args":[0,149,0]},{"op":76,"name":"unit_op_4c","args":[0,150,0]},{"op":76,"name":"unit_op_4c","args":[0,151,0]},{"op":76,"name":"unit_op_4c","args":[0,54,0]},{"op":76,"name":"unit_op_4c","args":[0,282,0]},{"op":76,"name":"unit_op_4c","args":[0,283,0]},{"op":76,"name":"unit_op_4c","args":[0,284,0]},{"op":76,"name":"unit_op_4c","args":[0,285,0]},{"op":76,"name":"unit_op_4c","args":[0,286,0]},{"op":76,"name":"unit_op_4c","args":[0,287,0]},{"op":76,"name":"unit_op_4c","args":[0,288,0]},{"op":76,"name":"unit_op_4c","args":[0,289,0]},{"op":76,"name":"unit_op_4c","args":[0,530,0]},{"op":76,"name":"unit_op_4c","args":[0,531,0]},{"op":76,"name":"unit_op_4c","args":[0,532,0]},{"op":76,"name":"unit_op_4c","args":[0,533,0]},{"op":76,"name":"unit_op_4c","args":[0,534,0]},{"op":76,"name":"unit_op_4c","args":[0,535,0]},{"op":76,"name":"unit_op_4c","args":[0,536,0]},{"op":76,"name":"unit_op_4c","args":[0,537,0]},{"op":76,"name":"unit_op_4c","args":[0,138,0]},{"op":76,"name":"unit_op_4c","args":[0,346,0]},{"op":76,"name":"unit_op_4c","args":[0,347,0]},{"op":76,"name":"unit_op_4c","args":[0,348,0]},{"op":76,"name":"unit_op_4c","args":[0,349,0]},{"op":76,"name":"unit_op_4c","args":[0,350,0]},{"op":76,"name":"unit_op_4c","args":[0,351,0]},{"op":76,"name":"unit_op_4c","args":[0,352,0]},{"op":76,"name":"unit_op_4c","args":[0,353,0]},{"op":79,"name":"unit_op_4f","args":[105,65535,0,0,0,0]},{"op":79,"name":"unit_op_4f","args":[106,65535,0,0,0,0]},{"op":20,"name":"dialog","args":["&邓忠\n爹，这到底是怎么回事？\n&师纂\n不是说要再给我们机会？\n&邓艾1\n不用担心，你们两个确实立下大功了。\n&邓艾1\n一开始让你们败给蜀军，就是要瘫痪他\n们的忧患意识，使他们对我们军队掉以\n轻心。\n&邓艾1\n接着当他看见你们这些残兵败将又再来挑\n战之时，自然会冲出来送死。\n&邓忠\n爹真是神机妙算。\n（唉…爹为什么每次都这样…）\n&师纂\n（除了干还是干，连自己儿子都拿去当诱\n饵，这样还像是人吗？）"]},{"op":79,"name":"unit_op_4f","args":[105,65535,2,0,0,0]},{"op":79,"name":"unit_op_4f","args":[106,65535,2,0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&诸葛瞻\n邓艾！你敢算计我！\n&邓艾1\n诸葛瞻，当这几天重新复习诸葛丞相过去\n的用兵纪录时，我就有无限的感慨。\n&邓艾1\n父亲如此杰出，为什么儿子却这么愚蠢。\n&邓艾1\n我想了又想，或许这就是世族政治的弊病\n，养尊处优的环境，让可能绽放的才能也\n就此沉睡了。\n&邓艾1\n你的牺牲不会白费的，当我灭蜀的一刻，\n我的战功就足够让我往上爬，让我有力量\n建立一个只看能力，不看家世的世界。"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&王颀\n（该死，我的眼睛怎么了，是沙子跑到眼\n睛里？）\n&杨欣\n（我才不管你说什么屁话，只要能让我升\n官就好。）\n&牵弘\n（光靠我爹的庇荫，根本不足以让我往上\n爬，因此征西将军的话我倒是很赞同。）\n&丘本\n（我聪明绝顶，智商超过两百，那些白痴\n世家子弟哪是我的对手。）\n&田续\n（干！让我和士兵们混在一起是怎么样，\n嘴巴说尊重我的叔祖，实际上根本就不是\n这样嘛…）"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&诸葛瞻\n哈哈哈哈哈…事已至此，也就只能求一个\n轰轰烈烈的死。\n&诸葛瞻\n所有士兵埋脚步而战！绝对不要后退\n一步！\n&诸葛瞻\n就算是死，也要让邓艾看看我大汉将士的\n骨气！"]},{"op":77,"name":"unit_op_4d","args":[0,40,0,0,0,0,0,6,65535,65535,2,0,0]},{"op":77,"name":"unit_op_4d","args":[0,42,0,0,0,0,0,6,65535,65535,2,0,0]},{"op":77,"name":"unit_op_4d","args":[0,43,0,0,0,0,0,6,65535,65535,2,0,0]},{"op":77,"name":"unit_op_4d","args":[0,44,0,0,0,0,0,6,65535,65535,2,0,0]},{"op":77,"name":"unit_op_4d","args":[0,140,0,0,0,0,0,6,65535,65535,2,0,0]},{"op":11,"name":"set_flag","args":[12,1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":12523,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":5,"name":"test_flags","args":[[50,76,78,79,139],[13]]},{"op":0,"name":"end","args":[]}],"body":[{"op":9,"name":"delay","args":[5]},{"op":85,"name":"unit_move","args":[0,707,0,9,16,0]},{"op":85,"name":"unit_move","args":[0,41,0,10,16,0]},{"op":79,"name":"unit_op_4f","args":[41,707,65535,0,0,1]},{"op":79,"name":"unit_op_4f","args":[707,41,65535,0,0,1]},{"op":20,"name":"dialog","args":["&诸葛尚\n阿照，你先走吧…\n&糜照\n你说什么话？！是兄弟就该一起逃走！\n&诸葛尚\n不，父子同受国家大恩。却不能及早诛\n杀黄皓，使他败坏国家，活着还有什么\n意思？\n&糜照\n阿尚，不要做傻事！\n&诸葛尚\n让我去吧，你还有回去成都报告战果的\n任务，总不能让圣上不知道邓艾大军将\n近吧…\n&糜照\n为什么诸葛家父子都要这么笨？"]},{"op":49,"name":"actor_select","args":[0,707,0,0,0,0,6]},{"op":9,"name":"delay","args":[5]},{"op":50,"name":"actor_move","args":[0,41,0,9,5,0]},{"op":9,"name":"delay","args":[5]},{"op":80,"name":"unit_status","args":[41,7,0,1]},{"op":20,"name":"dialog","args":["&诸葛尚\n我是大汉卫将军诸葛思远之子，大汉丞相\n诸葛孔明之孙，哪个人有胆量和我一对一\n对决？\n&邓艾1\n来人！待我令下将他乱箭射死！"]},{"op":20,"name":"dialog","args":["&邓艾1\n忠儿你…\n&邓忠\n爹，请交给我！我认为您的作法征服得了\n蜀人的人，却征服不了他们的心。\n&邓艾1\n愚蠢至极！\n&邓忠\n拜托，就让我任性这一次吧。"]},{"op":49,"name":"actor_select","args":[1,65535,0,0,19,23,2]},{"op":85,"name":"unit_move","args":[0,105,0,8,0,2]},{"op":109,"name":"op_6d","args":[0,105,0,41,0,0,65535,0]},{"op":20,"name":"dialog","args":["&邓忠\n你叫诸葛尚是吗？我知道在这种情况下对\n决，对你是完全不利的。但是我能做的，\n也只有和你单挑而已。\n&诸葛尚\n不，这样就很够了，或许死在你手里也远\n胜过死在邓艾手上。"]},{"op":9,"name":"delay","args":[5]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["虫珼矪竚"]},"end":89},{"op":104,"name":"duel_setup","args":[41,105,27]},{"op":96,"name":"duel_say","args":[0,"原谅我只能用这样的方式向你致敬！",9]},{"op":96,"name":"duel_say","args":[1,"能遇见像你这样的敌将，\n我已经很满足了。",9]},{"op":9,"name":"delay","args":[5]},{"op":97,"name":"duel_end","args":[]},{"op":99,"name":"duel_say2","args":[1,"看招！神龙断！",1]},{"op":100,"name":"duel_action","args":[1,2]},{"op":101,"name":"duel_action2","args":[1,1,1]},{"op":99,"name":"duel_say2","args":[0,"好强！没想到诸葛家也能出这\n样的战将。",1]},{"op":9,"name":"delay","args":[5]},{"op":100,"name":"duel_action","args":[0,8]},{"op":99,"name":"duel_say2","args":[0,"看我的！风之伤！",1]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,0,0]},{"op":101,"name":"duel_action2","args":[0,0,0]},{"op":10