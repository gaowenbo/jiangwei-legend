me":"duel_say2","args":[1,"啊！！！",1]},{"op":100,"name":"duel_action","args":[1,12]},{"op":99,"name":"duel_say2","args":[1,"终究还是败了…但是却没有\n任何遗憾，谢谢你…",1]},{"op":35,"name":"play_music","args":[38,1]},{"op":98,"name":"duel_62","args":[0]},{"op":100,"name":"duel_action","args":[0,6]},{"op":99,"name":"duel_say2","args":[0,"这是我生平第一次打得这么惊险…\n如果不是因为这样的灭国之战，你\n应该可以成为我的好对手吧…",1]},{"op":9,"name":"delay","args":[6]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":83,"name":"unit_op_53","args":[0,41,0,0,0,0,6,1]},{"op":9,"name":"delay","args":[5]},{"op":85,"name":"unit_move","args":[0,645,0,9,0,2]},{"op":20,"name":"dialog","args":["&邓忠\n爹…\n&邓艾1\n厚葬他们，并且把他们父子合葬在一起。\n&邓艾1\n我可不是因为认同他们才这样做的，只不\n过是因为蜀人很敬重诸葛家的人而已。\n&邓忠\n（爹还真是不老实…）\n&邓艾1\n绵竹关既破，接下来就进军成都，完成灭\n蜀大业！"]},{"op":11,"name":"set_flag","args":[13,1]},{"op":81,"name":"op_51","args":[]},{"op":89,"name":"op_59","args":[1200,65535,65535,65535,65535,65535,65535,65535]},{"op":73,"name":"ui_49","args":[]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":15243,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[44,106,1]},{"op":5,"name":"test_flags","args":[[],[40]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[44,106,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[106,44,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&师纂\n小子，算你倒楣，碰到你师大爷要脑袋\n报功。\n&张遵\n凭你？看谁先砍下谁的脑袋！"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":[""]},"end":41},{"op":104,"name":"duel_setup","args":[44,106,27]},{"op":96,"name":"duel_say","args":[0,"快交出你的脑袋来！",9]},{"op":96,"name":"duel_say","args":[1,"就凭你？",6]},{"op":97,"name":"duel_end","args":[]},{"op":100,"name":"duel_action","args":[0,2]},{"op":99,"name":"duel_say2","args":[0,"看招！",1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":101,"name":"duel_action2","args":[0,1,1]},{"op":100,"name":"duel_action","args":[1,8]},{"op":99,"name":"duel_say2","args":[1,"该俺反击了！",1]},{"op":101,"name":"duel_action2","args":[1,1,1]},{"op":99,"name":"duel_say2","args":[0,"这是什么怪力？！",1]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[1,2,1]},{"op":100,"name":"duel_action","args":[0,2]},{"op":101,"name":"duel_action2","args":[0,1,1]},{"op":101,"name":"duel_action2","args":[1,0,0]},{"op":101,"name":"duel_action2","args":[1,2,1]},{"op":100,"name":"duel_action","args":[0,2]},{"op":100,"name":"duel_action","args":[0,8]},{"op":99,"name":"duel_say2","args":[1,"看招！虎车旋转碎弹袭！",1]},{"op":101,"name":"duel_action2","args":[1,0,0]},{"op":101,"name":"duel_action2","args":[1,0,0]},{"op":101,"name":"duel_action2","args":[1,2,1]},{"op":99,"name":"duel_say2","args":[0,"真够强的，这是什么样的招式？",1]},{"op":99,"name":"duel_say2","args":[1,"这是从俺爷爷就传到现在的招式。",1]},{"op":100,"name":"duel_action","args":[0,4]},{"op":100,"name":"duel_action","args":[0,12]},{"op":99,"name":"duel_say2","args":[0,"今天是我身体状况有点不好，\n不然怎么会输给你这小子！",1]},{"op":9,"name":"delay","args":[5]},{"op":100,"name":"duel_action","args":[0,4]},{"op":100,"name":"duel_action","args":[0,13]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&师纂\n对了，忘了问你爷爷是谁…\n&张遵\n大汉桓侯张益德！\n&师纂\n（原来是张飞之孙，那这样输了也没多\n可耻。）"]},{"op":49,"name":"actor_select","args":[0,106,0,0,0,0,6]},{"op":61,"name":"get_item","args":[100,0,1,44]},{"op":11,"name":"set_flag","args":[40,1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":16234,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[140,105,1]},{"op":5,"name":"test_flags","args":[[],[41]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[140,105,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[105,140,65535,65535,0,1]},{"op":80,"name":"unit_status","args":[140,6,1,0]},{"op":80,"name":"unit_status","args":[105,2,0,0]},{"op":35,"name":"play_music","args":[31,1]},{"op":9,"name":"delay","args":[5]},{"op":80,"name":"unit_status","args":[105,6,1,0]},{"op":80,"name":"unit_status","args":[140,2,0,0]},{"op":35,"name":"play_music","args":[31,1]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&邓忠\n这刀法感觉好熟悉，等一下…请问你和\n关统是什么关系？\n&关彝\n他是我大哥。\n&邓忠\n原来如此…段谷的事情我真的感到很遗憾\n，你大哥是个很强悍的武将。\n&关彝\n你知道我大哥是怎么死的？他的最后表现\n如何？\n&邓忠\n非常英勇，绝对没有让关家颜面扫地。\n&关彝\n那就好，多谢你告知这些事情。\n&邓忠\n虽是敌人，但是关家子弟的武人风范值得\n敬佩。"]},{"op":11,"name":"set_flag","args":[41,1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":16784,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[106,7,0,2]},{"op":5,"name":"test_flags","args":[[],[70]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&师纂\n邓艾这家伙，老是拿我去当炮灰！"]},{"op":49,"name":"actor_select","args":[0,106,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[70,1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":16920,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[149,7,0,2]},{"op":5,"name":"test_flags","args":[[],[154]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&王颀\n唉…寄人篱下，除了悲苦，还是悲苦。"]},{"op":49,"name":"actor_select","args":[0,149,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[154,1]},{"op":0,"name":"end","args":[]}]},{"index":10,"offset":17060,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[54,7,0,2]},{"op":5,"name":"test_flags","args":[[],[137]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&马邈\n不要杀我！我上有八十高堂，下个八个子\n女…"]},{"op":49,"name":"actor_select","args":[0,54,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[137,1]},{"op":0,"name":"end","args":[]}]},{"index":11,"offset":17207,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[140,7,0,2]},{"op":5,"name":"test_flags","args":[[],[139]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&关彝\n情况变成这样，除了逃走也没有其他方法\n了。"]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[76]]},"end":4},{"op":20,"name":"dialog","args":["&关彝\n张遵，趁现在敌人还没完全包围我方，我\n们一起逃走吧。\n&张遵\n不了，你自己逃走吧，如果没有留人殿后\n的话，我们两个都会死。\n&关彝\n不行，要走一起走！\n&张遵\n你这白痴！我要你活着告诉皇后，说她的\n侄子没有让张家丢人！\n&关彝\n张遵…保重！"]},{"op":0,"name":"end","args":[]},{"op":49,"name":"actor_select","args":[0,140,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[139,1]},{"op":0,"name":"end","args":[]}]},{"index":12,"offset":17608,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[151,7,0,2]},{"op":5,"name":"test_flags","args":[[],[239]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&杨欣\n痛死我了，总有一天我要往上爬，不要\n再当这种马前卒的角色。"]},{"op":49,"name":"actor_select","args":[0,151,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[239,1]},{"op":0,"name":"end","args":[]}]},{"index":13,"offset":17771,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":54,"name":"test_attr","args":[150,7,0,2]},{"op":5,"name":"test_flags","args":[[],[54]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&牵弘\n扁我就是不给我爹面子！小心我崩溃喔！"]},{"op":49,"name":"actor_select","args":[0,150,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[54,1]},{"op":0,"name":"end","args":[]}]},{"index":14,"offset":17921,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[43,7,0,2]},{"op":5,"name":"test_flags","args":[[],[78]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&李球\n想我叔父军功卓著，领汉兴亭侯、安汉将\n军、庲降都督，持节领交州刺史。\n&李球\n而我却连阻止卫将军暴走都做不到…除了\n可悲，还是可悲…"]},{"op":83,"name":"unit_op_53","args":[0,43,0,0,0,0,6,1]},{"op":11,"name":"set_flag","args":[78,1]},{"op":0,"name":"end","args":[]}]},{"index":15,"offset":18158,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[42,7,0,2]},{"op":5,"name":"test_flags","args":[[],[79]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&黄崇\n想我第一次出征就落得这样的下场，照理\n说我应该怨恨诸葛瞻的…\n&黄崇\n然而不知道为什么，我反而觉得他很可悲\n，或许他背负了不该背负的期待，被迫站\n在不该站的位子吧…"]},{"op":83,"name":"unit_op_53","args":[0,42,0,0,0,0,6,1]},{"op":11,"name":"set_flag","args":[79,1]},{"op":0,"name":"end","args":[]}]},{"index":16,"offset":18426,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[40,7,0,2]},{"op":5,"name":"test_flags","args":[[],[50]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&诸葛瞻\n我已经尽力了，当以一死报国！\n&诸葛瞻\n娘、姊姊，请你们保重，瞻儿先去见爹\n了…"]},{"op":83,"name":"unit_op_53","args":[0,40,0,0,0,0,6,1]},{"op":20,"name":"dialog","args":["&邓艾1\n哼！虽然忠义过人，但是因为你的愚蠢而\n让蜀国最后的战力全军覆没，我对你可没\n有一点敬佩之意。\n&邓忠\n（不，就算如此，你的斗志和忠诚心还是\n很让人敬佩。这次伐蜀，真的让我见识到\n许多在大魏见不到的义士。）"]},{"op":11,"name":"set_flag","args":[50,1]},{"op":0,"name":"end","args":[]}]},{"index":17,"offset":18823,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[138,7,0,2]},{"op":5,"name":"test_flags","args":[[],[102]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&田续\n邓艾！我一定会报仇的！"]},{"op":49,"name":"actor_select","args":[0,138,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[102,1]},{"op":0,"name":"end","args":[]}]},{"index":18,"offset":18951,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[105,7,0,2]},{"op":5,"name":"test_flags","args":[[],[101]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&邓忠\n总有一天要让爹明白，光靠武艺也是可以\n闯出一片天的。"]},{"op":49,"name":"actor_select","args":[0,105,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[101,1]},{"op":0,"name":"end","args":[]}]},{"index":19,"offset":19108,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[645,7,0,2]},{"op":5,"name":"test_flags","args":[[],[100]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&邓艾1\n能够将我击退？诸葛亮的后代什么时候这\n么厉害了。"]},{"op":49,"name":"actor_select","args":[0,645,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[100,1]},{"op":0,"name":"end","args":[]}]},{"index":20,"offset":19262,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":54,"name":"test_attr","args":[350,7,0,2]},{"op":5,"name":"test_flags","args":[[12],[]]},{"op":0,"name":"end","args":[]}],"body":[{"op":85,"name":"unit_move","args":[0,350,0,19,17,0]},{"op":0,"name":"end","args":[]}]},{"index":21,"offset":19347,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[41,7,0,2]},{"op":5,"name":"test_flags","args":[[],[152]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&诸葛尚\n可恶！暂时撤退！"]},{"op":49,"name":"actor_select","args":[0,41,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[152,1]},{"op":0,"name":"end","args":[]}]},{"index":22,"offset":19471,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[707,7,0,2]},{"op":5,"name":"test_flags","args":[[],[75]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&麋照\n打了这样糟糕的仗，我一腔的怨愤又该何\n处发泄？"]},{"op":49,"name":"actor_select","args":[0,707,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[75,1]},{"op":0,"name":"end","args":[]}]},{"index":23,"offset":19622,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[44,7,0,2]},{"op":5,"name":"test_flags","args":[[],[76]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&张遵\n张家一门忠烈，今日能战死绵竹也算死得\n其所呀…"]},{"op":83,"name":"unit_op_53","args":[0,44,0,0,0,0,6,1]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[139]]},"end":5},{"op":20,"name":"dialog","args":["&关彝\n张遵！为什么会这样？该死…\n&关彝\n我一定会回去告诉皇后，说她的侄子没有\n让张家丢人。"]},{"op":0,"name":"end","args":[]},{"op":11,"name":"set_flag","args":[76,1]},{"op":0,"name":"end","args":[]}]},{"index":24,"offset":19888,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[718,7,0,2]},{"op":5,"name":"test_flags","args":[[],[230]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&丘本\n我“冲车大将军”一定会再起的！"]},{"op":49,"name":"actor_select","args":[0,718,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[230,1]},{"op":0,"name":"end","args":[]}]}]},{"index":2,"offset":20024,"sections":[{"index":0,"offset":20026,"title":"驹�岢B竚","conditions":[{"op":2,"name":"comment","args":["驹�岢B竚"]},{"op":0,"name":"end","args":[]}],"body":[{"op":36,"name":"play_sound","args":[255]},{"op":8,"name":"set_result","args":[0]},{"op":29,"name":"fade_in","args":[]},{"op":0,"name":"end","args":[]}]}]}]}