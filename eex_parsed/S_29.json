,{"op":0,"name":"end","args":[]}]},{"index":10,"offset":24102,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[6,32,1]},{"op":5,"name":"test_flags","args":[[],[40]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[6,32,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[32,6,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&傅佥\n蒋兄，你为什么要这样做？\n&蒋舒\n还有为什么吗？我会让你知道在平等立足\n点上，你绝对不如我的事实！"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":[""]},"end":39},{"op":104,"name":"duel_setup","args":[6,32,24]},{"op":96,"name":"duel_say","args":[0,"哼！",9]},{"op":96,"name":"duel_say","args":[1,"蒋兄……",8]},{"op":97,"name":"duel_end","args":[]},{"op":100,"name":"duel_action","args":[0,8]},{"op":99,"name":"duel_say2","args":[0,"杀！",1]},{"op":100,"name":"duel_action","args":[0,2]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[1,2,1]},{"op":9,"name":"delay","args":[10]},{"op":100,"name":"duel_action","args":[1,10]},{"op":100,"name":"duel_action","args":[1,6]},{"op":99,"name":"duel_say2","args":[1,"看招！",1]},{"op":100,"name":"duel_action","args":[1,2]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":101,"name":"duel_action2","args":[1,4,0]},{"op":100,"name":"duel_action","args":[1,1]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[1,2,1]},{"op":99,"name":"duel_say2","args":[1,"看招！空舞燕离斩！",1]},{"op":100,"name":"duel_action","args":[1,2]},{"op":102,"name":"duel_action3","args":[1,1,0]},{"op":9,"name":"delay","args":[5]},{"op":99,"name":"duel_say2","args":[0,"为什么会这样？",1]},{"op":100,"name":"duel_action","args":[0,12]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&蒋舒\n不可能，不可能会有这种事情的？！"]},{"op":49,"name":"actor_select","args":[0,32,0,0,0,0,6]},{"op":20,"name":"dialog","args":["&傅佥\n我已经手下留情了，下次见面绝对不会是\n这样。"]},{"op":61,"name":"get_item","args":[100,0,1,6]},{"op":11,"name":"set_flag","args":[40,1]},{"op":0,"name":"end","args":[]}]},{"index":11,"offset":24938,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[6,56,1]},{"op":5,"name":"test_flags","args":[[],[41]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[6,56,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[56,6,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&傅佥\n句安！又是你干的好事！\n&句安\n呵呵呵，我只不过是给了他选择机会，选\n择可是他自己做的。\n&傅佥\n你为什么可以这样背叛自己的家园和亲\n人？\n&句安\n早在刘焉父子入主益州的时候，那里就\n已经不能成为我的家乡了。\n&句安\n我没有什么可以依靠的东西，所以只有地\n位和财富才可以满足我。\n&句安\n为了这些，我可以在夷陵毁掉刘备，也\n可以在曲阳毁掉句扶，更可以在这里毁\n掉你。\n&傅佥\n可恶…\n&句安\n我可以带着一身臭名享受这些东西，而你\n呢？或许上面的人会褒扬你的忠勇来做给\n下面的人看，但你终究是享受不到呀…"]},{"op":11,"name":"set_flag","args":[41,1]},{"op":0,"name":"end","args":[]}]},{"index":12,"offset":25533,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[6,147,1]},{"op":5,"name":"test_flags","args":[[],[42]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[6,147,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[147,6,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&胡烈\n想不到蜀地会有你这样勇猛的大将。\n&傅佥\n我可不想被你这种用卑劣手段的人夸奖。\n&胡烈\n是呀，但是为了要完成我的任务，什么样\n卑劣的手段我都必须要使用。"]},{"op":11,"name":"set_flag","args":[42,1]},{"op":0,"name":"end","args":[]}]},{"index":13,"offset":25800,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":54,"name":"test_attr","args":[147,7,0,2]},{"op":5,"name":"test_flags","args":[[],[52]]},{"op":0,"name":"end","args