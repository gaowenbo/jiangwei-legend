me":"test_flags","args":[[1030],[]]},"end":12},{"op":75,"name":"op_4b","args":[0,15,7,1,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[1030]]},"end":15},{"op":75,"name":"op_4b","args":[0,0,7,1,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["HEXи瓁砞﹚"]},"end":31},{"op":75,"name":"op_4b","args":[1,0,7,1,0]},{"op":75,"name":"op_4b","args":[2,15,11,0,0]},{"op":75,"name":"op_4b","args":[3,13,6,0,0]},{"op":75,"name":"op_4b","args":[4,14,6,0,0]},{"op":75,"name":"op_4b","args":[5,15,6,0,0]},{"op":75,"name":"op_4b","args":[6,13,7,0,0]},{"op":75,"name":"op_4b","args":[7,14,7,0,0]},{"op":75,"name":"op_4b","args":[8,15,7,0,0]},{"op":75,"name":"op_4b","args":[9,13,8,0,0]},{"op":75,"name":"op_4b","args":[10,14,8,0,0]},{"op":75,"name":"op_4b","args":[11,15,8,0,0]},{"op":75,"name":"op_4b","args":[12,12,28,0,1]},{"op":75,"name":"op_4b","args":[13,13,28,0,1]},{"op":75,"name":"op_4b","args":[14,14,28,0,1]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[1030]]},"end":34},{"op":72,"name":"battle_equipment","args":[111,0,0,0,0,3]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[1030],[]]},"end":39},{"op":72,"name":"battle_equipment","args":[147,33,65535,0,65535,3]},{"op":72,"name":"battle_equipment","args":[111,0,65535,0,65535,3]},{"op":72,"name":"battle_equipment","args":[137,41,65535,18,65535,0]},{"op":0,"name":"end","args":[]},{"op":39,"name":"change_scene","args":[3,65535,65535,65535,16]},{"op":28,"name":"fade_out","args":[]},{"op":36,"name":"play_sound","args":[2]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[1030]]},"end":99},{"op":20,"name":"dialog","args":["&卫瓘\n钟会这家伙居然把大军就这样丢给我\n指挥，自己不知道跑哪去了，实在是\n越想越火大。\n&王韬\n别这样说嘛，反正这场仗随便打打都赢，\n我们有十几万大军耶。\n&杜预\n阳安关的守军虽然不多，只是地势险要，\n我军的人数优势在这里无法发挥。\n&王韬\n（不知道句安那个蠢蛋在前线会怎么样，\n真搞不懂他为什么要自请打前锋。）"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&皇甫闿\n胡烈大军卡在前面动也不动，难道蜀军\n真的这么难对付？\n&夏侯咸\n那个胡烈还不是靠他老子的关系才能打\n前锋，我看他作战能力差劲透顶。\n&王买\n两位又如何呢？\n&王买\n一个姓皇甫，一个姓夏侯，应该都是名将\n之后吧。\n&皇甫闿\n别提了，我们皇甫家家道中落，从李傕\n之乱之后就没有出什么高官了。\n&皇甫闿\n现在留在安定的，只剩下那个开破医馆，\n赚没几个钱的笨蛋了。\n&夏侯咸\n我更惨好不好，现在姓夏侯的哪个不是\n战战兢兢，上次夏侯太初被杀可是把我\n吓到觉都睡不著。\n&王买\n难为你们两个了。"]},{"op":9,"name":"delay","args":[5]},{"op":79,"name":"unit_op_4f","args":[56,147,65535,0,0,1]},{"op":79,"name":"unit_op_4f","args":[148,147,65535,0,0,1]},{"op":20,"name":"dialog","args":["&胡烈\n前方挡住我军去路的是谁？\n&句安\n他叫做蒋舒，算是我认识的人，不知道\n护军大人愿不愿意把对付他的事情交给\n我？\n&胡渊\n爹，这个句安是名降将，万一他投敌\n怎么办？\n&胡烈\n我相信句将军对大魏的忠诚，这件事情就\n交给你了。\n&胡烈\n（如果句安投敌，那他才是脑筋烧坏了，\n猪都知道两边兵力相差悬殊。）"]},{"op":79,"name":"unit_op_4f","args":[148,65535,3,0,0,1]},{"op":50,"name":"actor_move","args":[0,56,0,16,7,3]},{"op":20,"name":"dialog","args":["&句安\n好久不见啦！\n&蒋舒\n我和你很熟吗？你我处于敌对状态，我对\n你没什么好说的。\n&句安\n过去我对你说过那么多次的话，你都没有\n考虑吗？\n&句安\n现在大魏这边投入十八万以上的兵力进攻\n蜀地，而你们这边最多也只能凑出十万人\n，两边战力根本不能比。\n&句安\n你想想，蜀地给了你什么？什么都没有，\n你又为什么要为这个烂政权卖命？\n&蒋舒\n………\n&句安\n你有才能，而且有胆略，偏偏却在这个\n地方被埋没。\n&句安\n既然这样，为什么不投向大魏，让你的\n才能获得真正的解放。\n&句安\n而且你想想，大魏和蜀国虽然同样都是\n外来政权，但大魏疆域广大，需要大量\n在地人士来协助统治。\n&句安\n这不就是你我益州人的出头机会？\n&蒋舒\n哼，你以为我蒋舒是这种会变节的小人？\n&句安\n少装了，如果你真的这么忠心，你就不会\n把军队带出来。\n&句安\n以你的聪明才智会不知道出击是找死？\n你只是想要找机会和我们接触而已。\n&蒋舒\n………烦请带路…"]},{"op":9,"name":"delay","args":[5]},{"op":50,"name":"actor_move","args":[0,56,0,19,6,3]},{"op":50,"name":"actor_move","args":[0,32,0,18,7,1]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&胡烈\n大魏征蜀护军胡烈，你应该就是蒋舒吧…\n&蒋舒\n是的。\n&胡烈\n虽然我不是主帅，不能给你什么承诺，\n不过如果你愿意协助我们的作战计画，\n到时一定会在将军前面给你美言几句。\n&蒋舒\n请问是什么样的计画？\n&胡烈\n如此这般…\n&蒋舒\n好，我就照你说的去做。"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&傅佥\n蒋兄出击已经过了好一阵子，不知道情况\n如何？"]},{"op":9,"name":"delay","args":[5]},{"op":50,"name":"actor_move","args":[0,32,0,5,8,3]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&步兵12\n蒋将军回来了！\n&傅佥\n蒋兄平安就好，快快请他进来。\n&蒋舒\n呵呵呵…"]},{"op":9,"name":"delay","args":[5]},{"op":80,"name":"unit_status","args":[32,6,1,0]},{"op":80,"name":"unit_status","args":[269,3,0,0]},{"op":35,"name":"play_music","args":[35,1]},{"op":20,"name":"dialog","args":["&步兵12\n啊！！！这是怎么回事？！"]},{"op":83,"name":"unit_op_53","args":[0,269,0,0,0,0,6,1]},{"op":9,"name":"delay","args":[5]},{"op":80,"name":"unit_status","args":[32,6,1,0]},{"op":80,"name":"unit_status","args":[270,3,0,0]},{"op":35,"name":"play_music","args":[35,1]},{"op":20,"name":"dialog","args":["&步兵13\n蒋将军叛变了！"]},{"op":83,"name":"unit_op_53","args":[0,270,0,0,0,0,6,1]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&蒋舒\n后面的军队快趁这个机会跟我进来！\n"]},{"op":76,"name":"unit_op_4c","args":[0,258,0]},{"op":76,"name":"unit_op_4c","args":[0,259,0]},{"op":76,"name":"unit_op_4c","args":[0,260,0]},{"op":76,"name":"unit_op_4c","args":[0,261,0]},{"op":76,"name":"unit_op_4c","args":[0,262,0]},{"op":76,"name":"unit_op_4c","args":[0,263,0]},{"op":76,"name":"unit_op_4c","args":[0,264,0]},{"op":76,"name":"unit_op_4c","args":[0,265,0]},{"op":76,"name":"unit_op_4c","args":[0,266,0]},{"op":76,"name":"unit_op_4c","args":[0,267,0]},{"op":76,"name":"unit_op_4c","args":[0,282,0]},{"op":76,"name":"unit_op_4c","args":[0,283,0]},{"op":76,"name":"unit_op_4c","args":[0,284,0]},{"op":76,"name":"unit_op_4c","args":[0,285,0]},{"op":76,"name":"unit_op_4c","args":[0,286,0]},{"op":76,"name":"unit_op_4c","args":[0,287,0]},{"op":76,"name":"unit_op_4c","args":[0,288,0]},{"op":76,"name":"unit_op_4c","args":[0,289,0]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&傅佥\n蒋兄你…\n&蒋舒\n良禽择木而栖，这是我一生一世难得的\n发达机会，我不希望任何人妨碍我。\n&傅佥\n过去我一直认为蒋兄你虽然常常发牢骚，\n但至少是个尽忠职守的人。\n&傅佥\n没想到你居然投靠曹贼？\n&蒋舒\n你懂我心中的感受？你懂那种怀才不遇的\n感觉？\n&傅佥\n够了！今天纵然我注定要死在这里，也要\n把蒋兄你一起带下去！\n&蒋舒\n你办得到就来吧，若是在平等地位上竞争\n，你不会是我的对手。"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[1030],[]]},"end":147},{"op":20,"name":"dialog","args":["&卫瓘\n钟会这混蛋居然把大军丢给我指挥，然\n后自己不知道到哪去，实在是越想越火\n大。\n&王韬\n别这样说嘛，反正这场仗随便打打都赢，\n我们有十几万大军耶。\n&杜预\n阳安关的守军虽然不多，只是地势险要，\n我军的人数优势在这里无法发挥。\n&卫瓘\n（这杜预看来也挺不含糊，不过这家伙\n到底是多爱春秋，为什么要发给我们一\n人一本？）\n&王韬\n（不知道句安那个蠢蛋在前线会怎么样，\n真搞不懂他为什么要自请打前锋。）"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&皇甫闿\n胡烈大军卡在前面动也不动，难道蜀军\n真的这么难对付？\n&夏侯咸\n那个胡烈还不是靠他老子的关系才能打\n前锋，我看他作战能力差劲透顶。\n&王买\n两位又如何呢？\n&王买\n一个姓皇甫，一个姓夏侯，应该都是名将\n之后吧。\n&皇甫闿\n别提了，我们皇甫家家道中落，从李傕\n之乱之后就没有出什么高官了。\n&皇甫闿\n现在留在安定的，只剩下那个开破医馆，\n赚没几个钱的笨蛋了。\n&夏侯咸\n我更惨好不好，现在姓夏侯的哪个不是\n战战兢兢，上次夏侯太初被杀可是把我\n吓到觉都睡不著。\n&王买\n难为你们两个了。"]},{"op":9,"name":"delay","args":[5]},{"op":79,"name":"unit_op_4f","args":[56,147,65535,0,0,1]},{"op":79,"name":"unit_op_4f","args":[148,147,65535,0,0,1]},{"op":20,"name":"dialog","args":["&胡烈\n前方挡住我军去路的是谁？\n&句安\n他叫做傅佥，我和他交手过几次，算是\n挺难缠的对手。\n&胡渊\n不管再怎么难缠，带著三千人就想和我们\n大军战斗，简直就是找死。\n&句安\n我倒是有办法可以不费一兵一卒拿下这\n阳安关。\n&胡烈\n哦，我倒想听听看。\n&句安\n现在在后方镇守阳安关的将领名叫蒋舒，\n算是我认识的人，不知道护军大人愿不愿\n意把对付他的事情交给我？\n&胡渊\n爹，这个句安是名降将，万一他投敌\n怎么办？\n&胡烈\n我相信句将军对大魏的忠诚，这件事情就\n交给你了。\n&胡烈\n（如果句安投敌，那他才是脑筋烧坏了，\n猪都知道两边兵力相差悬殊。）"]},{"op":79,"name":"unit_op_4f","args":[148,65535,3,0,0,1]},{"op":49,"name":"actor_select","args":[0,56,0,0,0,0,6]},{"op":85,"name":"unit_move","args":[0,56,0,5,7,3]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&句安\n好久不见啦！\n&蒋舒\n我和你很熟吗？你我处于敌对状态，我对\n你没什么好说的。\n&句安\n过去我对你说过那么多次的话，你都没有\n考虑吗？\n&句安\n现在大魏这边投入十八万以上的兵力进攻\n蜀地，而你们这边最多也只能凑出十万人\n，两边战力根本不能比。\n&句安\n你想想，蜀国给了你什么？什么都没有，\n你又为什么要为这个烂国家卖命？\n&蒋舒\n………\n&句安\n你有才能，而且有胆略，偏偏却在这个\n地方被埋没。\n&句安\n既然这样，为什么不投向大魏，让你的\n才能获得真正的解放。\n&句安\n而且你想想，大魏和蜀国虽然同样都是\n外来政权，但大魏疆域广大，需要大量\n在地人士来协助统治。\n&句安\n这不就是你我益州人的出头机会？\n&蒋舒\n哼，你以为我蒋舒是这种会变节的小人？\n&句安\n少装了，如果你不想当叛徒，早该叫人\n把我射成刺猬不是吗？\n&蒋舒\n………开城门…"]},{"op":9,"name":"delay","args":[5]},{"op":49,"name":"actor_select","args":[0,269,0,0,0,0,6]},{"op":49,"name":"actor_select","args":[0,270,0,0,0,0,6]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&胡烈\n大魏征蜀护军胡烈，你应该就是傅佥吧…\n&傅佥\n我不想和敌人废话，快快来迎战吧！\n&胡渊\n爹！让我来砍死这家伙！\n&胡烈\n我也很想上呀，不过现在似乎没有这个\n必要了，你看看阳安关那边。\n&胡渊\n什么？！"]},{"op":9,"name":"delay","args":[5]},{"op":79,"name":"unit_op_4f","args":[6,65535,3,0,0,0]},{"op":80,"name":"unit_status","args":[6,3,0,1]},{"op":20,"name":"dialog","args":["&傅佥\n怎么会这样？！为什么阳安关会换上曹贼\n的旗帜？蒋兄怎么了？"]},{"op":9,"name":"delay","args":[5]},{"op":79,"name":"unit_op_4f","args":[56,65535,1,0,0,1]},{"op":50,"name":"actor_move","args":[0,32,0,5,8,1]},{"op":80,"name":"unit_status","args":[32,7,0,1]},{"op":20,"name":"dialog","args":["&蒋舒\n我部部队出动！一定要拿下傅佥人头，\n抢下这献城首功。\n&句安\n（蒋舒这小子还挺机灵的，抢功真是不落\n人后。）"]},{"op":76,"name":"unit_op_4c","args":[0,258,0]},{"op":76,"name":"unit_op_4c","args":[0,259,0]},{"op":76,"name":"unit_op_4c","args":[0,260,0]},{"op":76,"name":"unit_op_4c","args":[0,261,0]},{"op":76,"name":"unit_op_4c","args":[0,262,0]},{"op":76,"name":"unit_op_4c","args":[0,263,0]},{"op":76,"name":"unit_op_4c","args":[0,264,0]},{"op":76,"name":"unit_op_4c","args":[0,265,0]},{"op":76,"name":"unit_op_4c","args":[0,266,0]},{"op":76,"name":"unit_op_4c","args":[0,267,0]},{"op":76,"name":"unit_op_4c","args":[0,282,0]},{"op":76,"name":"unit_op_4c","args":[0,283,0]},{"op":76,"name":"unit_op_4c","args":[0,284,0]},{"op":76,"name":"unit_op_4c","args":[0,285,0]},{"op":76,"name":"unit_op_4c","args":[0,286,0]},{"op":76,"name":"unit_op_4c","args":[0,287,0]},{"op":76,"name":"unit_op_4c","args":[0,288,0]},{"op":76,"name":"unit_op_4c","args":[0,289,0]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&傅佥\n蒋兄你…\n&蒋舒\n良禽择木而栖，这是我一生一世难得的\n发达机会，我不希望任何人妨碍我。\n&傅佥\n过去我一直认为蒋兄你虽然常常发牢骚，\n但至少是个尽忠职守的人。\n&傅佥\n没想到你居然投靠曹贼？\n&蒋舒\n你懂我心中的感受？你懂那种怀才不遇的\n感觉？\n&傅佥\n够了！今天纵然我注定要死在这里，也要\n把蒋兄你一起带下去！\n&蒋舒\n你办得到就来吧，若是在平等地位上竞争\n，你不会是我的对手。"]},{"op":0,"name":"end","args":[]},{"op":36,"name":"play_sound","args":[74]},{"op":25,"name":"victory_cond_text","args":["胜利条件\n一﹑？？？\n\n失败条件\n一﹑傅佥死亡。"]},{"op":26,"name":"battle_goal_text","args":["�@�N�H�H�H"]},{"op":20,"name":"dialog","args":["印绶条件\n触发所有单挑和对话。"]},{"op":90,"name":"ui_5a","args":[]},{"op":8,"name":"set_result","args":[1]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":17914,"sections":[{"index":0,"offset":17916,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":63,"name":"test_turn","args":[15,2]},{"op":64,"name":"test_side","args":[1]},{"op":5,"name":"test_flags","args":[[],[11]]},{"op":0,"name":"end","args":[]}],"body":[{"op":80,"name":"unit_status","args":[6,9,0,1]},{"op":20,"name":"dialog","args":["&傅佥\n我还能打，快来呀！你们这些贼军！"]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[40,41,42],[]]},"end":6},{"op":20,"name":"dialog","args":["达成印绶条件\n触发所有单挑和对话。"]},{"op":61,"name":"get_item","args":[97,0,1,6]},{"op":0,"name":"end","args":[]},{"op":9,"name":"delay","args":[5]},{"op":36,"name":"play_sound","args":[50]},{"op":76,"name":"unit_op_4c","args":[0,107,0]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&钟会\n看来是大势已定了，我现在出来得应该正\n是时候吧，哈哈哈…"]},{"op":21,"name":"unit_say","args":[137,137,"（等到仗都打完了才出来捡尾刀，真是\n小人。）"]},{"op":9,"name":"delay","args":[5]},{"op":50,"name":"actor_move","args":[0,107,0,27,4,2]},{"op":9,"name":"delay","args":[5]},{"op":80,"name":"unit_status","args":[107,3,0,1]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&钟会\n该死，怎么会马蹄陷到泥巴堆里？\n&钟会\n糟了？！我太大意了！"]},{"op":9,"name":"delay","args":[5]},{"op":36,"name":"play_sound","args":[88]},{"op":76,"name":"unit_op_4c","args":[0,139,0]},{"op":79,"name":"unit_op_4f","args":[107,65535,0,0,0,1]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&许仪\n你以为把俺带在身边，俺就没有办法对付\n你这个贱人？\n&许仪\n你身为钟太傅的儿子，居然不思报效大魏\n，反而和司马家狼狈为奸。\n&许仪\n因为你的奸计，让圣上和公主本来要夺去\n司马昭兵权的计划功亏一篑。\n&许仪\n之后你又刺激圣上起兵，害圣上惨遭杀\n害。\n&许仪\n司马家的张狂全都是因为你，只要杀了你\n，公主绝对可以推翻司马家的。\n&钟会\n你原来从头到尾的目标就是我？你杀了我\n也没用的，以大将军现在的势力，就算是\n武皇帝复活都对付不了他。\n&许仪\n俺管不了这么多，今天就是你钟会的\n死期！"]},{"op":50,"name":"actor_move","args":[0,139,0,27,3,2]},{"op":9,"name":"delay","args":[5]},{"op":76,"name":"unit_op_4c","args":[0,57,0]},{"op":20,"name":"dialog","args":["&庞会\n许仪，我早就看出你这家伙图谋不轨。"]},{"op":9,"name":"delay","args":[5]},{"op":50,"name":"actor_move","args":[0,57,0,26,3,1]},{"op":79,"name":"unit_op_4f","args":[139,65535,3,0,0,1]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&许仪\n你是谁？\n&庞会\n哼，南安庞令明之子庞会！"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["虫珼矪竚"]},"end":77},{"op":104,"name":"duel_setup","args":[139,57,24]},{"op":96,"name":"duel_say","args":[1,"你爹明明是大魏的忠臣，为什么\n要帮助这样的逆贼？",0]},{"op":96,"name":"duel_say","args":[0,"因为他可以完成我的复仇大业！",0]},{"op":97,"name":"duel_end","args":[]},{"op":99,"name":"duel_say2","args":[0,"杀！",1]},{"op":100,"name":"duel_action","args":[0,2]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":101,"name":"duel_action2","args":[1,4,0]},{"op":100,"name":"duel_action","args":[1,1]},{"op":101,"name":"duel_action2","args":[0,3,0]},{"op":100,"name":"duel_action","args":[0,2]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":101,"name":"duel_action2","args":[0,4,0]},{"op":100,"name":"duel_action","args":[0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":101,"name":"duel_action2","args":[0,2,1]},{"op":9,"name":"delay","args":[10]},{"op":100,"name":"duel_action","args":[1,12]},{"op":99,"name":"duel_say2","args":[1,"呼！呼！呼！",1]},{"op":100,"name":"duel_action","args":[0,12]},{"op":99,"name":"duel_say2","args":[0,"呼！呼！呼！",1]},{"op":99,"name":"duel_say2","args":[0,"真不愧是许褚的儿子…",1]},{"op":99,"name":"duel_say2","args":[1,"能跟俺打成这样，庞德的儿子\n也真有一手。",1]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":9,"name":"delay","args":[5]},{"op":80,"name":"unit_status","args":[139,9,0,1]},{"op":80,"name":"unit_status","args":[57,9,0,1]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&许仪\n你这家伙还真黏人！\n&庞会\n说什么都不会让你碰到都督一根汗毛。\n&许仪\n你爹当年为报武皇帝知预之恩，不惜与故\n主决裂，甚至挑战关羽！\n&许仪\n咱们老爹都是武帝的猛将，你为何要帮钟\n会这贱人？俺只是牙门将都知报效曹家，\n你是将军，却反忘记曹家对庞家的照顾？\n&庞会\n武皇帝一句于事无补的于禁忠烈不如庞德\n，难道能挽回我爹的性命？我爹战死，是\n曹家亏欠庞家才对。\n&庞会\n我不在乎江山在哪家人手中，我只关心谁\n能帮我报仇！\n&钟会\n呵呵呵，想杀我，再等几百年吧！"]},{"op":9,"name":"delay","args":[5]},{"op":50,"name":"actor_move","args":[0,6,0,27,5,0]},{"op":20,"name":"dialog","args":["&傅佥\n就算要死，也要带走几个敌将再死！"]},{"op":79,"name":"unit_op_4f","args":[139,65535,2,0,0,1]},{"op":20,"name":"dialog","args":["&许仪\n你不就是当时潜入洛阳的那个蜀将？快点\n杀了这个奸贼！\n&傅佥\n许仪？！为什么你会和自己的友军交战？\n不管了，先宰了这个人再说！\n&钟会\n不好，快来人！"]},{"op":9,"name":"delay","args":[5]},{"op":49,"name":"actor_select","args":[0,32,0,0,0,0,6]},{"op":85,"name":"unit_move","args":[0,32,0,27,6,0]},{"op":80,"name":"unit_status","args":[32,6,1,0]},{"op":80,"name":"unit_status","args":[6,3,0,0]},{"op":35,"name":"play_music","args":[35,1]},{"op":9,"name":"delay","args":[5]},{"op":79,"name":"unit_op_4f","args":[6,65535,2,0,0,1]},{"op":20,"name":"dialog","args":["&傅佥\n蒋兄你…\n&蒋舒\n为了我在大魏的地位和未来，我不得不这\n么做…要恨我就尽管恨吧…\n&傅佥\n醒醒吧…当初在我被欺负的时候挺身保护\n我的蒋兄到哪去了？\n&蒋舒\n………"]},{"op":27,"name":"op_1b","args":[6,0]},{"op":83,"name":"unit_op_53","args":[0,6,0,0,0,0,6,1]},{"op":20,"name":"dialog","args":["傅佥在阳安关力战身亡，当时的人都称许\n他与父亲傅肜二人是“奕世忠义”。\n\n\n六年后，晋武帝司马炎特别称赞他说：\n“蜀将军傅佥，前在关城，身拒官军，\n致死不顾。佥父肜，复为刘备战亡。\n\n天下之善一也，岂由彼此以为异？”"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&庞会\n好机会！"]},{"op":80,"name":"unit_status","args":[57,6,1,0]},{"op":80,"name":"unit_status","args":[139,3,0,0]},{"op":35,"name":"play_music","args":[35,1]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&许仪\n就差这么一点点…"]},{"op":83,"name":"unit_op_53","args":[0,139,0,0,0,0,6,0]},{"op":20,"name":"dialog","args":["&钟会\n把这家伙给我带下去！我要让他尝尝最\n痛苦的死法！"]},{"op":11,"name":"set_flag","args":[11,1]},{"op":89,"name":"op_59","args":[1200,97,65535,65535,65535,65535,65535,65535]},{"op":73,"name":"ui_49","args":[]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":1,"offset":21480,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":63,"name":"test_turn","args":[3,2]},{"op":5,"name":"test_flags","args":[[],[12]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&傅佥\n还没有完，我就算是死也不会投降你们\n这些恶贼！\n&王韬\n这家伙真是个“硬颈”的大将。\n&杜预\n别以为我不知道你在酸我，给我小心\n一点！"]},{"op":9,"name":"delay","args":[5]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[1030]]},"end":9},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,0,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,1,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,2,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,3,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,4,2,65535,0,0]},{"op":0,"name":"end","args":[]},{"op":11,"name":"set_flag","args":[12,1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":22040,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":63,"name":"test_turn","args":[6,2]},{"op":5,"name":"test_flags","args":[[],[13]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&傅佥\n来呀！再来呀！\n&卫瓘\n这家伙是疯了吗？怎么会这么可怕？\n&杜预\n拿出点监军的派头，不要三两下就怕成\n这样。"]},{"op":9,"name":"delay","args":[5]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[1030]]},"end":9},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,0,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,1,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,2,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,3,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,4,2,65535,0,0]},{"op":0,"name":"end","args":[]},{"op":11,"name":"set_flag","args":[13,1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":22575,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":63,"name":"test_turn","args":[9,2]},{"op":5,"name":"test_flags","args":[[],[14]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&傅佥\n只有我有一口气在，绝对不会让任何一个\n人通过阳安关。\n&王韬\n这种气魄，简直就像是当日襄武之战的\n张嶷一样。"]},{"op":9,"name":"delay","args":[5]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[1030]]},"end":9},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,0,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,1,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,2,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,3,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,4,2,65535,0,0]},{"op":0,"name":"end","args":[]},{"op":11,"name":"set_flag","args":[14,1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":23112,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":63,"name":"test_turn","args":[12,2]},{"op":5,"name":"test_flags","args":[[],[15]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&傅佥\n我是谁？对了...我是傅佥！永不放弃的\n男人！\n&卫瓘\n还不快点杀了他，不要让他靠过来！\n&杜预\n虽然是敌将，但是实在让人敬佩，何时\n我大魏才能有这样的将领呢？"]},{"op":9,"name":"delay","args":[5]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[1030]]},"end":9},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,0,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,1,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,6,0,0,0,0,0,6,2,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":