nd","args":[]}],"body":[{"op":20,"name":"dialog","args":["&关索\n让唯一能说服虞汜的人撤退，你们到底\n在干嘛？"]},{"op":49,"name":"actor_select","args":[0,16,0,0,0,0,6]},{"op":73,"name":"ui_49","args":[]},{"op":14,"name":"ui_0e","args":[]},{"op":11,"name":"set_flag","args":[76,1]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":26,"offset":26871,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[664,7,0,2]},{"op":5,"name":"test_flags","args":[[],[66]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&张政\n哈哈哈…难道这真的是上天安排？\n&张政\n四十多年前靠虞翻才获得这座城，现在他\n儿子却出卖这座城，真是讽刺呀！\n&张政\n虞汜！大吴如果因为你的背叛而有什么\n不测，我做鬼都会来找你！"]},{"op":83,"name":"unit_op_53","args":[0,664,0,0,0,0,6,1]},{"op":11,"name":"set_flag","args":[66,1]},{"op":0,"name":"end","args":[]}]},{"index":27,"offset":27151,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[21,7,0,2]},{"op":5,"name":"test_flags","args":[[],[60]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&罗宪\n情况不妙，快撤退！"]},{"op":49,"name":"actor_select","args":[0,21,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[60,1]},{"op":0,"name":"end","args":[]}]},{"index":28,"offset":27275,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[40,7,0,2]},{"op":5,"name":"test_flags","args":[[],[242]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&诸葛瞻\n我真的不适合带兵吗？"]},{"op":49,"name":"actor_select","args":[0,40,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[242,1]},{"op":0,"name":"end","args":[]}]},{"index":29,"offset":27403,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[110,7,0,2]},{"op":5,"name":"test_flags","args":[[],[81]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&羊祜\n陆抗，你真是可怕的对手呀。"]},{"op":49,"name":"actor_select","args":[0,110,0,0,0,0,6]},{"op":11,"name