s":[]}]},{"index":11,"offset":22433,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[4,14,1]},{"op":5,"name":"test_flags","args":[[],[40]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[4,14,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[14,4,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&句扶\n你就是马隆马孝兴？\n&马隆\n不错。\n&句扶\n那么…接招吧！\n&马隆\n怎么会这样？！"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":[""]},"end":59},{"op":104,"name":"duel_setup","args":[4,14,13]},{"op":96,"name":"duel_say","args":[0,"且慢！我并没有要与你们为敌。",6]},{"op":96,"name":"duel_say","args":[1,"我和你单挑，可不因为你是敌人。",9]},{"op":99,"name":"duel_say2","args":[0,"这什么意思？！",1]},{"op":99,"name":"duel_say2","args":[1,"快出招吧，不然死的就是你了。",1]},{"op":97,"name":"duel_end","args":[]},{"op":100,"name":"duel_action","args":[0,2]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,3,0]},{"op":99,"name":"duel_say2","args":[1,"牙旋豪斧！",1]},{"op":100,"name":"duel_action","args":[1,2]},{"op":101,"name":"duel_action2","args":[1,2,1]},{"op":100,"name":"duel_action","args":[1,2]},{"op":102,"name":"duel_action3","args":[0,1,1]},{"op":100,"name":"duel_action","args":[1,1]},{"op":100,"name":"duel_action","args":[1,8]},{"op":100,"name":"duel_action","args":[0,1]},{"op":101,"name":"duel_action2","args":[1,3,1]},{"op":99,"name":"duel_say2","args":[0,"三十六烦恼凤！",1]},{"op":100,"name":"duel_action","args":[0,2]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":101,"name":"duel_action2","args":[1,3,0]},{"op":100,"name":"duel_action","args":[0,1]},{"op":100,"name":"duel_action","args":[0,2]},{"op":100,"name":"duel_action","args":[0,1]},{"op":100,"name":"duel_action","args":[1,2]},{"op":100,"name":"duel_action","args":[1,2]},{"op":101,"name":"duel_action2","args":[0,3,1]},{"op":100,"name":"duel_action","args":[0,2]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":101,"name":"duel_action2","args":[1,4,0]},{"op":100,"name":"duel_action","args":[1,1]},{"op":101,"name":"duel_action2","args":[1,2,1]},{"op":9,"name":"delay","args":[20]},{"op":100,"name":"duel_action","args":[1,6]},{"op":99,"name":"duel_say2","args":[1,"好厉害！",1]},{"op":100,"name":"duel_action","args":[0,0]},{"op":99,"name":"duel_say2","args":[0,"你也是很强呀，我从来没有\n看过可以和我打这么久的人。",1]},{"op":100,"name":"duel_action","args":[0,6]},{"op":9,"name":"delay","args":[10]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&句扶\n我只是试试看，你有多大的本事。至少\n武艺方面你是合格了。\n&句扶\n加入我们吧，像你这样的人才却只能在这\n偏远地方当小官，实在是被埋没了。\n&马隆\n请让我再想想…"]},{"op":11,"name":"set_flag","args":[40,1]},{"op":0,"name":"end","args":[]}]},{"index":12,"offset":23629,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[1,14,1]},{"op":5,"name":"test_flags","args":[[],[41]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[1,14,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[14,1,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&诸葛果\n八阵之法，依天、地、风、云、鸟、蛇、\n龙、虎之形，共有三百六十五变。"]},{"op":20,"name":"dialog","args":["&马隆\n姑娘所言不对，这只是武侯八阵之法的\n表面而已。\n&马隆\n治兵以信，求圣以奇。\n信不可易，战无常规。\n&马隆\n可握则握，可施则施。\n千变万化，敌莫能知。\n&马隆\n这才是八阵的根本。\n&马隆\n若以此法应用来行军布阵，则天下强敌\n尽可为之所克。\n&马隆\n武侯能在短时间之内将蜀军训练成能和\n大魏百万雄师相抗衡的劲旅，靠的应该\n就是这个。\n&诸葛果\n看来你知晓八阵并非偶然，确实是值得\n主公发掘的人才。"]},{"op":11,"name":"set_flag","args":[41,1]},{"op":0,"name":"end","args":[]}]},{"index":13,"offset":24200,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[0,14,1]},{"op":5,"name":"test_flags","args":[[],[310]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[0,14,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[14,0,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&姜维\n你应该就是马孝兴吧。我是大汉大将军\n姜维。\n&姜维\n当我接到信的那刻，很高兴知道这世上\n还有如此人才。\n&姜维\n不知是否愿意弃暗投明，归顺我大汉呢？\n&马隆\n那么请回答一个问题，你明知蜀国国小\n民贫，却再三对我大魏发动攻势，所求\n到底为何？\n&姜维\n和当年的我一模一样呀。\n&姜维\n当年我也问丞相这样的问题，丞相回答\n说是知遇之恩。\n&姜维\n但我知道那样的回答或许可以满足我，\n却不一定可以满足你。\n&姜维\n我奋战是为了许多因素，既为了报恩，\n也为了实现承诺。\n&马隆\n结果到头来，你还是跟在刘备和诸葛亮\n后面，单纯执行著他们的遗志而已？\n&姜维\n何出此言？\n&马隆\n说实话，我并不讨厌这样浪漫的想法，\n只是这样的格局实在是太小了。\n&马隆\n要打倒有著庞大利益作为后盾的司马家，\n这种程度的情义并不够。\n&姜维\n你说得对…但你眼中这点小情小义，\n就足够支撑我辅汉近四十年。\n&马隆\n我很难认同你的想法，不过说我没有意愿\n加入你们是骗人的。\n&马隆\n在兖州被埋没十数载，最后被丢到边地，\n我不甘心自己就这样结束一生。\n&姜维\n那么，就用丞相当年说过的话来对你说。\n&姜维\n这里就是你的舞台，也是千载难逢的机会\n，我希望你能成为我的接班人。\n&姜维\n你不用急着回答我，想清楚了再说。"]},{"op":11,"name":"set_flag","args":[310,1]},{"op":0,"name":"end","args":[]}]},{"index":14,"offset":25335,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[0,148,1]},{"op":5,"name":"test_flags","args":[[],[43]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[0,148,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[148,0,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&胡渊\n姜维，别以为你对我们伸出援手，我就会\n对你表示友好。\n&姜维\n随便你吧，我只能表示对胡将军的哀悼\n之意。\n&胡渊\n如果你能来早一点，就不会有这样的\n悲剧了，该死！"]},{"op":11,"name":"set_flag","args":[43,1]},{"op":0,"name":"end","args":[]}]},{"index":15,"offset":25610,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":46,"name":"test_adjacent","args":[14,218,1]},{"op":5,"name":"test_flags","args":[[310],[45]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args