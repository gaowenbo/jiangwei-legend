":[8,1,7,1,1]},{"op":75,"name":"op_4b","args":[9,0,0,1,0]},{"op":75,"name":"op_4b","args":[10,0,0,1,0]},{"op":75,"name":"op_4b","args":[11,0,0,1,0]},{"op":75,"name":"op_4b","args":[12,0,0,1,0]},{"op":75,"name":"op_4b","args":[13,0,0,1,0]},{"op":75,"name":"op_4b","args":[14,0,0,1,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[1011],[]]},"end":30},{"op":72,"name":"battle_equipment","args":[7,53,0,0,0,0]},{"op":72,"name":"battle_equipment","args":[93,0,0,21,0,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[1011]]},"end":36},{"op":72,"name":"battle_equipment","args":[801,0,0,14,0,0]},{"op":72,"name":"battle_equipment","args":[80,0,0,13,0,0]},{"op":72,"name":"battle_equipment","args":[93,41,0,21,0,15]},{"op":72,"name":"battle_equipment","args":[7,53,0,0,0,0]},{"op":0,"name":"end","args":[]},{"op":39,"name":"change_scene","args":[3,65535,65535,65535,18]},{"op":28,"name":"fade_out","args":[]},{"op":36,"name":"play_sound","args":[54]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":[""]},"end":76},{"op":20,"name":"dialog","args":["&司马懿\n蜀军果然开始撤退，居然连靠近渭水的\n营寨都放弃，看来诸葛亮真的已经死了。\n&司马懿\n将士们，抓住这一生一世的机会，斩杀\n敌人立功，将所有蜀贼一个不留地歼灭\n于我大魏国境内！\n"]},{"op":79,"name":"unit_op_4f","args":[81,146,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[146,81,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&胡遵\n这次的追击是难得的立功机会，护军\n你不想追击？\n&秦朗\n别开玩笑了，就算建功升官又怎么样？\n万一有生命危险就糟了。\n&胡遵\n怕什么？虎豹骑不都挡在前面？再不，\n还有我来保护征蜀护军你。\n&秦朗\n（这个胡遵真不是东西，根本就知道我\n怕得要死，还在那边偷酸我。）\n&秦朗\n（哼，你这西凉人没水准，我才不和你\n计较呢！）"]},{"op":79,"name":"unit_op_4f","args":[81,65535,2,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[146,65535,2,65535,0,1]},{"op":20,"name":"dialog","args":["&张虎\n本来想要打前锋的，没想到被夏侯渊的\n四个儿子抢先了。\n&乐綝\n也没什么好可惜的，秦朗把虎豹骑交给\n他们可没安什么好心眼。\n&张虎\n话虽如此，但是中军虎豹骑的战力之强，\n身为武将总是希望能够带领看看。\n&乐綝\n说得也是，这样的部队让秦朗那种人带\n实在是太可惜了。"]},{"op":20,"name":"dialog","args":["&戴陵\n哈，两位虽然是名将之子，但是毕竟外姓\n比不过亲戚。\n&张虎\n闭嘴，你这没有伟大父亲的平凡人。\n&乐綝\n就是，平凡人就给我安静点。\n&戴陵\n（真倒楣，老是要照顾这两个蠢蛋。）"]},{"op":79,"name":"unit_op_4f","args":[801,65535,0,65535,1,1]},{"op":79,"name":"unit_op_4f","args":[83,65535,0,65535,1,1]},{"op":20,"name":"dialog","args":["&郭淮\n费将军，真是委屈您要在我这里，实在\n是郭淮需要您的协助。\n&费曜\n没有这回事，我反而很高兴能和伯济合作\n。我对司马懿一点好感也没有，胆小懦弱\n，对士卒又有种高高在上的感觉。\n&费曜\n到现在我都很怀念子丹将军，他才是名将\n的典范。\n&费曜\n以前我很怨叹自己的副将地位，现在\n才知道当他的副将有多幸福。\n&鲁芝\n我也是有同样想法，虽说司马懿用的是最\n稳当的方法，但是他却总是忽略对于军心\n的伤害。\n&郭淮\n不过我已经接到大将军的追击命令，两位\n愿意帮我一把，追击蜀军吗？\n&费曜\n义不容辞！不管怎么样不满，我都是大魏\n的臣子。\n&鲁芝\n我也是。"]},{"op":79,"name":"unit_op_4f","args":[801,65535,2,65535,1,1]},{"op":79,"name":"unit_op_4f","args":[83,65535,2,65535,1,1]},{"op":79,"name":"unit_op_4f","args":[7,65535,0,65535,1,1]},{"op":20,"name":"dialog","args":["&夏侯霸\n三位弟弟，你们还记得父亲阵亡的那一天\n是什么情况吗？\n&夏侯威\n父亲的尸首居然落在敌人手上。\n&夏侯和\n我们想要帮他送葬都不可得。\n&夏侯惠\n当时甚至连刚强的武帝都哭了出来。"]},{"op":20,"name":"dialog","args":["&夏侯霸\n那一天我永远忘不掉，那种痛苦和不甘。\n朝廷中每个人看我们的眼神既是同情却\n又带有嘲讽。\n&夏侯霸\n过去父亲战无不胜，攻无不克的时候，\n大家对我们毕恭毕敬。\n&夏侯霸\n等到父亲败亡时却又是那样的态度，我\n满腔的愤恨不只是对蜀人，也是对朝廷\n这些残酷的家伙。\n&夏侯霸\n我希望建功立业，爬到这些人不敢仰望的\n位置，让这些人永远不敢瞧不起夏侯家。\n&夏侯威\n二哥，不管您要做什么我都支持您，若是\n没有您撑著夏侯家，我们早就已经沉沦下\n去了。\n&夏侯和\n只是二哥你也不要过于心急，当时五哥就\n是一时冲动才会跟著父亲一起丧命的。\n&夏侯惠\n有现在的位置就已经很足够了，圣上对\n我们也算照顾有加，不要再贪心了。\n&夏侯霸\n不行，我一定要利用这场战事立功，接著\n让我自己爬到权力的最高峰。\n&夏侯霸\n我绝对不会像司马懿那样丢脸，看他那样\n胆小懦弱的模样，绝对成不了大器。\n&夏侯和\n（二哥完全看走眼了，我倒认为司马懿\n是个能忍人所不能忍的怪物。）"]},{"op":79,"name":"unit_op_4f","args":[7,65535,2,65535,1,1]},{"op":9,"name":"delay","args":[10]},{"op":20,"name":"dialog","args":["&孟琰\n到底发生什么事了？为什么贼人像潮水\n一般涌上来？"]},{"op":80,"name":"unit_status","args":[256,7,0,1]},{"op":20,"name":"dialog","args":["&牛金\n哈哈哈，死到临头都不知道！就让俺老牛\n来告诉你。\n&牛金\n你们家的丞相已经挂了，现在蜀人四处\n逃窜，只有可怜的你还不知道。\n&孟琰\n丞相他…过世了…怎么可能…"]},{"op":20,"name":"dialog","args":["&牛金\n一个被自己人抛弃的可怜虫，不如投降\n俺老牛吧。\n&牛金\n如此你也有机会去对付那些背叛你的人。\n&孟琰\n住口！"]},{"op":80,"name":"unit_status","args":[28,7,0,1]},{"op":20,"name":"dialog","args":["&孟琰\n就算是战死，也不可能投降你们魏贼！\n&孟琰\n当初丞相从南中地方把老子拔擢起来，\n完全把老子当自己人。\n&孟琰\n老子朱提孟家能有现在的地位，全都是\n拜丞相所赐。这种恩情，就算死一百次\n也还不清。\n&牛金\n哼！那么就去死吧。"]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[1011]]},"end":70},{"op":20,"name":"dialog","args":["&孟琰\n这怎么回事？"]},{"op":50,"name":"actor_move","args":[0,28,0,19,7,0]},{"op":33,"name":"map_mark","args":[19,8,0,1,0]},{"op":20,"name":"dialog","args":["&牛金\n别小看俺老牛，老牛要用起计来，比那\n诸葛亮还要厉害。\n&孟琰\n这家伙…"]},{"op":0,"name":"end","args":[]},{"op":9,"name":"delay","args":[10]},{"op":20,"name":"dialog","args":["&姜维\n诸位一定要坚守下去，不能被击溃，不然\n后面的大军将会全军覆没。\n&姜维\n可以的话，也请一并保护在前方的孟琰\n将军，他是大汉未来极重要的战力。"]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[1011],[]]},"end":75},{"op":20,"name":"dialog","args":["&姜维\n撑下去就有转机，一定要相信诸葛姑娘的\n计策。"]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":25,"name":"victory_cond_text","args":["胜利条件\n一﹑击退司马懿。\n\n失败条件\n一﹑姜维死亡。\n二﹑回合数超过35。"]},{"op":26,"name":"battle_goal_text","args":["一﹑击退司马懿。"]},{"op":20,"name":"dialog","args":["印绶条件\n一、触发所有单挑和对话。\n二、全灭敌人。"]},{"op":90,"name":"ui_5a","args":[]},{"op":8,"name":"set_result","args":[1]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":14634,"sections":[{"index":0,"offset":14636,"title":"ね瓁北��","conditions":[{"op":2,"name":"comment","args":["ね瓁北��"]},{"op":63,"name":"test_turn","args":[1,0]},{"op":64,"name":"test_side","args":[0]},{"op":0,"name":"end","args":[]}],"body":[{"op":119,"name":"int_var_op","args":[2,0,2,0,7]},{"op":120,"name":"data_transfer","args":[0,1,650,32]},{"op":120,"name":"data_transfer","args":[0,1,30,32]},{"op":120,"name":"data_transfer","args":[0,1,240,32]},{"op":120,"name":"data_transfer","args":[0,1,28,32]},{"op":0,"name":"end","args":[]}]},{"index":1,"offset":14781,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":46,"name":"test_adjacent","args":[0,7,1]},{"op":5,"name":"test_flags","args":[[],[203]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[0,7,65535,0,1,0]},{"op":79,"name":"unit_op_4f","args":[7,0,65535,0,0,1]},{"op":20,"name":"dialog","args":["&夏侯霸\n蜀贼都给我纳命来吧！\n&姜维\n来者究竟是何人？\n&夏侯霸\n夏侯渊之子，夏侯霸！"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["虫珼矪竚"]},"end":76},{"op":104,"name":"duel_setup","args":[0,7,34]},{"op":96,"name":"duel_say","args":[0,"来吧，让我看看蜀贼的实力！",10]},{"op":96,"name":"duel_say","args":[1,"（夏侯渊的儿子到底有多厉害？）",6]},{"op":9,"name":"delay","args":[5]},{"op":97,"name":"duel_end","args":[]},{"op":100,"name":"duel_action","args":[0,2]},{"op":101,"name":"duel_action2","args":[0,1,1]},{"op":101,"name":"duel_action2","args":[0,1,1]},{"op":101,"name":"duel_action2","args":[0,2,1]},{"op":9,"name":"delay","args":[3]},{"op":99,"name":"duel_say2","args":[1,"（好强！果然是名将之子，比起张虎\n二人组要强太多了。）",1]},{"op":99,"name":"duel_say2","args":[0,"杀呀！！！",1]},{"op":100,"name":"duel_action","args":[0,8]},{"op":9,"name":"delay","args":[3]},{"op":100,"name":"duel_action","args":[0,2]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,4,1]},{"op":101,"name":"duel_action2","args":[1,0,0]},{"op":99,"name":"duel_say2","args":[1,"你强归强，但是比起张郃还是差了些。",1]},{"op":99,"name":"duel_say2","args":[0,"哇！",1]},{"op":100,"name":"duel_action","args":[0,1]},{"op":9,"name":"delay","args":[3]},{"op":99,"name":"duel_say2","args":[0,"可恶啊！",1]},{"op":9,"name":"delay","args":[3]},{"op":100,"name":"duel_action","args":[0,8]},{"op":101,"name":"duel_action2","args":[0,4,1]},{"op":101,"name":"duel_action2","args":[1,0,0]},{"op":99,"name":"duel_say2","args":[0,"啊！",1]},{"op":9,"name":"delay","args":[3]},{"op":100,"name":"duel_action","args":[0,1]},{"op":99,"name":"duel_say2","args":[0,"可恶蜀贼！",1]},{"op":101,"name":"duel_action2","args":[0,4,1]},{"op":101,"name":"duel_action2","args":[1,0,0]},{"op":99,"name":"duel_say2","args":[0,"哎呀！",1]},{"op":9,"name":"delay","args":[3]},{"op":100,"name":"duel_action","args":[0,1]},{"op":100,"name":"duel_action","args":[0,4]},{"op":99,"name":"duel_say2","args":[0,"可恶，我不相信！",1]},{"op":100,"name":"duel_action","args":[0,3]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,1]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,2,1]},{"op":100,"name":"duel_action","args":[1,3]},{"op":102,"name":"duel_action3","args":[1,1,0]},{"op":100,"name":"duel_action","args":[1,1]},{"op":102,"name":"duel_action3","args":[1,1,1]},{"op":100,"name":"duel_action","args":[1,1]},{"op":102,"name":"duel_action3","args":[1,1,1]},{"op":100,"name":"duel_action","args":[1,1]},{"op":102,"name":"duel_action3","args":[1,1,0]},{"op":99,"name":"duel_say2","args":[0,"哇啊！",0]},{"op":100,"name":"duel_action","args":[0,11]},{"op":100,"name":"duel_action","args":[0,12]},{"op":99,"name":"duel_say2","args":[0,"可恶！\n为什么没办法帮父亲报仇？",0]},{"op":100,"name":"duel_action","args":[0,1]},{"op":100,"name":"duel_action","args":[0,2]},{"op":100,"name":"duel_action","args":[0,13]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&夏侯霸\n（虽说报仇心切，但若是这样丢了性命也\n划不来。）"]},{"op":49,"name":"actor_select","args":[0,7,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[203,1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":16167,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":46,"name":"test_adjacent","args":[2,72,1]},{"op":5,"name":"test_flags","args":[[],[204]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[2,72,65535,0,1,0]},{"op":79,"name":"unit_op_4f","args":[72,2,65535,0,0,1]},{"op":20,"name":"dialog","args":["&杨兰\n老娘今天心情非常不好，就找你开刀。\n&杨兰\n（想到诸葛果那冷漠的态度就很火，\n那女人不知道亲人的可贵？）\n&杨兰\n（真是的，心情烦躁得要命，胸口也\n感觉好难受，这种心情从来没有过。）\n&夏侯威\n我？\n&杨兰\n就是你，看你这副呆样就一肚子火。"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":[""]},"end":35},{"op":104,"name":"duel_setup","args":[2,72,34]},{"op":96,"name":"duel_say","args":[1,"算你倒楣，碰到老娘心情不好的时候！",9]},{"op":96,"name":"duel_say","args":[0,"笑死人了，我好歹也是夏侯渊之子，\n你以为你真的打得过我？",6]},{"op":97,"name":"duel_end","args":[]},{"op":100,"name":"duel_action","args":[1,2]},{"op":100,"name":"duel_action","args":[1,8]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,3,1]},{"op":99,"name":"duel_say2","args":[0,"（什么！？\n一个女子竟然有这么强大的臂力！）",1]},{"op":100,"name":"duel_action","args":[1,2]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,1]},{"op":101,"name":"duel_action2","args":[1,4,1]},{"op":99,"name":"duel_say2","args":[1,"真弱！完全不堪一击！",1]},{"op":100,"name":"duel_action","args":[1,1]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,0,1]},{"op":9,"name":"delay","args":[10]},{"op":100,"name":"duel_action","args":[0,12]},{"op":99,"name":"duel_say2","args":[0,"（这女人像是疯了一样，我碰到这疯女人\n还真是倒楣。）",1]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&杨兰\n我还没打够，怎么就跑了？\n&夏侯威\n碰到这疯婆子，几条命都不够。"]},{"op":49,"name":"actor_select","args":[0,72,0,0,0,0,0]},{"op":20,"name":"dialog","args":["&杨兰\n稍微发泄了一下。"]},{"op":61,"name":"get_item","args":[98,0,1,2]},{"op":11,"name":"set_flag","args":[204,1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":17241,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":63,"name":"test_turn","args":[5,2]},{"op":5,"name":"test_flags","args":[[],[205]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&司马懿\n后备队继续进攻，务必要歼灭贼军。\n&张虎\n好，终于换我们出动了。\n&乐綝\n总不能功劳都让夏侯兄弟抢走。\n&戴陵\n两位将军别急，不然中了贼军的陷阱就\n糟了。\n&乐綝\n你还真是胆小如鼠，诸葛亮都死了还有\n陷阱？\n&张虎\n以我张虎的实力，以一挡百，足以威震\n五丈原，让蜀人小孩半夜都不敢啼哭。\n&戴陵\n（张辽将军和乐进将军，求求你们看看\n那不成才的儿子们吧。）"]},{"op":78,"name":"unit_op_4e","args":[1,65535,0,12,12,14,2,3,0,0,0]},{"op":11,"name":"set_flag","args":[205,1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":17693,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":63,"name":"test_turn","args":[6,2]},{"op":5,"name":"test_flags","args":[[],[206]]},{"op":0,"name":"end","args":[]}],"body":[{"op":76,"name":"unit_op_4c","args":[0,650,0]},{"op":76,"name":"unit_op_4c","args":[0,30,0]},{"op":76,"name":"unit_op_4c","args":[0,240,0]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&王平\n伯约有难，我王平怎么可能袖手旁观。\n&姜维\n子均为什么还要身赴险地？明明可以顺利\n撤退的。\n&王平\n当时街亭常败军率军来救，我若不回报就\n比畜生还不如了。"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&吴班\n就让我也来参加这场战斗。\n&句扶\n吴班你…\n&吴班\n在夷陵之战我也是断后高手，不让我参加\n这场会战实在是太可惜了。\n&吴班\n还有…你不要死了。\n&句扶\n哼，在你死之前我是不会死的。"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&陈式\n…（点头）\n&柳隐\n陈将军还是这样惜字如金。\n&陈式\n要活下去…\n&柳隐\n咦？！"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&姜维\n（援军仍看不到魏延将军的身影，莫非\n真的如诸葛果说的，已经脱离我军了？）"]},{"op":11,"name":"set_flag","args":[206,1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":18321,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":63,"name":"test_turn","args":[8,2]},{"op":5,"name":"test_flags","args":[[],[207]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&司马懿\n现在全军出击，投入所有的兵力把贼军\n粉碎！\n&秦朗\n我现在不想出击也不行吗？\n&胡遵\n拜托你拿出点骨气来好不好？\n&郭淮\n大将军号令已下，我们也跟著进攻吧。\n&费曜\n乌龟王司马懿居然肯出击，看来他是很有\n把握了。\n&鲁芝\n但总觉得怪怪的。"]},{"op":78,"name":"unit_op_4e","args":[1,65535,0,0,31,31,2,3,0,0,0]},{"op":11,"name":"set_flag","args":[207,1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":18662,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":63,"name":"test_turn","args":[12,2]},{"op":5,"name":"test_flags","args":[[1011],[208]]},{"op":0,"name":"end","args":[]}],"body":[{"op":76,"name":"unit_op_4c","args":[0,61,0]},{"op":36,"name":"play_sound","args":[112]},{"op":20,"name":"dialog","args":["&诸葛亮\n呵呵呵，亮就知道这招可以引你上勾。\n&司马懿\n不会吧？！诸葛亮居然没有死？没想到你\n居然会拿自己的生死做为诱饵。\n&诸葛亮\n不这样怎么诱得出你这奸诈的老狐狸？\n&司马懿\n快退！快退！我们中计了！糟了，部队\n开始不听使唤了。"]},{"op":78,"name":"unit_op_4e","args":[1,65535,0,0,31,31,2,6,65535,1,1]},{"op":77,"name":"unit_op_4d","args":[2,65535,0,0,0,31,31,2,1,0,8,0,0]},{"op":20,"name":"dialog","args":["&姜维\n（这就是诸葛姑娘的奇计吗？只是司马懿\n为什么远远看见假丞相就落荒而逃？）\n&姜维\n（我懂了，之前我看到的另一个丞相身影\n就是诸葛姑娘。）\n&姜维\n（她刻意用丞相的打扮给对方看见，所以\n司马懿印象中的丞相其实是诸葛姑娘。）"]},{"op":11,"name":"set_flag","args":[208,1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":19307,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":37,"name":"test_unit_at","args":[1025,6,19]},{"op":5,"name":"test_flags","args":[[],[214]]},{"op":0,"name":"end","args":[]}],"body":[{"op":61,"name":"get_item","args":[90,65535,1,1025]},{"op":11,"name":"set_flag","args":[214,1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":19380,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":37,"name":"test_unit_at","args":[1025,3,11]},{"op":5,"name":"test_flags","args":[[],[215]]},{"op":0,"name":"end","args":[]}],"body":[{"op":61,"name":"get_item","args":[88,65535,1,1025]},{"op":11,"name":"set_flag","args":[215,1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":19453,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":37,"name":"test_unit_at","args":[1025,3,6]},{"op":5,"name":"test_flags","args":[[],[216]]},{"op":0,"name":"end","args":[]}],"body":[{"op":61,"name":"get_item","args":[88,65535,1,1025]},{"op":11,"name":"set_flag","args":[216,1]},{"op":0,"name":"end","args":[]}]},{"index":10,"offset":19526,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":37,"name":"test_unit_at","args":[1025,6,7]},{"op":5,"name":"test_flags","args":[[],[217]]},{"op":0,"name":"end","args":[]}],"body":[{"op":61,"name":"get_item","args":[88,65535,1,1025]},{"op":11,"name":"set_flag","args":[217,1]},{"op":0,"name":"end","args":[]}]},{"index":11,"offset":19599,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":37,"name":"test_unit_at","args":[1025,6,8]},{"op":5,"name":"test_flags","args":[[],[218]]},{"op":0,"name":"end","args":[]}],"body":[{"op":61,"name":"get_item","args":[90,65535,1,1025]},{"op":11,"name":"set_flag","args":[218,1]},{"op":0,"name":"end","args":[]}]},{"index":12,"offset":19672,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":37,"name":"test_unit_at","args":[1025,28,14]},{"op":5,"name":"test_flags","args":[[],[220]]},{"op":0,"name":"end","args":[]}],"body":[{"op":61,"name":"get_item","args":[88,65535,1,1025]},{"op":11,"name":"set_flag","args":[220,1]},{"op":0,"name":"end","args":[]}]},{"index":13,"offset":19745,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":37,"name":"test_unit_at","args":[1025,27,12]},{"op":5,"name":"test_flags","args":[[],[221]]},{"op":0,"name":"end","args":[]}],"body":[{"op":61,"name":"get_item","args":[94,65535,1,1025]},{"op":11,"name":"set_flag","args":[221,1]},{"op":0,"name":"end","args":[]}]},{"index":14,"offset":19818,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":46,"name":"test_adjacent","args":[4,146,1]},{"op":5,"name":"test_flags","args":[[],[209]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[4,146,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[146,4,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&胡遵\n之前虽然打败过匈奴人，但是面对蜀人\n还是第一次。\n&句扶\n好像是个厉害角色！"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["虫珼矪竚"]},"end":48},{"op":104,"name":"duel_setup","args":[4,146,34]},{"op":96,"name":"duel_say","args":[1,"敌将报上名来！",9]},{"op":96,"name":"duel_say","args":[0,"安定胡遵！",0]},{"op":97,"name":"duel_end","args":[]},{"op":100,"name":"duel_action","args":[0,2]},{"op":99,"name":"duel_say2","args":[0,"看招～！",0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":9,"name":"delay","args":[10]},{"op":99,"name":"duel_say2","args":[0,"哦～？躲过我一枪……！\n再看这招！",1]},{"op":101,"name":"duel_action2","args":[0,2,1]},{"op":9,"name":"delay","args":[5]},{"op":100,"name":"duel_action","args":[1,10]},{"op":99,"name":"duel_say2","args":[1,"你别猖狂！这回看我的了！",1]},{"op":100,"name":"duel_action","args":[1,2]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":99,"name":"duel_say2","args":[0,"好强，快招架不住了！",0]},{"op":102,"name":"duel_action3","args":[1,0,0]},{"op":101,"name":"duel_action2","args":[1,0,1]},{"op":101,"name":"duel_action2","args":[0,0,0]},{"op":9,"name":"delay","args":[5]},{"op":99,"name":"duel_say2","args":[1,"唔～！\n",1]},{"op":9,"name":"delay","args":[10]},{"op":99,"name":"duel_say2","args":[0,"太大意了吧，这就是胡家同归枪！\n只差一点就要你命了。",1]},{"op":99,"name":"duel_say2","args":[1,"（和姜维那时候的舍身攻击很像，不\n过这人却都是用这招来战斗，真是疯\n子。）",1]},{"op":102,"name":"duel_action3","args":[0,0,0]},{"op":102,"name":"duel_action3","args":[0,0,0]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[1,1,0]},{"op":99,"name":"duel_say2","args":[0,"哇啊～！",1]},{"op":99,"name":"duel_say2","args":[1,"舍身攻击你以为就只有你会？",1]},{"op":9,"name":"delay","args":[10]},{"op":100,"name":"duel_action","args":[1,1]},{"op":100,"name":"duel_action","args":[0,12]},{"op":99,"name":"duel_say2","args":[0,"蜀人战斗力之强，今日一见果然\n名不虚传。",1]},{"op":100,"name":"duel_action","args":[0,2]},{"op":100,"name":"duel_action","args":[0,2]},{"op":100,"name":"duel_action","args":[0,3]},{"op":100,"name":"duel_action","args":[0,13]},{"op":9,"name":"delay","args":[10]},{"op":99,"name":"duel_say2","args":[1,"这人还真厉害，曹贼阵营真是什么样\n的人都有。",1]},{"op":9,"name":"delay","args":[5]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":11,"name":"set_flag","args":[209,1]},{"op":20,"name":"dialog","args":["&胡遵\n果然厉害，看来胡家同归枪还是有它的\n弱点…\n&胡遵\n我得加紧改良这招，期望将来烈儿和奋儿\n能发挥得比我更好。"]},{"op":49,"name":"actor_select","args":[0,146,0,0,0,0,6]},{"op":61,"name":"get_item","args":[100,0,1,4]},{"op":0,"name":"end","args":[]}]},{"index":15,"offset":21035,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":46,"name":"test_adjacent","args":[0,28,1]},{"op":5,"name":"test_flags","args":[[],[100]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[0,28,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[28,0,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&孟琰\n魏贼！还没完！只要老子在一天，你们\n就别想跨过渭水南岸。\n&姜维\n孟将军…够了，撤退吧…\n&孟琰\n丞相真的过世了吗？\n&姜维\n是的，是我亲眼所见。\n&孟琰\n这样…丞相他…\n&姜维\n请孟将军保重自己，现在就算杀再多敌人\n，也无法改变丞相过世的事实。\n&孟琰\n丞相不在，老子活著又有什么意义？\n&姜维\n听我说！丞相故去，但丞相的梦想仍在。\n&姜维\n我们该做的，应该是想办法保全自己，\n在日后才有机会实现丞相的梦想。\n&孟琰\n你说得是，这就撤退吧。\n&孟琰\n老子期待看你实现丞相的梦想。\n&姜维\n孟将军…"]},{"op":11,"name":"set_flag","args":[100,1]},{"op":0,"name":"end","args":[]}]},{"index":16,"offset":21611,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":46,"name":"test_adjacent","args":[0,80,1]},{"op":5,"name":"test_flags","args":[[],[210]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[0,80,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[80,0,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&郭淮\n想不到负责蜀军断后工作的会是伯约。\n&郭淮\n看来你越来越受重用，距离我们约定的\n大军对决之日不远了。\n&姜维\n伯济，真的很遗憾…我们无法共事。\n&郭淮\n不，已经发生的事情就算了，或许在蜀地\n你才能真正发挥才能吧。\n&姜维\n我真的很感谢伯济你。如果不是你的提拔\n，恐怕我还是没没无闻的小吏。"]},{"op":20,"name":"dialog","args":["&郭淮\n客气了，请让我向你这伟大的对手致意。"]},{"op":80,"name":"unit_status","args":[80,2,1,1]},{"op":20,"name":"dialog","args":["&姜维\n也请让我向你这位伟大的对手致意。"]},{"op":80,"name":"unit_status","args":[0,2,1,1]},{"op":11,"name":"set_flag","args":[210,1]},{"op":0,"name":"end","args":[]}]},{"index":17,"offset":22124,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":46,"name":"test_adjacent","args":[2,801,1]},{"op":5,"name":"test_flags","args":[[],[211]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[2,801,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[801,2,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&鲁芝\n姑娘，没想到我们又见面了…\n&杨兰\n问你个问题，如果自己的亲人过世，\n照理说应该会非常悲伤吧。\n&杨兰\n如果说一个人完全没有悲伤的表现，\n那么这个人是否是没有感情的禽兽？\n&鲁芝\n其实这不一定…\n&鲁芝\n人有许多时候，就算是悲伤到极点，也会\n因为某种理由而压抑自己悲伤的心情。\n&鲁芝\n在我五岁的时候，郭汜当著我面杀掉了\n父亲。\n&鲁芝\n如果我当时哭出声的话，只怕根本活不到\n现在。\n&杨兰\n嗯…原来如此，或许你说的有道理吧，\n这样我可以释怀了。\n&鲁芝\n请恕在下多嘴一句，我不认为姑娘你\n心情不好是因为这个原因。\n&鲁芝\n你得正视自己的心情，要是再继续搞不\n清楚的话，只怕会被别人捷足先登。\n&杨兰\n咦？原来如此，到最后我在意的是诸葛果\n本人吗…谢谢你了。\n&鲁芝\n呵呵，不客气…咦？我在干嘛？！"]},{"op":11,"name":"set_flag","args":[211,1]},{"op":0,"name":"end","args":[]}]},{"index":18,"offset":22894,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":46,"name":"test_adjacent","args":[0,93,1]},{"op":5,"name":"test_flags","args":[[],[212]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[0,93,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[93,0,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&姜维\n这位大将莫非就是司马懿？\n&司马懿\n不错，我就是大魏大将军司马懿。\n&姜维\n我还以为你只会龟在那边不出来。\n&司马懿\n赢得难看总比输了好，忍到最后的人就会\n胜利，这就是我的生存之道。"]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[620],[]]},"end":6},{"op":20,"name":"dialog","args":["&司马懿\n你就是姜维对吧…真想不到蜀军居然敢让\n一个降将来担任殿后工作。诸葛亮在用人\n方面居然如此大胆。\n&司马懿\n蜀地可以提供给你的东西，比起大魏可说\n是微乎其微。到底诸葛亮施了什么魔法\n，可以让你对他如此死心塌地？\n&姜维\n这是知遇之恩！因为丞相的提拔我才有\n今天，才能在这里和你们对抗。\n&司马懿\n我无法理解，我完全无法理解…\n&司马懿\n当年我和诸葛亮对话，我不懂他为什么要\n对刘备如此死心塌地。现在我也不懂你\n为什么要对诸葛亮如此忠心。\n&姜维\n这就是你和丞相不同的地方，丞相的人品\n比你高洁太多了！\n&司马懿\n又一个蠢才！又一个浪费自己才能的\n呆子！"]},{"op":0,"name":"end","args":[]},{"op":11,"name":"set_flag","args":[212,1]},{"op":0,"name":"end","args":[]}]},{"index":19,"offset":23734,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":46,"name":"test_adjacent","args":[3,81,1]},{"op":5,"name":"test_flags","args":[[209],[213]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[3,81,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[81,3,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&柳隐\n前面的大将，和我单挑如何？\n&秦朗\n笑…笑话…我堂堂大魏征蜀护军为什么要\n和你单挑。胡遵！\n&柳隐\n那个叫胡遵的已经被杀退了。\n&秦朗\n我…我…我手痛。对，手痛，若不是因为\n手痛你就死定了。"]},{"op":9,"name":"delay","args":[5]},{"op":80,"name":"unit_status","args":[3,6,1,0]},{"op":80,"name":"unit_status","args":[81,3,0,0]},{"op":35,"name":"play_music","args":[35,1]},{"op":9,"name":"delay","args":[5]},{"op":80,"name":"unit_status","args":[81,9,1,1]},{"op":20,"name":"dialog","args":["&秦朗\n你怎么一声不吭就射我？\n&柳隐\n不甘心就过来呀。\n&秦朗\n哼…昔日韩信能忍胯下之辱，这点\n又算什么。\n（痛死了，快跑啊。）"]},{"op":49,"name":"actor_select","args":[0,81,0,0,0,0,6]},{"op":20,"name":"dialog","args":["&柳隐\n这样的人是征蜀护军？难道我们大汉就\n这么被看轻？"]},{"op":61,"name":"get_item","args":[102,0,1,3]},{"op":11,"name":"set_flag","args":[213,1]},{"op":0,"name":"end","args":[]}]},{"index":20,"offset":24350,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":54,"name":"test_attr","args":[3,7,0,2]},{"op":5,"name":"test_flags","args":[[],[222]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&柳隐\n败战乃兵家常事。"]},{"op":49,"name":"actor_select","args":[0,3,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[222,1]},{"op":0,"name":"end","args":[]}]},{"index":21,"offset":24480,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[4,7,0,2]},{"op":5,"name":"test_flags","args":[[],[223]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&句扶\n纵然战败，其心不败。"]},{"op":49,"name":"actor_select","args":[0,4,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[223,1]},{"op":0,"name":"end","args":[]}]},{"index":22,"offset":24606,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[2,7,0,2]},{"op":5,"name":"test_flags","args":[[],[224]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&杨兰\n爱的战士绝不轻易倒下！"]},{"op":49,"name":"actor_select","args":[0,2,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[224,1]},{"op":0,"name":"end","args":[]}]},{"index":23,"offset":24734,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[5,7,0,2]},{"op":5,"name":"test_flags","args":[[],[225]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&宁随\n我越来越懂得生存的意义了。"]},{"op":49,"name":"actor_select","args":[0,5,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[225,1]},{"op":0,"name":"end","args":[]}]},{"index":24,"offset":24866,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[650,7,0,2]},{"op":5,"name":"test_flags","args":[[],[226]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&王平\n该退就退，王子均绝不恋战。"]},{"op":49,"name":"actor_select","args":[0,650,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[226,1]},{"op":0,"name":"end","args":[]}]},{"index":25,"offset":24998,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[80,7,0,2]},{"op":5,"name":"test_flags","args":[[],[227]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&郭淮\n伯约，希望今后是你我的时代。"]},{"op":49,"name":"actor_select","args":[0,80,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[227,1]},{"op":0,"name":"end","args":[]}]},{"index":26,"offset":25132,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[801,7,0,2]},{"op":5,"name":"test_flags","args":[[],[228]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&鲁芝\n当好人当越爽，我到底是怎么回事？"]},{"op":49,"name":"actor_select","args":[0,801,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[228,1]},{"op":0,"name":"end","args":[]}]},{"index":27,"offset":25270,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[83,7,0,2]},{"op":5,"name":"test_flags","args":[[],[229]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&费曜\n乌龟大将军司马懿，今后我不会再为你\n效力了。"]},{"op":49,"name":"actor_select","args":[0,83,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[229,1]},{"op":0,"name":"end","args":[]}]},{"index":28,"offset":25419,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[30,7,0,2]},{"op":5,"name":"test_flags","args":[[],[230]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&吴班\n居然能把我打败？！敌人真是卧虎藏龙。"]},{"op":49,"name":"actor_select","args":[0,30,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[230,1]},{"op":0,"name":"end","args":[]}]},{"index":29,"offset":25561,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[18,7,0,2]},{"op":5,"name":"test_flags","args":[[],[231]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&赵统\n我还是及不上父亲的一半。"]},{"op":49,"name":"actor_select","args":[0,18,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[231,1]},{"op":0,"name":"end","args":[]}]},{"index":30,"offset":25691,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[19,7,0,2]},{"op":5,"name":"test_flags","args":[[],[232]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&赵广\n看来走自己的路也不太容易。"]},{"op":49,"name":"actor_select","args":[0,19,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[232,1]},{"op":0,"name":"end","args":[]}]},{"index":31,"offset":25823,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[86,7,0,2]},{"op":5,"name":"test_flags","args":[[],[233]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&张虎\n都是乐綝那个白痴误事。"]},{"op":49,"name":"actor_select","args":[0,86,0,