rgs":[[1049],[]]},"end":47},{"op":77,"name":"unit_op_4d","args":[0,190,0,0,0,0,0,6,0,0,65535,0,0]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&张嶷\n好像激起对方的敌对心了。"]},{"op":61,"name":"get_item","args":[99,0,1,22]},{"op":11,"name":"set_flag","args":[14,1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":18212,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":37,"name":"test_unit_at","args":[1025,10,32]},{"op":5,"name":"test_flags","args":[[],[21]]},{"op":0,"name":"end","args":[]}],"body":[{"op":61,"name":"get_item","args":[96,65535,1,1025]},{"op":11,"name":"set_flag","args":[21,1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":18293,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":37,"name":"test_unit_at","args":[1025,12,8]},{"op":5,"name":"test_flags","args":[[],[26]]},{"op":0,"name":"end","args":[]}],"body":[{"op":61,"name":"get_item","args":[95,65535,1,1025]},{"op":20,"name":"dialog","args":["&孟琰\n好，攻下敌人本营了。"]},{"op":77,"name":"unit_op_4d","args":[2,65535,0,0,0,23,39,2,65535,65535,10,0,0]},{"op":11,"name":"set_flag","args":[26,1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":18473,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":37,"name":"test_unit_at","args":[1025,13,8]},{"op":5,"name":"test_flags","args":[[],[25]]},{"op":0,"name":"end","args":[]}],"body":[{"op":61,"name":"get_item","args":[94,65535,1,1025]},{"op":11,"name":"set_flag","args":[25,1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":18554,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":37,"name":"test_unit_at","args":[1025,11,32]},{"op":5,"name":"test_flags","args":[[],[22]]},{"op":0,"name":"end","args":[]}],"body":[{"op":61,"name":"get_item","args":[89,65535,1,1025]},{"op":11,"name":"set_flag","args":[22,1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":18635,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":37,"name":"test_unit_at","args":[1025,11,33]},{"op":5,"name":"test_flags","args":[[],[23]]},{"op":0,"name":"end","args":[]}],"body":[{"op":61,"name":"get_item","args":[102,65535,1,1025]},{"op":11,"name":"set_flag","args":[23,1]},{"op":0,"name":"end","args":[]}]},{"index":10,"offset":18716,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":37,"name":"test_unit_at","args":[1025,10,33]},{"op":5,"name":"test_flags","args":[[],[20]]},{"op":0,"name":"end","args":[]}],"body":[{"op":61,"name":"get_item","args":[91,65535,1,1025]},{"op":11,"name":"set_flag","args":[20,1]},{"op":0,"name":"end","args":[]}]},{"index":11,"offset":18797,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[16,28,1]},{"op":5,"name":"test_flags","args":[[],[40]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[16,28,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[28,16,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&关索\n唉呀，孟大哥好。\n&孟琰\n好个鸟，老子没话跟你说的啦。\n&关索\n怎么这些年没见，你说话越来越粗俗了？\n&孟琰\n你还好意思说？你怎么对花鬘的，居然\n在大婚那天逃跑？还和皇后勾勾搭搭。\n&关索\n这是误会呀，我只是想要稍微晚一点点\n结婚而已。\n&孟琰\n你信不信我会把你丢在三江城的象群中？"]},{"op":11,"name":"set_flag","args":[40,1]},{"op":0,"name":"end","args":[]}]},{"index":12,"offset":19184,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[13,584,1]},{"op":5,"name":"test_flags","args":[[16],[41]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[13,584,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[584,13,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&霍弋\n败给我这南中马屁精感觉如何？\n哈哈哈，我是新一代战神呀。\n&陶璜\n在下确实敬佩你的作战能力。\n&霍弋\n哦，你这敌将还挺有风度的。\n&陶璜\n骗你的，输给你这种没品又懒惰的混帐，\n是我此生最大的耻辱。\n&霍弋\n到底哪句才是你的真心话？"]},{"op":11,"name":"set_flag","args":[41,1]},{"op":0,"name":"end","args":[]}]},{"index":13,"offset":19524,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[13,28,1]},{"op":5,"name":"test_flags","args":[[],[42]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[13,28,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[28,13,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&霍弋\n孟将军，关于这次新的赌场工程，可以\n稍微给点方便吗？\n&孟琰\n你把我们这边搞成特种行业林立的地方\n，我还没找你算帐呢！\n&霍弋\n您不觉得南中大族们因为这些赌场和\n妓院变得富足多了？\n&孟琰\n不行，说不准就不准。\n&霍弋\n这样好了，我们这进了新的小姐，就\n免费让孟将军挑选几个带回去吧。\n&孟琰\n你当我是什么人？\n&霍弋\n我记得好像有个小姐长得挺像孟姑娘喔…\n&孟琰\n你这混蛋…"]},{"op":11,"name":"set_flag","args":[42,1]},{"op":0,"name":"end","args":[]}]},{"index":14,"offset":19997,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[20,28,1]},{"op":5,"name":"test_flags","args":[[],[43]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[20,28,65535,65535,0,1]},{"op":79,"name":"unit_op_4f","args":[28,20,65535,65535,1,0]},{"op":20,"name":"dialog","args":["&孟琰\n要是早知道关索是那种货色，我才不会\n让你跟他在一起。\n&花鬘\n确实关索是个好色、懦弱、爱说谎、好赌\n、没责任感、上厕所不洗手的烂男人。\n&花鬘\n但…\n&孟琰\n够了，我已经很明白了。"]},{"op":11,"name":"set_flag","args":[43,1]},{"op":0,"name":"end","args":[]}]},{"index":15,"offset":20288,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[11,234,1]},{"op":5,"name":"test_flags","args":[[],[44]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[11,234,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[234,11,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&刘敏\n来跟我单挑吧。\n&虞汜\n别开玩笑了，炮车怎么单挑？\n&刘敏\n没试过怎么知道，人的一生总是需要尝试\n，就像是你出生时尝试呼吸，婴儿时候要\n尝试走路…\n&虞汜\n够了够了，真是啰嗦死了，跟你单挑\n就是。"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["虫珼矪竚"]},"end":35},{"op":104,"name":"duel_setup","args":[11,234,18]},{"op":96,"name":"duel_say","args":[1,"这样单挑吧，\n发出信号的同时就放炮！",0]},{"op":96,"name":"duel_say","args":[0,"比打炮我可不输人！",0]},{"op":97,"name":"duel_end","args":[]},{"op":100,"name":"duel_action","args":[1,1]},{"op":100,"name":"duel_action","args":[1,2]},{"op":100,"name":"duel_action","args":[0,1]},{"op":100,"name":"duel_action","args":[0,2]},{"op":9,"name":"delay","args":[5]},{"op":100,"name":"duel_action","args":[1,1]},{"op":100,"name":"duel_action","args":[0,1]},{"op":9,"name":"delay","args":[20]},{"op":100,"name":"duel_action","args":[1,8]},{"op":99,"name":"duel_say2","args":[1,"接招吧！",1]},{"op":9,"name":"delay","args":[5]},{"op":100,"name":"duel_action","args":[0,8]},{"op":99,"name":"duel_say2","args":[0,"来吧！",1]},{"op":9,"name":"delay","args":[5]},{"op":100,"name":"duel_action","args":[1,9]},{"op":100,"name":"duel_action","args":[0,9]},{"op":9,"name":"delay","args":[15]},{"op":100,"name":"duel_action","args":[0,11]},{"op":99,"name":"duel_say2","args":[0,"唉呦！",1]},{"op":100,"name":"duel_action","args":[0,12]},{"op":9,"name":"delay","args":[10]},{"op":100,"name":"duel_action","args":[1,3]},{"op":9,"name":"delay","args":[10]},{"op":99,"name":"duel_say2","args":[1,"怎么样，现在看看谁是炮神？",1]},{"op":9,"name":"delay","args":[5]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&虞汜\n真是乱七八糟的单挑。\n&刘敏\n看到没，炮车队也可以单挑的。\n哈哈哈，我帮天下的炮车队争了一口气。\n&虞汜\n没空跟你这疯子瞎搅和了。\n&虞汜\n（这下可真完了，交州双方人数平分秋色\n，我军都输成这样，等到真的开打，我们\n哪来的胜算？）"]},{"op":49,"name":"actor_select","args":[0,234,0,0,0,0,6]},{"op":61,"name":"get_item","args":[101,0,1,11]},{"op":11,"name":"set_flag","args":[44,1]},{"op":0,"name":"end","args":[]}]},{"index":16,"offset":21287,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[13,251,1]},{"op":5,"name":"test_flags","args":[[],[45]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[13,251,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[251,13,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&霍弋\n毛炅，上次你欠我的赌债打算什么时候\n还？"]},{"op":20,"name":"dialog","args":["&毛炅\n霍将军，这你就不厚道了。难道刘俊和\n修则的人头还不够吗？"]},{"op":20,"name":"dialog","args":["&霍弋\n小子，难道你不知道什么叫利滚利吗？"]},{"op":20,"name":"dialog","args":["&毛炅\n那这样吧，霍将军。等打下了交州，你\n让我当交趾太守，不出三年我一定把钱\n还清，行吗？"]},{"op":11,"name":"set_flag","args":[45,1]},{"op":0,"name":"end","args":[]}]},{"index":17,"offset":21652,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[251,584,1]},{"op":5,"name":"test_flags","args":[[],[46]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[251,584,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[584,251,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&陶璜\n你就是之前砍死刘俊和修则的人？"]},{"op":20,"name":"dialog","args":["&毛炅\n正是！你要和我过过招吗？"]},{"op":20,"name":"dialog","args":["&陶璜\n求之不得…骗你的…我才不和你打！"]},{"op":20,"name":"dialog","args":["&毛炅\n搞什么？"]},{"op":20,"name":"dialog","args":["&陶璜\n我知道我打不过你，所以干脆认输好了。\n骗你的…在另外一条故事线，我一定会\n干掉你！"]},{"op":11,"name":"set_flag","args":[46,1]},{"op":0,"name":"end","args":[]}]},{"index":18,"offset":21992,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[11,7,0,2]},{"op":5,"name":"test_flags","args":[[],[230]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&刘敏\n所谓的战败有分很多种，有谓先胜后败，\n也有先败后胜，也有胜败交错，也有不胜\n不败…（继续啰唆）"]},{"op":49,"name":"actor_select","args":[0,11,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[230,1]},{"op":0,"name":"end","args":[]}]},{"index":19,"offset":22190,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[234,7,0,2]},{"op":5,"name":"test_flags","args":[[],[162]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&虞汜\n这仗怎么打得下去，双方实力差太多了。"]},{"op":49,"name":"actor_select","args":[0,234,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[162,1]},{"op":0,"name":"end","args":[]}]},{"index":20,"offset":22332,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[584,7,0,2]},{"op":5,"name":"test_flags","args":[[],[52]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&陶璜\n武将的本愿就是战死沙场…骗你的，保命\n才是最重要。"]},{"op":49,"name":"actor_select","args":[0,584,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[52,1]},{"op":0,"name":"end","args":[]}]},{"index":21,"offset":22487,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[725,7,0,2]},{"op":5,"name":"test_flags","args":[[],[63]]},{"op":0,"name":"end","args":[]}],"body":[{"op":80,"name":"unit_status","args":[725,9,0,1]},{"op":20,"name":"dialog","args":["&薛珝\n我居然会死在这种地方？真是不甘心。\n&薛珝\n老弟呀，你去劝劝陛下，这仗根本就\n打不下去呀！"]},{"op":83,"name":"unit_op_53","args":[0,725,0,0,0,0,6,1]},{"op":11,"name":"set_flag","args":[63,1]},{"op":0,"name":"end","args":[]}]},{"index":22,"offset":22701,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[190,7,0,2]},{"op":5,"name":"test_flags","args":[[],[68]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&沈莹\n丹阳青巾会败？这是不可能的！"]},{"op":49,"name":"actor_select","args":[0,190,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[68,1]},{"op":0,"name":"end","args":[]}]},{"index":23,"offset":22835,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[20,7,0,2]},{"op":5,"name":"test_flags","args":[[],[202]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&花鬘\n我可不是因为帮你才弄到撤退的啦。"]},{"op":49,"name":"actor_select","args":[0,20,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[202,1]},{"op":0,"name":"end","args":[]}]},{"index":24,"offset":22973,"title":"篗癶","conditions":[{"op":2,"name":"comment","args":["篗癶"]},{"op":54,"name":"test_attr","args":[28,7,0,2]},{"op":5,"name":"test_flags","args":[[],[88]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&孟琰\n老子怎么会在这种地方战死……"]},{"op":83,"name":"unit_op_53","args":[0,28,0,0,0,0,6,1]},{"op":73,"name":"ui_49","args":[]},{"op":14,"name":"ui_0e","args":[]},{"op":11,"name":"set_flag","args":[88,1]},{"op":0,"name":"end","args":[]}]},{