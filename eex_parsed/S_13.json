ame":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":101,"name":"duel_action2","args":[0,3,0]},{"op":99,"name":"duel_say2","args":[0,"糟了！这人哪里像文官？",1]},{"op":100,"name":"duel_action","args":[0,2]},{"op":101,"name":"duel_action2","args":[1,2,1]},{"op":100,"name":"duel_action","args":[0,12]},{"op":9,"name":"delay","args":[5]},{"op":100,"name":"duel_action","args":[1,8]},{"op":99,"name":"duel_say2","args":[1,"去死吧！十二王方牌大车轮！",1]},{"op":100,"name":"duel_action","args":[1,2]},{"op":102,"name":"duel_action3","args":[1,1,0]},{"op":9,"name":"delay","args":[10]},{"op":100,"name":"duel_action","args":[0,11]},{"op":9,"name":"delay","args":[15]},{"op":99,"name":"duel_say2","args":[0,"悔恨莫及…",1]},{"op":35,"name":"play_music","args":[38,1]},{"op":98,"name":"duel_62","args":[1]},{"op":100,"name":"duel_action","args":[1,1]},{"op":9,"name":"delay","args":[5]},{"op":100,"name":"duel_action","args":[1,10]},{"op":100,"name":"duel_action","args":[1,6]},{"op":9,"name":"delay","args":[5]},{"op":99,"name":"duel_say2","args":[1,"张翼斩杀曹贼南安太守游奕！",1]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&游奕\n天下怎么会有这么厉害的尚书？\n&张翼\n没常识…武官挂文官职还不是到处都有。\n吕布当年在丁原手下也是个文官。"]},{"op":83,"name":"unit_op_53","args":[0,255,0,0,0,0,65535,1]},{"op":61,"name":"get_item","args":[101,0,1,15]},{"op":11,"name":"set_flag","args":[43,1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":14694,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":65,"name":"test_units_in_area","args":[2,0,2,0,5,13,19,27]},{"op":5,"name":"test_flags","args":[[],[11]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&廖化\n清掉了第一批敌人，现在就埋伏起来等\n第二批吧！\n&张翼\n呵呵，这场战争还真是比想像中要容易。\n&廖化\n不过…我们动作还是得快点，不然郭淮的\n援军先到就不妙了。\n&张翼\n元俭，你也算到郭淮的军队会被引出来？\n&廖化\n那是自然的，郭淮部队不可能对部下\n见死不救。\n&廖化\n只是，这样就稍稍对不起在我们后面的\n姜维了，哈哈哈…"]},{"op":49,"name":"actor_select","args":[0,17,0,0,0,0,6]},{"op":49,"name":"actor_select","args":[0,15,0,0,0,0,6]},{"op":9,"name":"delay","args":[5]},{"op":76,"name":"unit_op_4c","args":[0,255,0]},{"op":76,"name":"unit_op_4c","args":[0,282,0]},{"op":76,"name":"unit_op_4c","args":[0,283,0]},{"op":76,"name":"unit_op_4c","args":[0,284,0]},{"op":76,"name":"unit_op_4c","args":[0,285,0]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&游奕\n咦？王赟那家伙死到哪去了？该不会失约\n了吧。\n&弓兵2\n前面好像完全没有人的样子。\n&游奕\n随我去看看！"]},{"op":9,"name":"delay","args":[5]},{"op":50,"name":"actor_move","args":[0,255,0,9,7,2]},{"op":50,"name":"actor_move","args":[0,282,0,8,8,2]},{"op":50,"name":"actor_move","args":[0,283,0,9,8,2]},{"op":50,"name":"actor_move","args":[0,284,0,10,8,2]},{"op":50,"name":"actor_move","args":[0,285,0,11,8,2]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&游奕\n这里就是阴平大营？怎么什么人也没有？"]},{"op":79,"name":"unit_op_4f","args":[283,255,65535,65535,1,1]},{"op":20,"name":"dialog","args":["&弓兵2\n该不会有什么陷阱吧，王太守的部队\n居然一个人也看不见。\n&游奕\n王赟那个家伙完全不可靠，我看他是\n先开溜了。\n&游奕\n哈哈哈哈哈…哈哈哈哈哈…\n&弓兵2\n您笑什么？\n（总觉得之前有个蠢蛋也做过这种事。）\n&游奕\n我笑蜀人太愚蠢，要是我来带兵，一定在\n这里设伏，把孤军深入的我军一网打尽。\n&弓兵2\n大人不要这样笑啊，我曾经听说武帝过去\n在赤壁战败后的逃亡途中，也是这样乱笑\n，结果遇上一大堆伏兵。"]},{"op":9,"name":"delay","args":[5]},{"op":85,"name":"unit_move","args":[0,17,0,9,11,0]},{"op":85,"name":"unit_move","args":[0,15,0,10,11,0]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&廖化\n果然这世上笨蛋就不只一个。\n&张翼\n现在就送你们去见王赟。"]},{"op":9,"name":"delay","args":[5]},{"op":79,"name":"unit_op_4f","args":[283,65535,2,65535,1,1]},{"op":80,"name":"unit_status","args":[283,3,0,1]},{"op":80,"name":"unit_status","args":[283,9,0,1]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&弓兵2\n糟…糟…糟了…\n&游奕\n怎…怎么会这样？快…快…快跑！\n&弓兵2\n不行了，脚不听使唤…"]},{"op":77,"name":"unit_op_4d","args":[0,255,0,0,0,0,0,6,1,0,10,0,0]},{"op":77,"name":"unit_op_4d","args":[0,282,0,0,0,0,0,6,1,0,10,0,0]},{"op":77,"name":"unit_op_4d","args":[0,283,0,0,0,0,0,6,1,0,10,0,0]},{"op":77,"name":"unit_op_4d","args":[0,284,0,0,0,0,0,6,1,0,10,0,0]},{"op":77,"name":"unit_op_4d","args":[0,285,0,0,0,0,0,6,1,0,10,0,0]},{"op":9,"name":"delay","args":[5]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[1014]]},"end":44},{"op":77,"name":"unit_op_4d","args":[0,17,0,0,0,0,0,6,0,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,17,0,0,0,0,0,6,1,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,15,0,0,0,0,0,6,0,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,15,0,0,0,0,0,6,1,2,65535,0,0]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&廖化\n好！现在开始第二波歼灭敌军的行动。\n&张翼\n这个游奕就交给我来对付！"]},{"op":9,"name":"delay","args":[5]},{"op":11,"name":"set_flag","args":[11,1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":17045,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":65,"name":"test_units_in_area","args":[2,1,2,0,5,13,19,27]},{"op":5,"name":"test_flags","args":[[11],[12,1014]]},{"op":0,"name":"end","args":[]}],"body":[{"op":76,"name":"unit_op_4c","args":[0,80,0]},{"op":76,"name":"unit_op_4c","args":[0,116,0]},{"op":76,"name":"unit_op_4c","args":[0,306,0]},{"op":76,"name":"unit_op_4c","args":[0,307,0]},{"op":76,"name":"unit_op_4c","args":[0,308,0]},{"op":76,"name":"unit_op_4c","args":[0,309,0]},{"op":76,"name":"unit_op_4c","args":[0,310,0]},{"op":76,"name":"unit_op_4c","args":[0,311,0]},{"op":76,"name":"unit_op_4c","args":[0,312,0]},{"op":76,"name":"unit_op_4c","args":[0,313,0]},{"op":76,"name":"unit_op_4c","args":[0,314,0]},{"op":76,"name":"unit_op_4c","args":[0,315,0]},{"op":76,"name":"unit_op_4c","args":[0,322,0]},{"op":76,"name":"unit_op_4c","args":[0,323,0]},{"op":76,"name":"unit_op_4c","args":[0,324,0]},{"op":76,"name":"unit_op_4c","args":[0,325,0]},{"op":76,"name":"unit_op_4c","args":[0,326,0]},{"op":76,"name":"unit_op_4c","args":[0,327,0]},{"op":76,"name":"unit_op_4c","args":[0,328,0]},{"op":76,"name":"unit_op_4c","args":[0,329,0]},{"op":76,"name":"unit_op_4c","args":[0,330,0]},{"op":76,"name":"unit_op_4c","args":[0,331,0]},{"op":9,"name":"delay","args":[5]},{"op":80,"name":"unit_status","args":[80,9,0,1]},{"op":77,"name":"unit_op_4d","args":[2,255,0,0,0,19,23,2,1,0,65535,0,0]},{"op":20,"name":"dialog","args":["&郭淮\n抛弃了所有辎重，兼程赶路才赶到这里，\n没想到还是晚了一步。\n&郭淮\n现在稍微休息一下，不然我军的疲劳没有\n办法回复。\n&徐质\n前面还有残存的我军部队！\n&郭淮\n快点！用全速去援救这些残存军队。"]},{"op":80,"name":"unit_status","args":[80,0,0,1]},{"op":9,"name":"delay","args":[5]},{"op":76,"name":"unit_op_4c","args":[0,0,0]},{"op":76,"name":"unit_op_4c","args":[0,1,0]},{"op":76,"name":"unit_op_4c","args":[0,2,0]},{"op":76,"name":"unit_op_4c","args":[0,4,0]},{"op":76,"name":"unit_op_4c","args":[0,3,0]},{"op":76,"name":"unit_op_4c","args":[0,5,0]},{"op":76,"name":"unit_op_4c","args":[0,12,0]},{"op":76,"name":"unit_op_4c","args":[0,16,0]},{"op":76,"name":"unit_op_4c","args":[0,22,0]},{"op":76,"name":"unit_op_4c","args":[0,36,0]},{"op":76,"name":"unit_op_4c","args":[0,18,0]},{"op":76,"name":"unit_op_4c","args":[0,19,0]},{"op":76,"name":"unit_op_4c","args":[0,9,0]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&姜维\n郭淮…\n&袁綝\n前锋部队全被他歼灭了，明明就是处于\n被包围的状态…\n&姜维\n确实令人叹为观止，这两人无庸置疑\n是很优秀的指挥官。不过…\n&杨兰\n怎么了？你感觉好像不是很高兴。\n&姜维\n没有…你多虑了。\n&姜维\n（要是我的话，我会把郭淮引诱得更深入\n，部队变得更分散，而不是像现在这样，\n把郭淮都丢给我军。）\n&姜维\n现在全军向前发动攻击，目标郭淮军，让\n曹贼军无法踏出我大汉疆土一步！"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&廖化\n呵呵…果然来了。\n&张翼\n行动迅速，真是个大将之才。\n&廖化\n我们的任务就到这里，伯恭我们走吧！\n&张翼\n好！\n&廖化\n（现在确实要感谢你向大将军推荐我们\n，但是我们也有自己的功劳要立。）\n&廖化\n（斩杀两位太守级的将领已经足够让我们\n名声大噪，这个难对付的郭淮就留给你们\n来解决吧。）"]},{"op":49,"name":"actor_select","args":[0,17,0,0,0,0,6]},{"op":49,"name":"actor_select","args":[0,15,0,0,0,0,6]},{"op":9,"name":"delay","args":[5]},{"op":80,"name":"unit_status","args":[80,3,0,1]},{"op":80,"name":"unit_status","args":[80,9,0,1]},{"op":20,"name":"dialog","args":["&徐质\n前方似乎又来了一大批蜀军，看我斩了\n他们报仇！\n&郭淮\n姜维的军队？！\n&郭淮\n（糟了！现在我军只有骑兵队，数量不多\n而且又疲累不堪。）\n&郭淮\n（这样想来，莫非是我中了诱敌之计？）\n&郭淮\n（只是如果这是协调好的诱敌之计，那么\n姜维应该在更好的位置埋伏。）\n&郭淮\n（看来…蜀人其他将领并没有比伯约更\n杰出。）"]},{"op":80,"name":"unit_status","args":[80,0,0,1]},{"op":9,"name":"delay","args":[5]},{"op":11,"name":"set_flag","args":[12,1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":19127,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":65,"name":"test_units_in_area","args":[2,1,2,0,5,13,19,27]},{"op":5,"name":"test_flags","args":[[11,1014],[15]]},{"op":0,"name":"end","args":[]}],"body":[{"op":76,"name":"unit_op_4c","args":[0,116,0]},{"op":76,"name":"unit_op_4c","args":[0,306,0]},{"op":76,"name":"unit_op_4c","args":[0,307,0]},{"op":76,"name":"unit_op_4c","args":[0,308,0]},{"op":76,"name":"unit_op_4c","args":[0,309,0]},{"op":76,"name":"unit_op_4c","args":[0,310,0]},{"op":76,"name":"unit_op_4c","args":[0,311,0]},{"op":76,"name":"unit_op_4c","args":[0,312,0]},{"op":76,"name":"unit_op_4c","args":[0,313,0]},{"op":76,"name":"unit_op_4c","args":[0,314,0]},{"op":76,"name":"unit_op_4c","args":[0,315,0]},{"op":76,"name":"unit_op_4c","args":[0,322,0]},{"op":76,"name":"unit_op_4c","args":[0,323,0]},{"op":76,"name":"unit_op_4c","args":[0,324,0]},{"op":76,"name":"unit_op_4c","args":[0,325,0]},{"op":76,"name":"unit_op_4c","args":[0,326,0]},{"op":76,"name":"unit_op_4c","args":[0,327,0]},{"op":76,"name":"unit_op_4c","args":[0,328,0]},{"op":76,"name":"unit_op_4c","args":[0,329,0]},{"op":76,"name":"unit_op_4c","args":[0,330,0]},{"op":76,"name":"unit_op_4c","args":[0,331,0]},{"op":9,"name":"delay","args":[5]},{"op":80,"name":"unit_status","args":[116,9,0,1]},{"op":77,"name":"unit_op_4d","args":[2,255,0,0,0,19,23,2,4,0,65535,0,0]},{"op":20,"name":"dialog","args":["&徐质\n抛弃了所有锱重，兼程赶路才赶到这里，\n没想到还是晚了一步。\n&徐质\n现在稍微休息一下，不然我军的疲劳没有\n办法回复。\n&轻骑兵1\n前面还有残存的我军部队！\n&徐质\n快点！用全速去援救这些残存军队。"]},{"op":80,"name":"unit_status","args":[116,0,0,1]},{"op":9,"name":"delay","args":[5]},{"op":76,"name":"unit_op_4c","args":[0,0,0]},{"op":76,"name":"unit_op_4c","args":[0,1,0]},{"op":76,"name":"unit_op_4c","args":[0,2,0]},{"op":76,"name":"unit_op_4c","args":[0,4,0]},{"op":76,"name":"unit_op_4c","args":[0,3,0]},{"op":76,"name":"unit_op_4c","args":[0,5,0]},{"op":76,"name":"unit_op_4c","args":[0,16,0]},{"op":76,"name":"unit_op_4c","args":[0,22,0]},{"op":76,"name":"unit_op_4c","args":[0,36,0]},{"op":76,"name":"unit_op_4c","args":[0,18,0]},{"op":76,"name":"unit_op_4c","args":[0,19,0]},{"op":76,"name":"unit_op_4c","args":[0,9,0]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&姜维\n郭淮…没看见他的人影…看来伯济还真够\n小心。\n&句扶\n不过也有不少贼军被引出来…那个廖太守\n还真不简单。\n&姜维\n这样的战术确实很漂亮…不过，这样的\n攻击方式无法给敌人野战军致命打击，\n反而会让敌人日后更警觉。\n&姜维\n同样的方法日后无法再用，这样岂不\n可惜？\n&宁随\n所以伯约你对廖化的评价？\n&姜维\n这个嘛…如果是指挥小部队的指挥官，他\n会是不可多得的将才。\n&姜维\n但如果要独当一面指挥大部队，他的格局\n和柔软度略有不足。\n&姜维\n（问题是，伯济现在人到底在哪里？）"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&廖化\n呵呵…果然来了。\n&张翼\n行动迅速，真是个大将之才。\n&廖化\n我们的任务就到这里，伯恭我们走吧！\n&张翼\n好！\n&廖化\n（我让个功劳给你，就看你姜维是什么\n样的人了。）"]},{"op":49,"name":"actor_select","args":[0,17,0,0,0,0,6]},{"op":49,"name":"actor_select","args":[0,15,0,0,0,0,6]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&轻骑兵1\n前方似乎又来了一大批蜀军。\n&徐质\n看我斩了他们报仇！"]},{"op":9,"name":"delay","args":[5]},{"op":11,"name":"set_flag","args":[15,1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":20857,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":65,"name":"test_units_in_area","args":[0,8,0,1,0,3,19,11]},{"op":5,"name":"test_flags","args":[[15,1014],[16]]},{"op":0,"name":"end","args":[]}],"body":[{"op":76,"name":"unit_op_4c","args":[0,80,0]},{"op":76,"name":"unit_op_4c","args":[0,316,0]},{"op":76,"name":"unit_op_4c","args":[0,317,0]},{"op":76,"name":"unit_op_4c","args":[0,318,0]},{"op":76,"name":"unit_op_4c","args":[0,319,0]},{"op":76,"name":"unit_op_4c","args":[0,320,0]},{"op":76,"name":"unit_op_4c","args":[0,321,0]},{"op":76,"name":"unit_op_4c","args":[0,332,0]},{"op":76,"name":"unit_op_4c","args":[0,333,0]},{"op":76,"name":"unit_op_4c","args":[0,334,0]},{"op":76,"name":"unit_op_4c","args":[0,335,0]},{"op":76,"name":"unit_op_4c","args":[0,336,0]},{"op":76,"name":"unit_op_4c","args":[0,337,0]},{"op":76,"name":"unit_op_4c","arg