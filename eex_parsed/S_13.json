败的滋味。"]},{"op":11,"name":"set_flag","args":[40,1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":22075,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[4,116,1]},{"op":5,"name":"test_flags","args":[[],[41]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[4,116,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[116,4,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&徐质\n你居然也懂用大斧？\n&句扶\n略懂…\n&徐质\n哼！你可知道我是大魏徐公明的族弟…的\n奶妈的族兄的姊姊的邻居…\n&句扶\n………"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":[""]},"end":46},{"op":104,"name":"duel_setup","args":[4,116,20]},{"op":96,"name":"duel_say","args":[1,"我就看看你有多会用大斧！",9]},{"op":96,"name":"duel_say","args":[0,"我可是生下来就和大斧睡在一起！",10]},{"op":97,"name":"duel_end","args":[]},{"op":99,"name":"duel_say2","args":[1,"看招！",1]},{"op":100,"name":"duel_action","args":[1,2]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[0,3,1]},{"op":100,"name":"duel_action","args":[1,4]},{"op":100,"name":"duel_action","args":[1,4]},{"op":100,"name":"duel_action","args":[0,4]},{"op":99,"name":"duel_say2","args":[1,"果然厉害…看来你不是只会说\n大话…",1]},{"op":9,"name":"delay","args":[5]},{"op":102,"name":"duel_action3","args":[1,1,1]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[1,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":9,"name":"delay","args":[3]},{"op":99,"name":"duel_say2","args":[1,"拿出真本事来了！牙旋豪斧！",1]},{"op":101,"name":"duel_action2","args":[1,1,1]},{"op":99,"name":"duel_say2","args":[1,"岩碎袭击！",1]},{"op":101,"name":"duel_action2","args":[1,1,1]},{"op":99,"name":"duel_say2","args":[1,"月闪空破！",1]},{"op":101,"name":"duel_action2","args":[1,2,1]},{"op":9,"name":"delay","args":[3]},{"op":100,"name":"duel_action","args":[0,12]},{"op":99,"name":"duel_say2","args":[0,"这家伙真够厉害的…",1]},{"op":100,"name":"duel_action","args":[1,3]},{"op":100,"name":"duel_action","args":[1,10]},{"op":99,"name":"duel_say2","args":[1,"有本事再来？",1]},{"op":100,"name":"duel_action","args":[0,1]},{"op":99,"name":"duel_say2","args":[0,"哼，斧头弯了，下次换把斧头\n再交手。",1]},{"op":100,"name":"duel_action","args":[0,3]},{"op":100,"name":"duel_action","args":[0,13]},{"op":9,"name":"delay","args":[3]},{"op":99,"name":"duel_say2","args":[1,"能让我使出这么多招，你也不\n简单啊…",1]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&徐质\n出师不利，先退了…"]},{"op":49,"name":"actor_select","args":[0,116,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[41,1]},{"op":0,"name":"end","args":[]}]},{"index":10,"offset":23101,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":63,"name":"test_turn","args":[1,2]},{"op":5,"name":"test_flags","args":[[1014],[30]]},{"op":0,"name":"end","args":[]}],"body":[{"op":77,"name":"unit_op_4d","args":[0,80,0,0,0,23,39,2,0,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,80,0,0,0,23,39,2,1,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,80,0,0,0,23,39,2,2,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,80,0,0,0,23,39,2,3,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,80,0,0,0,23,39,2,4,2,65535,0,0]},{"op":11,"name":"set_flag","args":[30,1]},{"op":0,"name":"end","args":[]}]},{"index":11,"offset":23492,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":63,"name":"test_turn","args":[6,2]},{"op":5,"name":"test_flags","args":[[1014],[31]]},{"op":0,"name":"end","args":[]}],"body":[{"op":77,"name":"unit_op_4d","args":[0,80,0,0,0,23,39,2,0,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,80,0,0,0,23,39,2,1,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,80,0,0,0,23,39,2,2,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,80,0,0,0,23,39,2,3,2,65535,0,0]},{"op":77,"name