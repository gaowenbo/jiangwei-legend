,"name":"unit_op_4c","args":[0,636,0]},{"op":76,"name":"unit_op_4c","args":[0,637,0]},{"op":78,"name":"unit_op_4e","args":[1,65535,4,1,8,2,2,1,65535,0,0]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[135]]},"end":14},{"op":20,"name":"dialog","args":["&刘渊\n大匈奴的骑兵？难道父亲决定归顺大晋？\n&刘渊\n不，光看这样的数量来看，距离全力支援\n还差太多了。"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[81]]},"end":17},{"op":20,"name":"dialog","args":["&卫瓘\n哈哈，赢定了。\n&卫瓘\n面对两面包夹，你们有赢的机会吗？"]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[92]]},"end":21},{"op":20,"name":"dialog","args":["&袁綝\n亡羊补牢，犹时未晚。\n&袁綝\n现在匈奴人的部队并没有很多，只要排好\n阵型，以盾御之，以戟攻之，还是可以破\n他们的骑兵阵。\n&袁綝\n西南方的村庄可作为御敌的据点，将我军\n聚在此地，即可巩固防御，对抗匈奴骑。"]},{"op":91,"name":"op_5b","args":[2,10,4,12,1]},{"op":0,"name":"end","args":[]},{"op":11,"name":"set_flag","args":[25,1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":14703,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":65,"name":"test_units_in_area","args":[4,8,0,1,2,10,4,12]},{"op":5,"name":"test_flags","args":[[25],[]]},{"op":0,"name":"end","args":[]}],"body":[{"op":77,"name":"unit_op_4d","args":[2,65535,0,2,10,4,12,4,1,2,65535,0,0]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":14848,"title":"ね瓁北��","conditions":[{"op":2,"name":"comment","args":["ね瓁北��"]},{"op":63,"name":"test_turn","args":[1,2]},{"op":64,"name":"test_side","args":[2]},{"op":0,"name":"end","args":[]}],"body":[{"op":78,"name":"unit_op_4e","args":[1,65535,10,0,15,16,2,1,65535,0,0]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":14945,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":38,"name":"test_unit_in_area","args":[1025,13,0,27,16]},{"op":5,"name":"test_flags","args":[[],[251]]},{"op":0,"name":"end","args":[]}],"body":[{"op":78,"name":"unit_op_4e","args":[1,65535,19,5,22,10,2,1,65535,0,0]},{"op":11,"name":"set_fl