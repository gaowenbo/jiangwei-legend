,0,0]},{"op":75,"name":"op_4b","args":[3,5,19,0,0]},{"op":75,"name":"op_4b","args":[4,4,18,0,0]},{"op":75,"name":"op_4b","args":[5,4,19,0,0]},{"op":75,"name":"op_4b","args":[6,3,18,0,0]},{"op":75,"name":"op_4b","args":[7,3,19,0,0]},{"op":75,"name":"op_4b","args":[8,2,18,0,0]},{"op":75,"name":"op_4b","args":[9,2,19,0,0]},{"op":75,"name":"op_4b","args":[10,1,18,0,0]},{"op":75,"name":"op_4b","args":[11,1,19,0,0]},{"op":75,"name":"op_4b","args":[12,0,18,0,0]},{"op":75,"name":"op_4b","args":[13,0,19,0,0]},{"op":75,"name":"op_4b","args":[14,0,0,0,0]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[1020],[]]},"end":29},{"op":72,"name":"battle_equipment","args":[113,0,0,0,0,9]},{"op":0,"name":"end","args":[]},{"op":39,"name":"change_scene","args":[3,65535,65535,65535,23]},{"op":28,"name":"fade_out","args":[]},{"op":36,"name":"play_sound","args":[2]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":[""]},"end":46},{"op":88,"name":"op_58","args":[18,0,17,9,4,0,1]},{"op":88,"name":"op_58","args":[19,0,17,9,5,0,1]},{"op":88,"name":"op_58","args":[20,0,17,14,10,0,1]},{"op":88,"name":"op_58","args":[21,0,17,15,10,0,1]},{"op":20,"name":"dialog","args":["&姜维\n西平果然如传说般的一样的坚固。\n&姜维\n就照诸葛姑娘说的那样，只要停留在外围\n和靠过来的敌人交战即可，不需要太执著\n于攻城。\n&宁随\n我之前的提议，伯约你还记得吧。\n&姜维\n在这场战争中掳获敌将郭循，这是什么\n道理？\n&宁随\n到时候你就知道了。\n&诸葛果\n敌人数量虽多，却没有注意到重骑兵在\n雪地无法发挥机动力，只要抓准时间差\n就可以轻松各个击破。\n&诸葛果\n不过敌人在城内设置相当数量的投石车，\n最好不要随便靠近城池。"]},{"op":79,"name":"unit_op_4f","args":[150,113,65535,65535,1,1]},{"op":79,"name":"unit_op_4f","args":[113,150,65535,65535,1,1]},{"op":20,"name":"dialog","args":["&牵弘\n你还真是胆小如鼠，碰到这一点数量的\n蜀军就吓得躲在城里。\n&陈骞\n这是谨慎。\n&陈骞\n我问你，我军的优势是什么？\n&牵弘\n军队的数量！\n&陈骞\n错，军队的数量可以靠素质和战术来弥补\n，但是城池和粮草却不行。\n&陈骞\n我军拥有坚固的城池和充沛的粮草，如果\n舍弃自己的长处去和敌人交锋，那才是愚\n蠢至极。\n&牵弘\n哼！你就动一张嘴而已，仗著自己父亲的\n威势很了不起。\n&陈骞\n说到父亲的威势，难道你就没有靠著令尊\n牵子经的威光？\n&牵弘\n哼！别提了，就因为被我爹连累，我现在\n才在这边垦荒。\n&牵弘\n现在我派出大魏西平第一猛将郭循去迎战\n，这次一定要立大功调回中原。\n&陈骞\n郭循虽然勇猛，但是毫无带兵作战的经验\n，这样的人根本不能担任大将。\n&牵弘\n城外那些部队都归我所管，你无权过问。\n&陈骞\n（牵弘勇而无谋，刚愎自用，实在难堪重\n任。现在守住西平应该是没问题，但是损\n失可就难以估计了。）\n&陈骞\n（不过这姜维也真该死，今天我好不容易\n预约到“尼可”，居然挑这个时候来打西\n平。）\n&陈骞\n（压力好大呀…谁叫我老爹虽是名门，但\n却是外家养大的，没办法和陈泰相比，\n所以官老是做不大。）\n&陈骞\n（我只能辛辛苦苦去扮演清高名士的角色\n，连叫个小姐都得躲躲藏藏，实在是太辛\n苦了。）\n&陈骞\n（唉…诚挚终…）\n&牵弘\n（这个死陈骞，爱偷吃又爱装，谁不知道\n你陈公子最喜欢嫖妓。）"]},{"op":79,"name":"unit_op_4f","args":[113,65535,2,65535,1,1]},{"op":79,"name":"unit_op_4f","args":[150,65535,2,65535,1,1]},{"op":80,"name":"unit_status","args":[205,7,1,1]},{"op":20,"name":"dialog","args":["&郭循\n全军突击！\n&郭循\n（父亲曾经为主子尽忠，当刺客当了\n大半生，结果落得死于非命的下场。）\n&郭循\n（我不愿意复制父亲的人生，所以才自请\n调来这里当中郎将，希望这里是我崭新人\n生的开始。）"]},{"op":0,"name":"end","args":[]},{"op":36,"name":"play_sound","args":[79]},{"op":25,"name":"victory_cond_text","args":["胜利条件\n一﹑歼灭所有敌军。\n\n失败条件\n一﹑姜维死亡。\n二﹑回合数超过30。"]},{"op":26,"name":"battle_goal_text","args":["一﹑歼灭所有敌军。"]},{"op":90,"name":"ui_5a","args":[]},{"op":8,"name":"set_result","args":[1]},{"op":0,"name":"end","args":[]}]}]},{"index":1,"offset":12744,"sections":[{"index":0,"offset":12746,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[2,205,1]},{"op":5,"name":"test_flags","args":[[],[49]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[2,205,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[205,2,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&杨兰\n你就是郭循？乖乖跟我回去吧！\n&郭循\n派个女人就想抓我？你也不打听一下\n我是什么人。"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":[""]},"end":62},{"op":104,"name":"duel_setup","args":[2,205,24]},{"op":96,"name":"duel_say","args":[1,"你究竟是什么人？",0]},{"op":96,"name":"duel_say","args":[0,"郭昂之子郭循！\n",10]},{"op":97,"name":"duel_end","args":[]},{"op":99,"name":"duel_say2","args":[0,"看刀！",1]},{"op":100,"name":"duel_action","args":[0,2]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":99,"name":"duel_say2","args":[0,"看我这招“只用一次”！",1]},{"op":102,"name":"duel_action3","args":[0,1,1]},{"op":100,"name":"duel_action","args":[0,1]},{"op":102,"name":"duel_action3","args":[0,1,1]},{"op":100,"name":"duel_action","args":[0,1]},{"op":100,"name":"duel_action","args":[1,8]},{"op":99,"name":"duel_say2","args":[1,"别以为只有你会这样的攻击！",1]},{"op":101,"name":"duel_action2","args":[1,1,1]},{"op":101,"name":"duel_action2","args":[1,1,1]},{"op":101,"name":"duel_action2","args":[1,1,1]},{"op":99,"name":"duel_say2","args":[0,"这种臂力实在不像是女人！",1]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[0,1,1]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[0,1,1]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,2,1]},{"op":100,"name":"duel_action","args":[1,2]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":9,"name":"delay","args":[3]},{"op":100,"name":"duel_action","args":[0,7]},{"op":99,"name":"duel_say2","args":[0,"糟了！居然脚陷在雪里？",1]},{"op":99,"name":"duel_say2","args":[1,"好机会！不死鸟之舞！",1]},{"op":100,"name":"duel_action","args":[1,8]},{"op":102,"name":"duel_action3","args":[1,1,0]},{"op":100,"name":"duel_action","args":[1,1]},{"op":102,"name":"duel_action3","args":[1,1,0]},{"op":9,"name":"delay","args":[3]},{"op":100,"name":"duel_action","args":[0,12]},{"op":99,"name":"duel_say2","args":[0,"（结果如我所料……）",1]},{"op":99,"name":"duel_say2","args":[0,"（以前张雷叔叔就和我说过，\n我不是当大将的料……）",1]},{"op":100,"name":"duel_action","args":[1,1]},{"op":99,"name":"duel_say2","args":[1,"怎么样？你可服气？",1]},{"op":99,"name":"duel_say2","args":[0,"…………",1]},{"op":99,"name":"duel_say2","args":[1,"来呀，带下去！",1]},{"op":9,"name":"delay","args":[5]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":80,"name":"unit_status","args":[2,1,0,1]},{"op":20,"name":"dialog","args":["&杨兰\n生擒敌将郭循！\n&杨兰\n（奇怪，总感觉应该更难抓才是。）"]},{"op":20,"name":"dialog","args":["&郭循\n（到头来，我还是得当个刺客，命运还\n真是有够会作弄人。）\n&宁随\n（这样一来，演员就全部到齐了。）"]},{"op":83,"name":"unit_op_53","args":[0,205,0,0,0,0,6,0]},{"op":61,"name":"get_item","args":[102,0,1,2]},{"op":11,"name":"set_flag","args":[49,1]},{"op":0,"name":"end","args":[]}]},{"index":1,"offset":14169,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":65,"name":"test_units_in_area","args":[2,1,1,1,0,0,8,19]},{"op":65,"name":"test_units_in_area","args":[2,1,1,1,9,11,19,19]},{"op":5,"name":"test_flags","args":[[],[8]]},{"op":0,"name":"end","args":[]}],"body":[{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[]]},"end":50},{"op":79,"name":"unit_op_4f","args":[113,150,65535,65535,1,1]},{"op":79,"name":"unit_op_4f","args":[150,113,65535,65535,1,1]},{"op":80,"name":"unit_status","args":[150,9,1,1]},{"op":20,"name":"dialog","args":["&牵弘\n城外的部队…被全灭…郭循也被抓了，\n呜呜呜…\n&陈骞\n因为你愚蠢的出击，害我们大魏多少将士\n无谓葬身在这里。\n&陈骞\n（也害我没时间去找尼可…）\n&牵弘\n那…该…该该怎么办？\n&陈骞\n你顶住这里，我出去求援军。\n&牵弘\n你不会打算丢下我吧？\n&陈骞\n我又不是你！何况蜀军的战力是没有办法\n长久占领这里，就算失陷也不要惊慌。\n&牵弘\n那么拜托你快点把援军带来吧…"]},{"op":49,"name":"actor_select","args":[0,113,0,0,0,0,6]},{"op":79,"name":"unit_op_4f","args":[150,65535,2,65535,1,1]},{"op":79,"name":"unit_op_4f","args":[0,1,65535,65535,1,1]},{"op":79,"name":"unit_op_4f","args":[1,0,65535,65535,1,1]},{"op":21,"name":"unit_say","args":[1,1,"主公，现在西平已经陷入包围状态，只是\n考虑到援军到达的可能性，我们有两个选\n择。"]},{"op":21,"name":"unit_say","args":[1,1,"一是直接撤兵，见好就收。另一是把敌人\n城中军队引出来，然后趁机攻城，并且用\n城池作为根据地来对抗援军。"]},{"op":21,"name":"unit_say","args":[1,1,"然而不管是用哪个策略，都该懂得及时\n撤退，我们并没有力量长期占领这里。"]},{"op":20,"name":"dialog","args":["&姜维\n嗯…"]},{"op":18,"name":"choice","args":["就此撤退\n引出敌军",65535]},{"op":1,"name":"if","args":[],"cond":{"op":19,"name":"test_choice","args":[1]},"end":23},{"op":20,"name":"dialog","args":["&姜维\n已经取得相当的战果了，全军撤退！"]},{"op":49,"name":"actor_select","args":[1,65535,0,0,19,19,0]},{"op":20,"name":"dialog","args":["&牵弘\n咦？敌人明明占优势还撤退，那我还真是\n走运。"]},{"op":81,"name":"op_51","args":[]},{"op":89,"name":"op_59","args":[800,97,65535,65535,65535,65535,65535,65535]},{"op":73,"name":"ui_49","args":[]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]},{"op":1,"name":"if","args":[],"cond":{"op":19,"name":"test_choice","args":[2]},"end":49},{"op":50,"name":"actor_move","args":[0,0,0,5,4,1]},{"op":79,"name":"unit_op_4f","args":[150,65535,3,65535,1,1]},{"op":80,"name":"unit_status","args":[0,7,0,1]},{"op":20,"name":"dialog","args":["&姜维\n堂堂大魏军队被杀得抛戈弃甲，不觉得\n丢脸？\n&姜维\n你看看这是谁的头盔？这是谁的铠甲？\n&姜维\n有这么好的装备却被打得七零八落，你们\n还真是弱得可怜，加油，好吗？"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&杨兰\n我总觉得姜维他有引战的才能…\n&句扶\n要是是我，我早就受不了了，没想到曹贼\n还真能忍。"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&步兵7\n实在是太过分了！\n&步兵8\n不杀掉那王八蛋我誓不为人！"]},{"op":20,"name":"dialog","args":["&牵弘\n大家别中计，这可是敌人的诱敌之计，\n我可没这么笨。"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&姜维\n你就是那个牵招的笨儿子吗？你爹征讨\n轲比能可没有像你这样龟在城里的。\n&姜维\n真可怜，当年亲眼见到牵子经风采过人，\n只可惜生个没用的笨儿子。\n&牵弘\n………\n&姜维\n（难道没效？看来这个牵弘还真是\n沉得住气。）"]},{"op":80,"name":"unit_status","args":[150,7,0,1]},{"op":20,"name":"dialog","args":["&牵弘\n你他妈的！老子不干掉你，誓不为人！\n&姜维\n有本事就过来呀。"]},{"op":88,"name":"op_58","args":[18,1,16,9,4,1,0]},{"op":88,"name":"op_58","args":[19,1,16,9,5,0,0]},{"op":88,"name":"op_58","args":[20,1,16,14,10,1,0]},{"op":88,"name":"op_58","args":[21,1,16,15,10,0,0]},{"op":78,"name":"unit_op_4e","args":[1,65535,0,0,19,19,6,1,65535,0,0]},{"op":20,"name":"dialog","args":["&姜维\n好！引出来了！趁现在攻陷西平！"]},{"op":21,"name":"unit_say","args":[1,1,"主公，计策虽然成功，但若是情况不利的\n时候还是请赶快撤退。"]},{"op":25,"name":"victory_cond_text","args":["胜利条件\n一﹑撑到30回合。\n二﹑撤退到指定地点。\n\n失败条件\n一﹑姜维死亡。"]},{"op":26,"name":"battle_goal_text","args":["一﹑撑到30回合。\n二﹑撤退到指定地点。"]},{"op":92,"name":"op_5c","args":[0]},{"op":91,"name":"op_5b","args":[0,19,0,19,0]},{"op":0,"name":"end","args":[]},{"op":0,"name":"end","args":[]},{"op":11,"name":"set_flag","args":[8,1]},{"op":0,"name":"end","args":[]}]},{"index":2,"offset":16617,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":37,"name":"test_unit_at","args":[1025,17,2]},{"op":5,"name":"test_flags","args":[[],[20]]},{"op":0,"name":"end","args":[]}],"body":[{"op":119,"name":"int_var_op","args":[2,4080,2,0,1]},{"op":61,"name":"get_item","args":[30,65535,1,1025]},{"op":119,"name":"int_var_op","args":[2,4080,2,0,0]},{"op":11,"name":"set_flag","args":[20,1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":16750,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":37,"name":"test_unit_at","args":[1025,18,1]},{"op":5,"name":"test_flags","args":[[],[21]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&姜维\n控制城池了！"]},{"op":61,"name":"get_item","args":[91,65535,1,1025]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[1020]]},"end":5},{"op":77,"name":"unit_op_4d","args":[2,0,0,0,0,19,19,2,1,0,65535,0,0]},{"op":0,"name":"end","args":[]},{"op":11,"name":"set_flag","args":[21,1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":16940,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":37,"name":"test_unit_at","args":[0,0,19]},{"op":5,"name":"test_flags","args":[[8],[22]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&姜维\n已经取得相当的战果了，全军撤退！"]},{"op":49,"name":"actor_select","args":[1,65535,0,0,19,19,0]},{"op":20,"name":"dialog","args":["&牵弘\n咦？敌人明明占优势还撤退，那我还真是\n走运。"]},{"op":20,"name":"dialog","args":["&陈骞\n该退则退，真是有名将的风范。\n&陈骞\n（这仗打得也累死人，等下一定要去找\n“妮可”玩个够。）\n&陈骞\n（当个正人君子还真累人，去找小姐都要\n躲躲藏藏，有时候真羡慕石苞这种人。）"]},{"op":81,"name":"op_51","args":[]},{"op":89,"name":"op_59","args":[900,97,65535,65535,65535,65535,65535,65535]},{"op":73,"name":"ui_49","args":[]},{"op":13,"name":"next_scene","args":[]},{"op":11,"name":"set_flag","args":[22,1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":17361,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":63,"name":"test_turn","args":[12,0]},{"op":5,"name":"test_flags","args":[[8],[11,1020]]},{"op":0,"name":"end","args":[]}],"body":[{"op":85,"name":"unit_move","args":[0,113,0,16,14,3]},{"op":85,"name":"unit_move","args":[0,306,0,17,13,3]},{"op":85,"name":"unit_move","args":[0,307,0,17,14,3]},{"op":85,"name":"unit_move","args":[0,308,0,17,15,3]},{"op":85,"name":"unit_move","args":[0,309,0,17,15,3]},{"op":85,"name":"unit_move","args":[0,310,0,18,13,3]},{"op":85,"name":"unit_move","args":[0,311,0,18,14,3]},{"op":85,"name":"unit_move","args":[0,312,0,18,15,3]},{"op":85,"name":"unit_move","args":[0,313,0,18,16,3]},{"op":78,"name":"unit_op_4e","args":[0,113,0,0,19,19,6,1,65535,0,0]},{"op":20,"name":"dialog","args":["&陈骞\n好！终于赶回来了！不管西平有没有沦陷\n，蜀军都不能在这里待多久，持续攻击就\n对了！\n&陈骞\n（要滚就快滚啦，烦死了！）\n&姜维\n敌人援军来了，大家准备迎击！"]},{"op":11,"name":"set_flag","args":[11,1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":17927,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":63,"name":"test_turn","args":[12,0]},{"op":64,"name":"test_side","args":[2]},{"op":5,"name":"test_flags","args":[[8,1020],[12]]},{"op":0,"name":"end","args":[]}],"body":[{"op":85,"name":"unit_move","args":[0,113,0,16,14,3]},{"op":85,"name":"unit_move","args":[0,306,0,17,13,3]},{"op":85,"name":"unit_move","args":[0,307,0,17,14,3]},{"op":85,"name":"unit_move","args":[0,308,0,17,15,3]},{"op":85,"name":"unit_move","args":[0,309,0,17,15,3]},{"op":85,"name":"unit_move","args":[0,310,0,18,13,3]},{"op":85,"name":"unit_move","args":[0,311,0,18,14,3]},{"op":85,"name":"unit_move","args":[0,312,0,18,15,3]},{"op":85,"name":"unit_move","args":[0,313,0,18,16,3]},{"op":85,"name":"unit_move","args":[0,506,0,19,13,3]},{"op":85,"name":"unit_move","args":[0,507,0,19,14,3]},{"op":85,"name":"unit_move","args":[0,508,0,19,15,3]},{"op":85,"name":"unit_move","args":[0,509,0,19,20,3]},{"op":78,"name":"unit_op_4e","args":[0,113,0,0,19,19,6,1,65535,0,0]},{"op":20,"name":"dialog","args":["&陈骞\n好！终于赶回来了！不管西平有没有沦陷\n，蜀军都不能在这里待多久，持续攻击就\n对了！\n&陈骞\n（要滚就快滚啦，烦死了！）\n&姜维\n敌人援军来了，大家准备迎击！"]},{"op":11,"name":"set_flag","args":[12,1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":18627,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":65,"name":"test_units_in_area","args":[2,4,1,1,0,0,19,19]},{"op":5,"name":"test_flags","args":[[],[1020]]},{"op":0,"name":"end","args":[]}],"body":[{"op":85,"name":"unit_move","args":[0,322,0,17,13,3]},{"op":85,"name":"unit_move","args":[0,323,0,17,14,3]},{"op":85,"name":"unit_move","args":[0,324,0,17,15,3]},{"op":85,"name":"unit_move","args":[0,325,0,17,16,3]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":18832,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":65,"name":"test_units_in_area","args":[2,0,2,1,9,0,19,10]},{"op":5,"name":"test_flags","args":[[1020],[200]]},{"op":0,"name":"end","args":[]}],"body":[{"op":85,"name":"unit_move","args":[0,338,0,12,4,3]},{"op":85,"name":"unit_move","args":[0,339,0,12,5,3]},{"op":85,"name":"unit_move","args":[0,340,0,14,7,3]},{"op":85,"name":"unit_move","args":[0,341,0,15,7,3]},{"op":85,"name":"unit_move","args":[0,342,0,16,1,3]},{"op":85,"name":"unit_move","args":[0,343,0,16,2,3]},{"op":85,"name":"unit_move","args":[0,344,0,17,3,2]},{"op":85,"name":"unit_move","args":[0,345,0,18,3,2]},{"op":11,"name":"set_flag","args":[200,1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":19179,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":65,"name":"test_units_in_area","args":[2,8,1,1,0,0,19,19]},{"op":5,"name":"test_flags","args":[[1020],[]]},{"op":0,"name":"end","args":[]}],"body":[{"op":85,"name":"unit_move","args":[0,322,0,17,13,3]},{"op":85,"name":"unit_move","args":[0,323,0,17,14,3]},{"op":85,"name":"unit_move","args":[0,324,0,17,15,3]},{"op":85,"name":"unit_move","args":[0,325,0,17,16,3]},{"op":85,"name":"unit_move","args":[0,506,0,18,13,3]},{"op":85,"name":"unit_move","args":[0,507,0,18,14,3]},{"op":85,"name":"unit_move","args":[0,508,0,18,15,3]},{"op":85,"name":"unit_move","args":[0,509,0,18,16,3]},{"op":0,"name":"end","args":[]}]},{"index":10,"offset":19512,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":63,"name":"test_turn","args":[30,2]},{"op":64,"name":"test_side","args":[1]},{"op":5,"name":"test_flags","args":[[],[100]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&姜维\n已经取得相当的战果了，全军撤退！"]},{"op":49,"name":"actor_select","args":[1,65535,0,0,19,19,0]},{"op":81,"name":"op_51","args":[]},{"op":89,"name":"op_59","args":[1000,97,65535,65535,65535,65535,65535,65535]},{"op":73,"name":"ui_49","args":[]},{"op":11,"name":"set_flag","args":[100,1]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":11,"offset":19698,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[0,113,1]},{"op":5,"name":"test_flags","args":[[],[40]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[0,113,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[113,0,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&姜维\n你就是陈休渊对吧？\n&陈骞\n你知道我？\n&姜维\n在下姜维，字伯约。\n&陈骞\n原来如此，果然如传说般是个不简单的\n人物。\n&陈骞\n如果我看得没错，你将来一定是肩负蜀地\n未来的人才。\n&姜维\n你过奖了。\n&陈骞\n不过…站在高处就等于成为众人攻击的\n对象，你真的准备好了？\n&陈骞\n（就像我，因为是陈矫的儿子，所以每个\n人都在盯著我看，根本没办法好好去找“\n尼可”。）\n&陈骞\n（上次被抓到自己的爱车停在妓院前面，\n还得让朋友去帮我背黑锅才逃过一劫，做\n人怎么这么可悲呀。）\n&姜维\n我…\n&陈骞\n（他好像还是不明白我这些话的用意。）"]},{"op":11,"name":"set_flag","args":[40,1]},{"op":0,"name":"end","args":[]}]},{"index":12,"offset":20311,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[0,150,1]},{"op":5,"name":"test_flags","args":[[],[42]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[0,150,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[150,0,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&牵弘\n你这个混帐，还记得我吗？\n&姜维\n你是牵子经的儿子？当时多亏令尊网开\n一面，才有今日之我。\n&牵弘\n闭嘴！我老爹就是因为老被怀疑和刘备\n有关系，所以官老做不大。\n&牵弘\n我也被他害得只能当个绿豆小官，罪魁\n祸首就是刘备和他的走狗！\n&姜维\n你不能理解令尊高贵的友情？\n&牵弘\n我才不想理解，我只知道他害我也被\n连累，是个不负责任的男人。"]},{"op":11,"name":"set_flag","args":[42,1]},{"op":0,"name":"end","args":[]}]},{"index":13,"offset":20750,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[3,150,1]},{"op":5,"name":"test_flags","args":[[],[41]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[3,150,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[150,3,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&柳隐\n你好歹也算是个大将，和我单挑如何？\n&牵弘\n哼，说不单挑就不单挑。\n&柳隐\n嗯…阁下脸皮之厚也可以说天下无双了。"]},{"op":11,"name":"set_flag","args":[41,1]},{"op":0,"name":"end","args":[]}]},{"index":14,"offset":20978,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[1,7,0,2]},{"op":5,"name":"test_flags","args":[[],[50]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&诸葛果\n主公，请处罚我的失职。"]},{"op":49,"name":"actor_select","args":[0,1,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[50,1]},{"op":0,"name":"end","args":[]}]},{"index":15,"offset":21108,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[17,7,0,2]},{"op":5,"name":"test_flags","args":[[],[74]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&廖化\n难道我廖化真的不能作先锋？"]},{"op":49,"name":"actor_select","args":[0,17,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[74,1]},{"op":0,"name":"end","args":[]}]},{"index":16,"offset":21240,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[2,7,0,2]},{"op":5,"name":"test_flags","args":[[],[224]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&杨兰\n真是不小心，我的爱情之路总是这么\n坎坷。"]},{"op":49,"name":"actor_select","args":[0,2,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[224,1]},{"op":0,"name":"end","args":[]}]},{"index":17,"offset":21385,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[4,7,0,2]},{"op":5,"name":"test_flags","args":[[],[137]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&句扶\n纵然战败，其心不败。"]},{"op":49,"name":"actor_select","args":[0,4,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[137,1]},{"op":0,"name":"end","args":[]}]},{"index":18,"offset":21511,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[5,7,0,2]},{"op":5,"name":"test_flags","args":[[],[139]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&宁随\n我越来越懂得生存的意义了。"]},{"op":49,"name":"actor_select","args":[0,5,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[139,1]},{"op":0,"name":"end","args":[]}]},{"index":19,"offset":21643,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[18,7,0,2]},{"op":5,"name":"test_flags","args":[[],[152]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&赵统\n我还是及不上父亲的一半。"]},{"op":49,"name":"actor_select","args":[0,18,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[152,1]},{"op":0,"name":"end","args":[]}]},{"index":20,"offset":21773,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[19,7,0,2]},{"op":5,"name":"test_flags","args":[[],[153]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&赵广\n看来走自己的路也不太容易。"]},{"op":49,"name":"actor_select","args":[0,19,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[153,1]},{"op":0,"name":"end","args":[]}]},{"index":21,"offset":21905,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[22,7,0,2]},{"op":5,"name":"test_flags","args":[[],[70]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&张嶷\n一时的败退不要气馁，再战就好。"]},{"op":49,"name":"actor_select","args":[0,22,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[70,1]},{"op":0,"name":"end","args":[]}]},{"index":22,"offset":22041,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[16,7,0,2]},{"op":5,"name":"test_flags","args":[[],[71]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&关索\n比起战败，我更怕这些女人找我算帐。"]},{"op":49,"name":"actor_select","args":[0,16,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[71,1]},{"op":0,"name":"end","args":[]}]},{"index":23,"offset":22181,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[13,7,0,2]},{"op":5,"name":"test_flags","args":[[],[72]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&霍弋\n这个时候要忍住，不要吐槽自己。"]},{"op":49,"name":"actor_select","args":[0,13,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[72,1]},{"op":0,"name":"end","args":[]}]},{"index":24,"offset":22317,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[20,7,0,2]},{"op":5,"name":"test_flags","args":[[],[202]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&花鬘\n我可不是因为帮你才弄到撤退的啦。"]},{"op":49,"name":"actor_select","args":[0,20,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[202,1]},{"op":0,"name":"end","args":[]}]},{"index":25,"offset":22455,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[15,7,0,2]},{"op":5,"name":"test_flags","args":[[],[73]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&张翼\n居然战败了？真是不可思议。"]},{"op":49,"name":"actor_select","args":[0,15,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[73,1]},{"op":0,"name":"end","args":[]}]},{"index":26,"offset":22587,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[11,7,0,2]},{"op":5,"name":"test_flags","args":[[],[230]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&刘敏\n所谓的战败有分很多种，有谓先胜后败，\n也有先败后胜，也有胜败交错，也有不胜\n不败…（继续啰唆）"]},{"op":49,"name":"actor_select","args":[0,11,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[230,1]},{"op":0,"name":"end","args":[]}]},{"index":27,"offset":22785,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[10,7,0,2]},{"op":5,"name":"test_flags","args":[[],[78]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&向充\n看来我努力得还不够，得向老师多学习。"]},{"op":49,"name":"actor_select","args":[0,10,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[78,1]},{"op":0,"name":"end","args":[]}]},{"index":28,"offset":22927,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[8,7,0,2]},{"op":5,"name":"test_flags","args":[[],[75]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&来忠\n外面的战场固然可怕，但是内部的战场更\n是可怕…"]},{"op":49,"name":"actor_select","args":[0,8,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[75,1]},{"op":0,"name":"end","args":[]}]},{"index":29,"offset":23078,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":54,"name":"test_attr","args":[3,7,0,2]},{"op":5,"name":"test_flags","args":[[],[136]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&柳隐\n败战乃兵家常事。"]},{"op":49,"name":"actor_select","args":[0,3,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[136,1]},{"op":0,"name":"end","args":[]}]},{"index":30,"offset":23208,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":54,"name":"test_attr","args":[6,7,0,2]},{"op":5,"name":"test_flags","args":[[],[51]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&傅佥\n纵然战败，绝不投降！"]},{"op":49,"name":"actor_select","args":[0,6,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[51,1]},{"op":0,"name":"end","args":[]}]},{"index":31,"offset":23342,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[9,7,0,2]},{"op":5,"name":"test_flags","args":[[],[68]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&袁綝\n真是有负义父的期望。"]},{"op":49,"name":"actor_select","args":[0,9,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[68,1]},{"op":0,"name":"end","args":[]}]},{"index":32,"offset":23468,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":54,"name":"test_attr","args":[32,7,0,2]},{"op":5,"name":"test_flags","args":[[],[52]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&蒋舒\n保留实力为上策。"]},{"op":49,"name":"actor_select","args":[0,32,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[52,1]},{"op":0,"name":"end","args":[]}]},{"index":33,"offset":23598,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[113,7,0,2]},{"op":5,"name":"test_flags","args":[[],[240]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&陈骞\n蜀军战力之强，真是让我大开眼界。\n&陈骞\n（真倒楣呀，有事没事就打仗，这些人不\n累吗？好想回去看官能小说喔…）"]},{"op":49,"name":"actor_select","args":[0,113,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[240,1]},{"op":0,"name":"end","args":[]}]},{"index":34,"offset":23810,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[150,7,0,2]},{"op":5,"name":"test_flags","args":[[],[241]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&牵弘\n给我记住！"]},{"op":49,"name":"actor_select","args":[0,150,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[241,1]},{"op":0,"name":"end","args":[]}]},{"index":35,"offset":23926,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":54,"name":"test_attr","args":[2