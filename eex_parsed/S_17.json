p":61,"name":"get_item","args":[102,0,1,6]},{"op":11,"name":"set_flag","args":[49,1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":22048,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":38,"name":"test_unit_in_area","args":[1025,6,15,17,23]},{"op":5,"name":"test_flags","args":[[],[30]]},{"op":0,"name":"end","args":[]}],"body":[{"op":80,"name":"unit_status","args":[80,8,1,1]},{"op":20,"name":"dialog","args":["&郭淮\n挡住后方！在消灭羌人以前不能让蜀军\n靠过来！"]},{"op":78,"name":"unit_op_4e","args":[0,282,0,0,0,0,65535,1,65535,0,0]},{"op":78,"name":"unit_op_4e","args":[0,283,0,0,0,0,65535,1,65535,0,0]},{"op":78,"name":"unit_op_4e","args":[0,284,0,0,0,0,65535,1,65535,0,0]},{"op":78,"name":"unit_op_4e","args":[0,285,0,0,0,0,65535,1,65535,0,0]},{"op":78,"name":"unit_op_4e","args":[0,286,0,0,0,0,65535,1,65535,0,0]},{"op":78,"name":"unit_op_4e","args":[0,287,0,0,0,0,65535,1,65535,0,0]},{"op":78,"name":"unit_op_4e","args":[0,288,0,0,0,0,65535,1,65535,0,0]},{"op":78,"name":"unit_op_4e","args":[0,289,0,0,0,0,65535,1,65535,0,0]},{"op":11,"name":"set_flag","args":[30,1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":22659,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":65,"name":"test_units_in_area","args":[0,14,1,0,0,0,0,0]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&姜维\n糟了！这下违背大将军的交代了。"]},{"op":73,"name":"ui_49","args":[]},{"op":14,"name":"ui_0e","args":[]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":22763,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[2,203,1]},{"op":5,"name":"test_flags","args":[[],[40]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[2,203,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[203,2,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&杨兰\n你没事吧？\n&治无戴\n这点小伤还算不了什么，只是我的族人就\n没有这么好运了。\n&杨兰\n都是因为帮我才会让你变成这样。\n&治无戴\n不，我因为不听你的话，把起兵的事情\n告诉姚柯回那个奸贼才会变成这样的。\n&治无戴\n话说回来，彻里吉帐下的女先锋居然和\n汉人一起战斗，真是意想不到。\n&杨兰\n我找到我的目标，或许你来我们这边也\n可以的。\n&治无戴\n嗯…我对蜀国到底是什么样子还真有点\n好奇。"]},{"op":11,"name":"set_flag","args":[40,1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":23244,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[0,6,1]},{"op":5,"name":"test_flags","args":[[],[41]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[0,6,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[6,0,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&姜维\n好英勇的小将，敢问姓名？\n&傅佥\n在下傅佥，是傅肜之子。\n&姜维\n原来是傅将军的儿子，姜维虽然未曾目睹\n，但也耳闻过将军的英勇事迹。\n&姜维\n等这次作战结束后，想请你来我们常败军\n营帐一叙可以吗？\n&傅佥\n在下倍感荣幸。"]},{"op":11,"name":"set_flag","args":[41,1]},{"op":0,"name":"end","args":[]}]},{"index":7,"offset":23572,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[0,32,1]},{"op":5,"name":"test_flags","args":[[],[42]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[0,32,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[32,0,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&蒋舒\n在下蒋舒，这次擅自闯入战地，给将军带\n来麻烦，实在感到非常抱歉。\n&姜维\n麻烦？不，一点也不。\n&姜维\n你和傅佥那冒险犯难的精神让我回想起\n自己的过去。\n&姜维\n等这次作战结束后，想请你来我们常败军\n营帐一叙可以吗？\n&蒋舒\n在下非常乐意。\n&蒋舒\n（太好了，我的机会来了！）"]},{"op":11,"name":"set_flag","args":[42,1]},{"op":0,"name":"end","args":[]}]},{"index":8,"offset":23952,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[0,80,1]},{"op":5,"name":"test_flags","args":[[],[43]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[0,80,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[80,0,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&姜维\n伯济，这次你屠杀羌人，失去羌人的信赖\n，实在是得不偿失。\n&郭淮\n伯约，这次你就错了。\n&郭淮\n杀一儆百，为了要长久维持雍凉地区的治\n安，虽然很残忍也必须做。\n&姜维\n但是你这样制造仇恨，你是要让汉人和羌\n人世代互相憎恨？\n&郭淮\n所有的怨恨集中到我身上就好，我愿意日\n后以最痛苦的方式，血流不止长达七百天\n而死。\n&姜维\n伯济…你这是何苦。\n&郭淮\n众人不了解我，只有你能看透我的心，希\n望你能明白。"]},{"op":11,"name":"set_flag","args":[43,1]},{"op":0,"name":"end","args":[]}]},{"index":9,"offset":24452,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[17,80,1]},{"op":5,"name":"test_flags","args":[[],[44,1018]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[17,80,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[80,17,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&郭淮\n如何？我早就对伯约说过，要是再来一次\n，你绝对不是我的对手。\n&廖化\n………\n&廖化\n（事实摆在眼前，真是无言以对呀。）"]},{"op":11,"name":"set_flag","args":[44,1]},{"op":0,"name":"end","args":[]}]},{"index":10,"offset":24689,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[20,72,1]},{"op":5,"name":"test_flags","args":[[],[45]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[20,72,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[72,20,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&花鬘\n你不就是上次那个丢脸到极点的手下\n败将？\n&夏侯威\n闭嘴！上次是一时大意！\n&花鬘\n那我们再打一次？\n&夏侯威\n这次我还有另外的人要对付，恕不\n奉陪。"]},{"op":11,"name":"set_flag","args":[45,1]},{"op":0,"name":"end","args":[]}]},{"index":11,"offset":24950,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[0,7,1]},{"op":5,"name":"test_flags","args":[[],[46]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[0,7,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[7,0,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&夏侯霸\n可恨的蜀人，我要将你们杀尽！\n&姜维\n眼睛只有仇恨的人是成不了大事的。\n&夏侯霸\n我只要为父亲报仇就够了，其他事情并不\n重要。\n&姜维\n夏侯将军在战场上战死，大家各为其主，\n有什么好怨恨的？\n&姜维\n你只是为自己的无能为力找个发泄管道，\n对所有周围的人散发敌意，这样你才能继\n续维持你那软弱的心灵。\n&夏侯霸\n你……\n&姜维\n你仔细想想我的话吧，看见你现在这个样\n子，我不认为夏侯将军会开心得起来。"]},{"op":11,"name":"set_flag","args":[46,1]},{"op":0,"name":"end","args":[]}]},{"index":12,"offset":25449,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":54,"name":"test_attr","args":[203,7,0,2]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&治无戴\n没想到还是得死在这里…难道我们羌人\n永远没有脱离被汉人控制的一天？"]},{"op":83,"name":"unit_op_53","args":[0,203,0,0,0,0,65535,1]},{"op":20,"name":"dialog","args":["&姜维\n糟了！居然让治无戴战死在这里。"]},{"op":73,"name":"ui_49","args":[]},{"op":14,"name":"ui_0e","args":[]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":13,"offset":25657,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[17,7,0,2]},{"op":5,"name":"test_flags","args":[[],[74]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&廖化\n难道我廖化真的不能作先锋？"]},{"op":49,"name":"actor_select","args":[0,17,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[74,1]},{"op":0,"name":"end","args":[]}]},{"index":14,"offset":25789,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[2,7,0,2]},{"op":5,"name":"test_flags","args":[[],[224]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&杨兰\n真是不小心，我的爱情之路总是这么\n坎坷。"]},{"op":49,"name":"actor_select","args":[0,2,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[224,1]},{"op":0,"name":"end","args":[]}]},{"index":15,"offset":25934,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[8,7,0,2]},{"op":5,"name":"test_flags","args":[[],[75]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&来忠\n外面的战场固然可怕，但是内部的战场更\n是可怕…"]},{"op":49,"name":"actor_select","args":[0,8,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[75,1]},{"op":0,"name":"end","args":[]}]},{"index":16,"offset":26085,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[10,7,0,2]},{"op":5,"name":"test_flags","args":[[],[78]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&向充\n看来我努力得还不够，得向老师多学习。"]},{"op":49,"name":"actor_select","args":[0,10,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[78,1]},{"op":0,"name":"end","args":[]}]},{"index":17,"offset":26227,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[11,7,0,2]},{"op":5,"name":"test_flags","args":[[],[230]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&刘敏\n所谓的战果有分很多种，有谓先胜后败，\n也有先败后胜，也有胜败交错，也有不胜\n不败…（继续啰唆）"]},{"op":49,"name":"actor_select","args":[0,11,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[230,1]},{"op":0,"name":"end","args":[]}]},{"index":18,"offset":26425,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[5,7,0,2]},{"op":5,"name":"test_flags","args":[[],[139]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&宁随\n我越来越懂得生存的意义了。"]},{"op":49,"name":"actor_select","args":[0,5,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[139,1]},{"op":0,"name":"end","args":[]}]},{"index":19,"offset":26557,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[18,7,0,2]},{"op":5,"name":"test_flags","args":[[],[152]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&赵统\n我还是及不上父亲的一半。"]},{"op":49,"name":"actor_select","args":[0,18,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[152,1]},{"op":0,"name":"end","args":[]}]},{"index":20,"offset":26687,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[1,7,0,2]},{"op":5,"name":"test_flags","args":[[],[50]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&诸葛果\n主公，请处罚我的失职。"]},{"op":49,"name":"actor_select","args":[0,1,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[50,1]},{"op":0,"name":"end","args":[]}]},{"index":21,"offset":26817,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[19,7,0,2]},{"op":5,"name":"test_flags","args":[[],[153]]},{"op":0,"name":"end","args":[]}],"bo