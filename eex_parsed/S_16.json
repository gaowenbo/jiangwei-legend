gs":[2,2,"下流。"]},{"op":21,"name":"unit_say","args":[1,1,"兵不厌诈。"]},{"op":20,"name":"dialog","args":["\n&关索\n（怎么搞的，我斩杀敌将反而更被女性\n厌恶呢？）"]},{"op":61,"name":"get_item","args":[98,65535,1,16]},{"op":11,"name":"set_flag","args":[45,1]},{"op":0,"name":"end","args":[]}]},{"index":16,"offset":20373,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[17,7,0,2]},{"op":5,"name":"test_flags","args":[[],[74]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&廖化\n难道我廖化真的不能作先锋？"]},{"op":49,"name":"actor_select","args":[0,17,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[74,1]},{"op":0,"name":"end","args":[]}]},{"index":17,"offset":20505,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":63,"name":"test_turn","args":[3,0]},{"op":54,"name":"test_attr","args":[2,7,1,0]},{"op":5,"name":"test_flags","args":[[],[225]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&杨兰\n马家部队的废物们，老娘知道你们还是\n对我很不爽，但是现在可不是让你们使\n性子的时候。\n&杨兰\n如果不想马孟起建立的声威消失，如果\n还想要有一天再度踏上凉州的土地，\n你们这些废物就给老娘好好干！"]},{"op":21,"name":"unit_say","args":[823,823,"老子超不爽的，马将军谁不好托付，偏偏\n托付给这个杨阜的女儿。"]},{"op":21,"name":"unit_say","args":[824,824,"不过说真的，我们只剩下这么一点弟兄了\n，如果不能凝聚战力，难道真要马家军团\n就此退出历史舞台？"]},{"op":21,"name":"unit_say","args":[823,823,"那么，我们就把怒气发向眼前的敌人\n好了！"]},{"op":77,"name":"unit_op_4d","args":[0,2,0,0,0,0,0,6,0,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,2,0,0,0,0,0,6,1,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,2,0,0,0,0,0,6,2,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,2,0,0,0,0,0,6,3,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,2,0,0,0,0,0,6,4,2,65535,0,0]},{"op":77,"name":"unit_op_4d","args":[0,2,0,0,0,0,0,6,5,2,65535,0,0]},{"op":11,"name":"set_flag","args":[225,1]},{"op":0,"name":"end","args":[]}]},{"index":18,"offset":21407,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[2,7,0,2]},{"op":5,"name":"test_flags","args":[[],[224]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&杨兰\n真是不小心，我的爱情之路总是这么\n坎坷。"]},{"op":49,"name":"actor_select","args":[0,2,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[224,1]},{"op":0,"name":"end","args":[]}]},{"index":19,"offset":21552,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[4,7,0,2]},{"op":5,"name":"test_flags","args":[[],[137]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&句扶\n纵然战败，其心不败。"]},{"op":49,"name":"actor_select","args":[0,4,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[137,1]},{"op":0,"name":"end","args":[]}]},{"index":20,"offset":21678,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[5,7,0,2]},{"op":5,"name":"test_flags","args":[[],[139]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&宁随\n我越来越懂得生存的意义了。"]},{"op":49,"name":"actor_select","args":[0,5,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[139,1]},{"op":0,"name":"end","args":[]}]},{"index":21,"offset":21810,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[18,7,0,2]},{"op":5,"name":"test_flags","args":[[],[152]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&赵统\n我还是及不上父亲的一半。"]},{"op":49,"name":"actor_select","args":[0,18,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[152,1]},{"op":0,"name":"end","args":[]}]},{"index":22,"offset":21940,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[1,7,0,2]},{"op":5,"name":"test_flags","args":[[],[50]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&诸葛果\n主公，请处罚我的失职。"]},{"op":49,"name":"actor_select","args":[0,1,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[50,1]},{"op":0,"name":"end","args":[]}]},{"index":23,"offset":22070,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[19,7,0,2]},{"op":5,"name":"test_flags","args":[[],[153]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&赵广\n看来走自己的路也不太容易。"]},{"op":49,"name":"actor_select","args":[0,19,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[153,1]},{"op":0,"name":"end","args":[]}]},{"index":24,"offset":22202,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[22,7,0,2]},{"op":5,"name":"test_flags","args":[[],[70]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&张嶷\n一时的败退不要气馁，再战就好。"]},{"op":49,"name":"actor_select","args":[0,22,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[70,1]},{"op":0,"name":"end","args":[]}]},{"index":25,"offset":22338,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[16,7,0,2]},{"op":5,"name":"test_flags","args":[[],[71]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&关索\n比起战败，我更怕这些女人找我算帐。"]},{"op":49,"name":"actor_select","args":[0,16,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[71,1]},{"op":0,"name":"end","args":[]}]},{"index":26,"offset":22478,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[8,7,0,2]},{"op":5,"name":"test_flags","args":[[],[75]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&来忠\n外面的战场固然可怕，但是内部的战场更\n是可怕…"]},{"op":49,"name":"actor_select","args":[0,8,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[75,1]},{"op":0,"name":"end","args":[]}]},{"index":27,"offset":22629,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[36,7,0,2]},{"op":5,"name":"test_flags","args":[[],[72]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&马忠\n我可不能死在这里，我有我的南中大梦。"]},{"op":49,"name":"actor_select","args":[0,36,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[72,1]},{"op":0,"name":"end","args":[]}]},{"index":28,"offset":22771,"title"