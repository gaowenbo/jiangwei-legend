"]},{"op":54,"name":"test_attr","args":[16,7,0,2]},{"op":5,"name":"test_flags","args":[[],[200,1010]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&关索\n比起战败，我更怕这些女人找我算帐。"]},{"op":49,"name":"actor_select","args":[0,16,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[200,1]},{"op":0,"name":"end","args":[]}]},{"index":21,"offset":18088,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[16,7,0,2]},{"op":5,"name":"test_flags","args":[[1010],[211]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&关索\n难道是最近纵欲过度？总感觉力不从心。"]},{"op":49,"name":"actor_select","args":[0,16,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[211,1]},{"op":73,"name":"ui_49","args":[]},{"op":14,"name":"ui_0e","args":[]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":22,"offset":18238,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":66,"name":"test_event5","args":[]},{"op":5,"name":"test_flags","args":[[],[0]]},{"op":0,"name":"end","args":[]}],"body":[{"op":81,"name":"op_51","args":[]},{"op":20,"name":"dialog","args":["&马忠\n很好，终于平定刘胄的乱事。\n&孟获\n真是的，每次碰到这种事，都让老子里外\n不是人的啦。\n&张嶷\n我们这几年为了北伐，加紧对南中人的\n压榨，大家会不满是正常的。\n&张嶷\n这次虽然利用贬谪伯恭（张翼）来暂时\n压抑南中人的不满，但是如果不能改变\n政策的话，南中人还是会再度反抗的。\n&马忠\n这就是我的梦想所在，虽然有些遥远，\n但我会尽力去完成。\n&马忠\n希望南中以后可以变成一块没有歧视和\n纷争的乐土。\n&张嶷\n虽然有点理想化，但是如果是德信的话，\n或许可以做到吧。\n&张嶷\n（只是在这之前，我会帮德信你去挡住\n任何需要沾满鲜血的事情，镇压反抗的\n恶鬼就让我去当就好了。）\n&马忠\n对了，关将军以后有什么打算？\n&关索\n我想暂时留在这里吧。\n（二哥对不起，这个重担我扛不了。）\n&张嶷\n我想花鬘姑娘一定会很开心的。\n&花鬘\n哼，谁会为这点小事开心。（脸红）\n&孟获\n（女儿的心事真是一目了然的啦。）"]},{"op":1,"name":"if","args":[],"cond":{"op":65,"name":"test_units_in_area","args":[4,4,0,0,0,0,0,0]},"end":6},{"op":20,"name":"dialog","args":["达成印绶条件\n我军和友军全员生存。"]},{"op":61,"name":"get_item","args":[97,0,1,36]},{"op":0,"name":"end","args":[]},{"op":119,"name":"int_var_op","args":[2,4080,2,0,1]},{"op":89,"name":"op_59","args":[300,48,65535,65535,65535,65535,65535,65535]},{"op":119,"name":"int_var_op","