2]},{"op":99,"name":"duel_say2","args":[0,"和我好像是不同世界的人一样…\n你究竟是什么人？",1]},{"op":100,"name":"duel_action","args":[0,3]},{"op":9,"name":"delay","args":[3]},{"op":99,"name":"duel_say2","args":[1,"大汉征西将军袁綝！",1]},{"op":9,"name":"delay","args":[3]},{"op":100,"name":"duel_action","args":[1,3]},{"op":101,"name":"duel_action2","args":[1,0,1]},{"op":100,"name":"duel_action","args":[0,12]},{"op":99,"name":"duel_say2","args":[0,"我“刘三刀”命丧于此，\n绝对不是技不如人…",1]},{"op":9,"name":"delay","args":[5]},{"op":35,"name":"play_music","args":[38,1]},{"op":98,"name":"duel_62","args":[1]},{"op":99,"name":"duel_say2","args":[1,"算算我杀他还没用到三刀呢。\n",1]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&刘达\n哇！"]},{"op":83,"name":"unit_op_53","args":[0,236,0,0,0,0,6,1]},{"op":20,"name":"dialog","args":["&袁綝\n刘三刀？真是笑死人了！"]},{"op":61,"name":"get_item","args":[98,0,1,9]},{"op":11,"name":"set_flag","args":[40,1]},{"op":0,"name":"end","args":[]}]},{"index":11,"offset":20682,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[7,237,1]},{"op":5,"name":"test_flags","args":[[],[41]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[7,237,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[237,7,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&夏侯霸\n朱头皮，纳命来！\n&朱芳\n我叫朱芳！"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["虫珼矪竚"]},"end":31},{"op":104,"name":"duel_setup","args":[7,237,34]},{"op":96,"name":"duel_say","args":[0,"臭老头，为了报王大人的恩情，\n我不得不杀你！",9]},{"op":96,"name":"duel_say","args":[1,"现在的年轻人都已经忘记\n夏侯家称霸的年代了？",6]},{"op":97,"name":"duel_end","args":[]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":99,"name":"duel_say2","args":[1,"真没用，可悲现在大魏只剩你这种人。",1]},{"op":99,"name":"duel_say2","args":[0,"唔唔、不妙。",1]},{"op":100,"name":"duel_action","args":[0,1]},{"op":100,"name":"duel_action","args":[1,8]},{"op":99,"name":"duel_say2","args":[1,"想跑！？不是说要报恩？",1]},{"op":100,"name":"duel_action","args":[1,2]},{"op":102,"name":"duel_action3","args":[1,1,0]},{"op":100,"name":"duel_action","args":[1,1]},{"op":102,"name":"duel_action3","args":[1,1,0]},{"op":99,"name":"duel_say2","args":[0,"哇啊啊～！",1]},{"op":100,"name":"duel_action","args":[0,11]},{"op":35,"name":"play_music","args":[38,1]},{"op":98,"name":"duel_62","args":[1]},{"op":100,"name":"duel_action","args":[1,1]},{"op":100,"name":"duel_action","args":[1,9]},{"op":9,"name":"delay","args":[5]},{"op":100,"name":"duel_action","args":[1,8]},{"op":99,"name":"duel_say2","args":[1,"看见大魏的将领这么弱，\n这种感觉真是复杂。",1]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":83,"name":"unit_op_53","args":[0,237,0,0,0,0,65535,1]},{"op":61,"name":"get_item","args":[102,65535,1,7]},{"op":11,"name":"set_flag","args":[41,1]},{"op":0,"name":"end","args":[]}]},{"index":12,"offset":21408,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":46,"name":"test_adjacent","args":[4,121,1]},{"op":5,"name":"test_flags","args":[[],[42]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[4,121,0,0,1,0]},{"op":79,"name":"unit_op_4f","args":[121,4,0,0,0,1]},{"op":20,"name":"dialog","args":["&郑伦\n你是谁？在我“无双上将”郑伦面前也敢\n用斧？\n&句扶\n我才觉得奇怪，之前才刚死一个徐质，现\n在又冒出郑伦，你们曹贼怎么那么多爱用\n斧的。\n&郑伦\n用斧的只要一个人就够了。\n&句扶\n我同意。"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["虫珼矪竚"]},"end":38},{"op":104,"name":"duel_setup","args":[4,121,34]},{"op":96,"name":"duel_say","args":[0,"小心了，我的大斧早就\n饥渴难耐了。",10]},{"op":96,"name":"duel_say","args":[1,"说什么鬼话？",0]},{"op":9,"name":"delay","args":[5]},{"op":97,"name":"duel_end","args":[]},{"op":99,"name":"duel_say2","args":[0,"杀呀！",1]},{"op":100,"name":"duel_action","args":[0,2]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":99,"name":"duel_say2","args":[1,"哼！",1]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":9,"name":"delay","args":[3]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":9,"name":"delay","args":[3]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":9,"name":"delay","args":[3]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":9,"name":"delay","args":[3]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[0,2,0]},{"op":99,"name":"duel_say2","args":[0,"哈哈！知道我郑伦的厉害的吧！",1]},{"op":9,"name":"delay","args":[3]},{"op":99,"name":"duel_say2","args":[1,"看来我是该认真一点了。",1]},{"op":99,"name":"duel_say2","args":[1,"牙旋豪斧！",1]},{"op":100,"name":"duel_action","args":[1,2]},{"op":102,"name":"duel_action3","args":[1,1,0]},{"op":99,"name":"duel_say2","args":[0,"哇！",1]},{"op":100,"name":"duel_action","args":[0,12]},{"op":9,"name":"delay","args":[3]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&句扶\n你这算是哪门子的无双上将，不是说你的\n大斧很饥渴？\n&郑伦\n哼，我的大斧在节食不行吗？"]},{"op":49,"name":"actor_select","args":[0,121,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[42,1]},{"op":0,"name":"end","args":[]}]},{"index":13,"offset":22343,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[0,115,1]},{"op":5,"name":"test_flags","args":[[1024],[43]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[0,115,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[115,0,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&王经\n我今天误中你的计谋，遭此大败实在是无\n话可说。\n&姜维\n你的用兵不算差劲，也能掌握将士的心，\n不然在这种混乱的情况下早就全军崩溃。\n&王经\n就是因为这样，我的部队现在被你们蜀人\n残杀不少，要是他们机伶点，也就不会死\n伤这么惨重了。\n&姜维\n若是你能多累积经验，说不定成就不在\n伯济或是玄伯之下。\n&王经\n你认为我还会有机会？本来我怀抱着升官\n让母亲荣耀的梦想，现在全都没了。\n&姜维\n让母亲荣耀？原来…你也和我抱持着同样\n的想法…\n&姜维\n如果不是处于两边阵营的话，我应该会和\n你成为好朋友。\n&王经\n或许吧，只能感叹命运的作弄。"]},{"op":11,"name":"set_flag","args":[43,1]},{"op":0,"name":"end","args":[]}]},{"index":14,"offset":22968,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[11,115,1]},{"op":5,"name":"test_flags","args":[[307],[46]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[11,115,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[115,11,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&刘敏\n你就是王经？\n&王经\n大魏雍州刺史王经正是在下。\n&刘敏\n我曾经听闻阁下出身农家，却能靠着自己\n的努力，一口气成为和许允并称的名士。\n堪称是河北名士的代表。\n&王经\n不敢当，想不到蜀国也有人知道在下的\n微薄名声。\n&刘敏\n正所谓名门不一定会出名士，而名士也不\n一定出自名门，名声和门第没有一定的关\n联…\n&王经\n（妈呀，真的好啰嗦。）\n&刘敏\n总而言之，我的新武器用你来测试应该是\n再适合不过的。\n&王经\n喔…那还真是荣幸…等一下…你说什么？"]},{"op":80,"name":"unit_status","args":[11,6,1,0]},{"op":80,"name":"unit_status","args":[115,3,0,0]},{"op":35,"name":"play_music","args":[35,1]},{"op":9,"name":"delay","args":[5]},{"op":80,"name":"unit_status","args":[115,9,0,1]},{"op":77,"name":"unit_op_4d","args":[0,115,0,0,0,0,0,6,65535,65535,16,100,0]},{"op":20,"name":"dialog","args":["&王经\n好卑鄙呀！怎么全身无力，你到底用了\n什么？\n&刘敏\n哦…这效果还真好，丞相夫人果然是奇\n才呀！刘敏真是佩服得五体投地。"]},{"op":61,"name":"get_item","args":[41,0,1,11]},{"op":11,"name":"set_flag","args":[46,1]},{"op":0,"name":"end","args":[]}]},{"index":15,"offset":23791,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[0,7,1]},{"op":5,"name":"test_flags","args":[[],[44]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[0,7,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[7,0,65535,65535,1,0]},{"op":20,"name":"dialog","args":["&姜维\n仲权，这样和魏国战斗没问题吗？\n&夏侯霸\n你当时和我交战的时候不也经过那样的阵\n痛期，现在我也一样。\n&夏侯霸\n虽然说我不能抛弃自己夏侯家的身分，但\n至少让我为这个国家尽点力也好。"]},{"op":11,"name":"set_flag","args":[44,1]},{"op":0,"name":"end","args":[]}]},{"index":16,"offset":24085,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":63,"name":"test_turn","args":[4,0]},{"op":46,"name":"test_adjacent","args":[0,9,1]},{"op":5,"name":"test_flags","args":[[],[45]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[0,9,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[9,0,65535,65535,1,0]},{"op":20,"name":"dialog","args":["&姜维\n显通，这次作战如果没有你，恐怕也没有\n现在的胜利。\n&袁綝\n没必要谢我，这比起义父当年做的，根本\n就微不足道。\n&姜维\n显通有如此杰出的义父作为目标，在下\n其实真的很羡慕。\n&袁綝\n是吗？我觉得你也是幸福之人，不过你\n好像没什么自觉。\n&姜维\n为什么呢？\n&袁綝\n当我没说过吧。"]},{"op":11,"name":"set_flag","args":[45,1]},{"op":0,"name":"end","args":[]}]},{"index":17,"offset":24478,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[9,7,0,2]},{"op":5,"name":"test_flags","args":[[],[68]]},{"op":0,"name":"end","args":[]}],"body":[{"op":83,"name":"unit_op_53","args":[0,9,0,0,0,0,6,1]},{"op":73,"name":"ui_49","args":[]},{"op":14,"name":"ui_0e","args":[]},{"op":11,"name":"set_flag","args":[68,1]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":18,"offset":24583,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[115,7,0,2]},{"op":5,"name":"test_flags","args":[[],[226]]},{"op":0,"name":"end","args":[]}],"body":[{"op":80,"name":"unit_status","args":[115,9,0,1]},{"op":20,"name":"dialog","args":["&王经\n一口气损失了好几万人，现在只能收拾\n残兵回去狄道固守了。\n&王经\n（万一关中部队没有来支援，我绝对是\n死定了，只能祈祷征西将军不要决定把\n我舍弃。）"]},{"op":49,"name":"actor_select","args":[0,115,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[226,1]},{"op":0,"name":"end","args":[]}]},{"index":19,"offset":24849,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[121,7,0,2]},{"op":5,"name":"test_flags","args":[[],[250]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&郑伦\n我的大斧要饿肚子了。"]},{"op":49,"name":"actor_select","args":[0,121,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[250,1]},{"op":0,"name":"end","args":[]}]},{"index":20,"offset":24975,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[237,7,0,2]},{"op":5,"name":"test_flags","args":[[],[249]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&朱芳\n我不叫朱茵，也不叫朱头皮，我叫朱芳！"]},{"op":83,"name":"unit_op_53","args":[0,237,0,0,0,0,6,1]},{"op":11,"name":"set_flag","args":[249,1]},{"op":0,"name":"end","args":[]}]},{"index":21,"offset":25121,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[236,7,0,2]},{"op":5,"name":"test_flags","args":[[],[248]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&刘达\n我刘三刀居然会死在这里？！"]},{"op":83,"name":"unit_op_53","args":[0,236,0,0,0,0,6,1]},{"op":11,"name":"set_flag","args":[248,1]},{"op":0,"name":"end","args":[]}]},{"index":22,"offset":25257,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[7,7,0,2]},{"op":5,"name":"test_flags","args":[[],[238]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&夏侯霸\n司马贼人！总有一天要你们付出代价！"]},{"op":49,"name":"actor_select","args":[0,7,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[238,1]},{"op":0,"name":"end","args":[]}]},{"index":23,"offset":25399,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[4,7,0,2]},{"op":5,"name":"test_flags","args":[[],[137]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&句扶\n纵然战败，其心不败。"]},{"op":49,"name":"actor_select","args":[0,4,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[137,1]},{"op":0,"name":"end","args":[]}]},{"index":24,"offset":25525,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[5,7,0,2]},{"op":5,"name":"test_flags","args":[[],[139]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&宁随\n我越来越懂得生存的意义了。"]},{"op":49,"name":"actor_select","args":[0,5,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[139,1]},{"op":0,"name":"end","args":[]}]},{"index":25,"offset":25657,"title":"","c