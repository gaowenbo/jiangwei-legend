:99,"name":"duel_say2","args":[1,"哼！",0]},{"op":102,"name":"duel_action3","args":[1,1,0]},{"op":9,"name":"delay","args":[5]},{"op":99,"name":"duel_say2","args":[0,"哇啊啊啊～……！",1]},{"op":100,"name":"duel_action","args":[0,12]},{"op":35,"name":"play_music","args":[38,1]},{"op":98,"name":"duel_62","args":[1]},{"op":100,"name":"duel_action","args":[1,1]},{"op":9,"name":"delay","args":[5]},{"op":100,"name":"duel_action","args":[1,2]},{"op":99,"name":"duel_say2","args":[1,"究竟是黄方造成这次的暴乱，还是这次\n暴乱造就了黄方，我都快搞不清楚了。",1]},{"op":99,"name":"duel_say2","args":[1,"过去我眼睛看到魏国对我们的暴行，莫非\n在这里也是持续著？",1]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&黄方\n南中尊严万岁！别以为我死了，南中人和\n汉人的战争就会结束。"]},{"op":83,"name":"unit_op_53","args":[0,244,0,0,0,0,65535,1]},{"op":61,"name":"get_item","args":[102,0,1,2]},{"op":20,"name":"dialog","args":["&马忠\n黄方已死，这下敌兵可是群龙无首。"]},{"op":77,"name":"unit_op_4d","args":[2,65535,0,0,0,19,19,2,1,0,10,0,0]},{"op":11,"name":"set_flag","args":[46,1]},{"op":0,"name":"end","args":[]}]},{"index":10,"offset":23125,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[2,20,1]},{"op":5,"name":"test_flags","args":[[],[45]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[2,20,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[20,2,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&花鬘\n你到底是什么人？为什么要在关索身边？\n你不知道他是个没救的花花公子的啦？\n&杨兰\n看来你真的很在乎他的样子。\n&花鬘\n我…我…才没有，只是单纯怕你被他骗了\n而已的啦。\n&杨兰\n放心吧，我心早有所属，是个比关索\n好几百倍的男人。\n&花鬘\n等一下…你凭什么说那个人比关索\n好几百倍？关索也没有这么烂的啦！\n&杨兰\n呼…原来除了汉人以外，还有这么不坦率\n的民族啊…"]},{"op":11,"name":"set_flag","args":[45,1]},{"op":0,"name":"end","args":[]}]},{"index":11,"offset":23585,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[16,20,1]},{"op":5,"name":"test_flags","args":[[],[48]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[16,20,65535,65535,1,0]},{"op":79,"name":"unit_op_4f","args":[20,16,65535,65535,0,1]},{"op":20,"name":"dialog","args":["&关索\n拜托，就算要揍我，也不要打我的脸。\n&花鬘\n关索，你以为我真的是来找你算帐的？\n&关索\n不是吗？\n&花鬘\n老爸他快不行了，他嘴上不说，还是希望\n你能见他最后一面的啦。\n&关索\n怎么可能？那个强壮得跟大象一样的孟获\n会…\n&花鬘\n总之，你一定要去见他的啦。"]},{"op":11,"name":"set_flag","args":[48,1]},{"op":0,"name":"end","args":[]}]},{"index":12,"offset":23944,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[20,7,0,2]},{"op":5,"name":"test_flags","args":[[],[202]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&花鬘\n我可不是因为帮你才弄到撤退的啦。"]},{"op":49,"name":"actor_select","args":[0,20,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[202,1]},{"op":0,"name":"end","args":[]}]},{"index":13,"offset":24082,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[847,7,0,2]},{"op":5,"name":"test_flags","args":[[],[203]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&李歆\n怎么可能？！放…放开我！"]},{"op":83,"name":"unit_op_53","args":[0,847,0,0,0,0,6,0]},{"op":11,"name":"set_flag","args":[203,1]},{"op":0,"name":"end","args":[]}]},{"index":14,"offset":24216,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[16,7,0,2]},{"op":5,"name":"test_flags","args":[[],[200]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&关索\n比起战败，我更怕这些女人找我算帐。"]},{"op":49,"name":"actor_select","args":[0,16,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[200,1]},{"op":0,"name":"end","args":[]}]},{"index":15,"offset":24356,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[2,7,0,2]},{"op":5,"name":"test_flags","args":[[],[224]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&杨兰\n真是不小心，我的爱情之路总是这么\n坎坷。"]},{"op":49,"name":"actor_select","args":[0,2,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[224,1]},{"op":0,"name":"end","args":[]}]},{"index":16,"offset":24501,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[22,7,0,2]},{"op":5,"name":"test_flags","args":[[],[199]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&张嶷\n一时的败退不要气馁，再战就好。"]},{"op":49,"name":"actor_select","args":[0,22,0,0,0,0,6]},{"op":11,"name":"set_flag","args":[199,1]},{"op":0,"name":"end","args":[]}]},{"index":17,"offset":24637,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[242,7,0,2]},{"op":5,"name":"test_flags","args":[[],[204,1015]]},{"op":0,"name":"end","args":[]}],"body":[{"op":80,"name":"unit_status","args":[242,9,0,1]},{"op":20,"name":"dialog","args":["&向宠\n叔父…我恐怕没办法回去见您了。\n&马忠\n向将军？！\n&向宠\n丞相曾经夸我性行淑均，晓畅军事，现在\n看来…丞相似乎看走眼了。"]},{"op":83,"name":"unit_op_53","args":[0,242,0,0,0,0,65535,1]},{"op":20,"name":"dialog","args":["&马忠\n唉…我大汉损失了这样的栋梁之才。"]},{"op":76,"name":"unit_op_4c","args":[0,244,0]},{"op":76,"name":"unit_op_4c","args":[0,524,0]},{"op":76,"name":"unit_op_4c","args":[0,525,0]},{"op":76,"name":"unit_op_4c","args":[0,526,0]},{"op":76,"name":"unit_op_4c","args":[0,527,0]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&黄方\n呵呵呵，打死名将向宠，我南中人抗暴的\n声威将达到顶峰的啦。\n&黄方\n现在的局面，纵然诸葛亮重生也无法挽回\n的啦。\n&黄方\n现在汉嘉起义，明天越隽起义，过不久整\n个蜀地将被我南中人的怒火所攻陷的啦。\n&黄方\n啊…我们南中人就是悲情，从秦以来就被\n这些无耻的汉人欺负压榨，侵夺本来属于\n我们的生存空间的啦。\n&黄方\n而更悲哀的是，甚至有像李恢那样的南奸\n，出卖我们南中，帮汉人欺负我们的啦。\n&黄方\n这么悲情的我们更要团结，大家携手一起\n打倒万恶的汉人的啦！\n&南蛮骑3\n打倒汉人的啦！\n&南蛮骑4\n黄方大元帅万岁的啦！\n&黄方\n（科科科，学你们南中人的语调就可以轻\n松骗到你们南中人，难怪老爹过去说过，\n语言是最好的工具。）"]},{"op":9,"name":"delay","args":[5]},{"op":20,"name":"dialog","args":["&杨兰\n油嘴滑舌真令人讨厌，我要亲自扯掉他的\n臭嘴。\n&花鬘\n这个人说的也不是没有道理，南中人平常\n被汉人压迫的仇恨可是很深的啦。\n&花鬘\n万一爆发起来，汉人必定为了平乱而疲于\n奔命。\n&马忠\n南中人和汉人之间的仇恨，到什么时候才\n能化解？\n&张嶷\n（要是能够让南中人的恨意集中到我身上\n，德信统治南中应该也会顺利一点吧。）\n&关索\n难怪我最近很难泡到南中出身的妹妹，原\n来是因为他…\n&花鬘\n关索！\n&杨兰\n低级！"]},{"op":11,"name":"set_flag","args":[204,1]},{"op":0,"name":"end","args":[]}]},{"index":18,"offset":26011,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[242,7,0,2]},{"op":5,"name":"test_flags","args":[[1015],[201]]},{"op":0,"name":"end","args":[]}],"body":[{"op":80,"name":"unit_status","args":[242,9,0,1]},{"op":20,"name":"dialog","args":["&向宠\n叔父…我恐怕没办法回去见您了。\n&马忠\n向将军？！\n&向宠\n丞相曾经夸我性行淑均，晓畅军事，现在\n看来…丞相似乎看走眼了。"]},{"op":83,"name":"unit_op_53","args":[0,242,0,0,0,0,65535,1]},{"op":20,"name":"dialog","args":["&马忠\n唉…我大汉损失了这样的栋梁之才。"]},{"op":11,"name":"set_flag","args":[201,1]},{"op":73,"name":"ui_49","args":[]},{"op":14,"name":"ui_0e","args":[]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":19,"offset":26305,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[36,7,0,2]},{"op":5,"name":"test_flags","args":[[],[74]]},{"op":0,"name":"end","args":[]}],"body":[{"op":83,"name":"unit_op_53","args":[0,36,0,0,0,0,6,1]},{"op":73,"name":"ui_49","args":[]},{"op":14,"name":"ui_0e","args":[]},{"op":11,"name":"set_flag","args":[74,1]},{"op":0,"name":"end","args":[]}]},{"index":20,"offset":26408,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[244,7,0,2]},{"op":5,"name":"test_flags","args":[[],[198,1015]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&黄方\n南中尊严万岁！别以为我死了，南中人和\n汉人的战争就会结束。"]},{"op":83,"name":"unit_op_53","args":[0,244,0,0,0,0,65535,1]},{"op":20,"name":"dialog","args":["&马忠\n黄方已死，这下敌兵可是群龙无首。\n"]},{"op":77,"name":"unit_op_4d","args":[2,65535,0,0,0,19,19,2,1,0,10,0,0]},{"op":11,"name":"set_flag","args":[198,1]},{"op":0,"name":"end","args":[]}]},{"index":21,"offset":26689,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[244,7,0,2]},{"op":5,"name":"test_flags","args":[[1015],[]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&黄方\n只有还有人挺我，我就不会这么快\n倒下的啦。"]},{"op":49,"name":"actor_select","args":[0,244,0,0,0,0,6]},{"op":85,"name":"unit_move","args":[0,244,0,5,4,1]},{"op":20,"name":"dialog","args":["&杨兰\n这个欠揍的家伙就让我来解决吧。"]},{"op":0,"name":"end","args":[]}]},{"index":22,"offset":26897,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":65,"name":"test_units_in_area","args":[2,0,2,0,5,13,19,27]},{"op":5,"name":"test_flags","args":[[40],[14,1015]]},{"op":0,"name":"end","args":[]}],"body":[{"op":81,"name":"op_51","args":[]},{"op":20,"name":"dialog","args":["&马忠\n消灭了汉嘉叛乱军，平乱成功了"]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[40,41,42,43,45],[]]},"end":6},{"op":20,"name":"dialog","args":["达成印绶条件\n触发所有对话和单挑。"]},{"op":61,"name":"get_item","args":[97,0,1,36]},{"op":0,"name":"end","args":[]},{"op":89,"name":"op_59","args":[500,65535,65535,65535,65535,65535,65535,65535]},{"op":11,"name":"set_flag","args":[14,1]},{"op":73,"name":"ui_49","args":[]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":23,"offset":27153,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":65,"name":"test_units_in_area","args":[2,0,2,0,5,13,19,27]},{"op":5,"name":"test_flags","args":[[204],[16,1015]]},{"op":0,"name":"end","args":[]}],"body":[{"op":81,"name":"op_51","args":[]},{"op":20,"name":"dialog","args":["&马忠\n消灭了汉嘉叛乱军，平乱成功了。"]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[40,41,42,43,45,48,49],[]]},"end":6},{"op":20,"name":"dialog","args":["达成印绶条件\n触发所有对话和单挑。"]},{"op":61,"name":"get_item","args":[97,0,1,36]},{"op":0,"name":"end","args":[]},{"op":89,"name":"op_59","args":[500,65535,65535,65535,65535,65535,65535,65535]},{"op":11,"name":"set_flag","args":[16,1]},{"op":73,"name":"ui_49","args":[]},{"op":13,"name":"next_scene","args":[]},{"op":0,"name":"end","args":[]}]},{"index":24,"offset":27415,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":65,"name":"test_units_in_area","args":[2,0,2,0,5,13,19,27]},{"op":5,"name":"test_flags","args":[[1015,47],