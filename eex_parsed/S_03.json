"op":5,"name":"test_flags","args":[[],[36]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&张郃\n这个时候破坏我战争美可不能放过！\n全军出动！"]},{"op":78,"name":"unit_op_4e","args":[1,65535,0,0,19,19,2,1,65535,0,0]},{"op":11,"name":"set_flag","args":[36,1]},{"op":0,"name":"end","args":[]}]},{"index":3,"offset":17342,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":37,"name":"test_unit_at","args":[1025,13,17]},{"op":5,"name":"test_flags","args":[[],[37]]},{"op":0,"name":"end","args":[]}],"body":[{"op":61,"name":"get_item","args":[87,65535,1,1025]},{"op":11,"name":"set_flag","args":[37,1]},{"op":0,"name":"end","args":[]}]},{"index":4,"offset":17423,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":37,"name":"test_unit_at","args":[1025,4,4]},{"op":5,"name":"test_flags","args":[[],[38]]},{"op":0,"name":"end","args":[]}],"body":[{"op":61,"name":"get_item","args":[88,65535,1,1025]},{"op":11,"name":"set_flag","args":[38,1]},{"op":0,"name":"end","args":[]}]},{"index":5,"offset":17504,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[2,222,1]},{"op":5,"name":"test_flags","args":[[],[39]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[2,222,65535,65535,0,1]},{"op":79,"name":"unit_op_4f","args":[222,2,65535,65535,1,0]},{"op":20,"name":"dialog","args":["&杨兰\n前方武将，虽然和你无冤无仇，\n但还是请你纳命来吧。\n&申仪\n什么？！"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":["虫珼矪竚"]},"end":40},{"op":104,"name":"duel_setup","args":[2,222,20]},{"op":96,"name":"duel_say","args":[0,"居然有美女送上门，难道我申仪倒楣这么\n多年终于要转运了？",0]},{"op":96,"name":"duel_say","args":[1,"（这是送给姜维的见面礼。）",0]},{"op":97,"name":"duel_end","args":[]},{"op":100,"name":"duel_action","args":[1,8]},{"op":99,"name":"duel_say2","args":[1,"准备受死吧！",1]},{"op":100,"name":"duel_action","args":[1,2]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,2,1]},{"op":99,"name":"duel_say2","args":[0,"好，好强的臂力……\n这怎么可能？",1]},{"op":100,"name":"duel_action","args":[1,0]},{"op":99,"name":"duel_say2","args":[1,"能接下我一招，看来你还有两下子！",1]},{"op":100,"name":"duel_action","args":[0,10]},{"op":99,"name":"duel_say2","args":[0,"哼，别以为我只会靠叛变混饭吃！",1]},{"op":100,"name":"duel_action","args":[0,2]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":102,"name":"duel_action3","args":[0,0,1]},{"op":99,"name":"duel_say2","args":[0,"有破绽！",1]},{"op":101,"name":"duel_action2","args":[0,4,1]},{"op":99,"name":"duel_say2","args":[1,"中计了！",1]},{"op":102,"name":"duel_action3","args":[1,0,0]},{"op":102,"name":"duel_action3","args":[1,0,0]},{"op":102,"name":"duel_action3","args":[1,0,0]},{"op":102,"name":"duel_action3","args":[1,0,0]},{"op":102,"name":"duel_action3","args":[1,0,0]},{"op":101,"name":"duel_action2","args":[1,0,1]},{"op":99,"name":"duel_say2","args":[0,"哇啊！",1]},{"op":100,"name":"duel_action","args":[0,11]},{"op":35,"name":"play_music","args":[38,1]},{"op":98,"name":"duel_62","args":[1]},{"op":99,"name":"duel_say2","args":[1,"笨蛋，不知道什么叫“卖个破绽”吗？",1]},{"op":95,"name":"duel_start","args":[]},{"op":0,"name":"end","args":[]},{"op":20,"name":"dialog","args":["&申仪\n想不到我申仪，\n居然连个小姑娘都打不过……\n&申仪\n（算了，这样也好…总比活著被羞辱…）\n&申仪\n（东三郡申家势力就此瓦解，这个大魏\n统治者的脑袋绝不简单啊…）"]},{"op":83,"name":"unit_op_53","args":[0,222,0,0,0,0,6,1]},{"op":20,"name":"dialog","args":["&杨兰\n真好笑，这种武艺还敢自夸。"]},{"op":1,"name":"if","args":[],"cond":{"op":5,"name":"test_flags","args":[[],[1004]]},"end":49},{"op":20,"name":"dialog","args":["&杨兰\n好，这下敌兵混乱了。"]},{"op":77,"name":"unit_op_4d","args":[0,282,0,0,0,0,0,6,65535,65535,8,0,0]},{"op":77,"name":"unit_op_4d","args":[0,283,0,0,0,0,0,6,65535,65535,8,0,0]},{"op":77,"name":"unit_op_4d","args":[0,284,0,0,0,0,0,6,65535,65535,8,0,0]},{"op":0,"name":"end","args":[]},{"op":11,"name":"set_flag","args":[39,1]},{"op":0,"name":"end","args":[]}]},{"index":6,"offset":18868,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":46,"name":"test_adjacent","args":[4,221,1]},{"op":5,"name":"test_flags","args":[[],[40]]},{"op":0,"name":"end","args":[]}],"body":[{"op":79,"name":"unit_op_4f","args":[4,221,65535,0,1,0]},{"op":79,"name":"unit_op_4f","args":[221,4,65535,0,0,1]},{"op":20,"name":"dialog","args":["&邓贤\n来者何人？敢妨碍老子抢功？\n&句扶\n汉昌句扶！"]},{"op":1,"name":"if","args":[],"cond":{"op":2,"name":"comment","args":[""]},"end":45},{"op":104,"name":"duel_setup","args":[4,221,20]},{"op":96,"name":"duel_say","args":[0,"哼！孟达尚且败在我箭下，何况你！",10]},{"op":96,"name":"duel_say","args":[1,"笑话，孟达那个东州狗能有多厉害？",0]},{"op":97,"name":"duel_end","args":[]},{"op":99,"name":"duel_say2","args":[0,"（我打倒孟达其实是用这招。）",0]},{"op":100,"name":"duel_action","args":[1,8]},{"op":99,"name":"duel_say2","args":[1,"来吧！",1]},{"op":99,"name":"duel_say2","args":[0,"……",1]},{"op":100,"name":"duel_action","args":[0,9]},{"op":99,"name":"duel_say2","args":[0,"喝！\n",1]},{"op":100,"name":"duel_action","args":[1,6]},{"op":99,"name":"duel_say2","args":[1,"唔……\n不好，是沙子！",1]},{"op":100,"name":"duel_action","args":[0,2]},{"op":100,"name":"duel_action","args":[0,8]},{"op":99,"name":"duel_say2","args":[0,"看招！",1]},{"op":101,"name":"duel_action2","args":[0,1,1]},{"op":99,"name":"duel_say2","args":[0,"什么，防住了！？",1]},{"op":99,"name":"duel_say2","args":[1,"想拿沙子来蒙我的眼睛？可笑！",1]},{"op":99,"name":"duel_say2","args":[0,"可恶！",1]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":101,"name":"duel_action2","args":[0,1,0]},{"op":99,"name":"duel_say2","args":[1,"就这么两下子？",1]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","args":[1,1,0]},{"op":101,"name":"duel_action2","a