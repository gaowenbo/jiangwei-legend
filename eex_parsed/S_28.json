":20,"offset":23121,"title":"驹い矪竚","conditions":[{"op":2,"name":"comment","args":["驹い矪竚"]},{"op":54,"name":"test_attr","args":[150,7,0,2]},{"op":5,"name":"test_flags","args":[[],[54]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&牵弘\n扁我就是不给我爹面子！小心我崩溃喔！"]},{"op":49,"name":"actor_select","args":[0,150,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[54,1]},{"op":0,"name":"end","args":[]}]},{"index":21,"offset":23271,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[10,7,0,2]},{"op":5,"name":"test_flags","args":[[],[78]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&向充\n看来我努力得还不够，得向老师多学习。"]},{"op":49,"name":"actor_select","args":[0,10,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[78,1]},{"op":0,"name":"end","args":[]}]},{"index":22,"offset":23413,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[1,7,0,2]},{"op":5,"name":"test_flags","args":[[],[50]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&诸葛果\n主公，请处罚我的失职。"]},{"op":49,"name":"actor_select","args":[0,1,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[50,1]},{"op":0,"name":"end","args":[]}]},{"index":23,"offset":23543,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[18,7,0,2]},{"op":5,"name":"test_flags","args":[[],[152]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&赵统\n我还是及不上父亲的一半。"]},{"op":49,"name":"actor_select","args":[0,18,0,0,0,0,0]},{"op":11,"name":"set_flag","args":[152,1]},{"op":0,"name":"end","args":[]}]},{"index":24,"offset":23673,"title":"","conditions":[{"op":2,"name":"comment","args":[""]},{"op":54,"name":"test_attr","args":[8,7,0,2]},{"op":5,"name":"test_flags","args":[[],[75]]},{"op":0,"name":"end","args":[]}],"body":[{"op":20,"name":"dialog","args":["&来忠\n外面的战场固然可怕，但是内部的战场更\n是可怕…"]},{"op":49,"name":"actor_select","args":[0,8,0,0,0,0,